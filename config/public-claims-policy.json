        "delivered\\s+entirely\\s+by\\s+our\\s+own\\s+team",
        "every\\s+pillar\\s+is\\s+delivered\\s+by\\s+our\\s+in-house\\s+team",
        "livrat[ăe]?\\s+integral\\s+de\\s+echipa\\s+noastră",
        "zero[- ]downtime",
        "zero\\s+(?:hand-offs?|pasare)",
        "(?:sla\\s+24/7|24/7\\s+sla)",
        "cod\\s+sursă\\s+inclus\\s+pentru\\s+fiecare\\s+proiect",
        "source\\s+code\\s+included\\s+with\\s+every\\s+project"
      ]
    },
    {
      "id": "C-009",
      "status": "blocked",
