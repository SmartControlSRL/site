{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/servicii",
      "destination": "/#servicii",
      "permanent": true
    },
    {
      "source": "/servicii/",
      "destination": "/#servicii",
      "permanent": true
    },
    {
      "source": "/solutii",
      "destination": "/#produse",
      "permanent": true
    },
    {
      "source": "/solutii/",
      "destination": "/#produse",
      "permanent": true
    },
    {
      "source": "/en/servicii",
      "destination": "/en/#servicii",
      "permanent": true
    },
    {
      "source": "/en/servicii/",
      "destination": "/en/#servicii",
      "permanent": true
    },
    {
      "source": "/en/solutii",
      "destination": "/en/#produse",
      "permanent": true
    },
    {
      "source": "/en/solutii/",
      "destination": "/en/#produse",
      "permanent": true
    }
  ]
}
