---
// Self-hosted variable fonts (Vite bundles them; NO Google Fonts CDN —
// the CDN would leak visitor IPs outside the EU
// problem that got the Google Map dropped). See /CLAUDE.md.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, hreflangPair, useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Emit <meta name="robots" content="noindex"> (error pages only). */
  noindex?: boolean;
  /**
   * Error documents describe the unknown request, not their internal fallback
   * file. Do not publish canonical/alternate/og:url metadata for them.
   */
  errorDocument?: boolean;
}

const { title, description, noindex = false, errorDocument = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// hreflang alternates: per-locale slugs via hreflangPair (handles
// /confidentialitate ↔ /en/privacy, not just the /en prefix). The static
// build emits directory-format URLs (…/cloud/index.html), so canonical,
// sitemap and alternates must all carry a trailing slash — normalize the
// hreflangPair output (which strips it) to match the canonical convention.
const withSlash = (p: string) => (p === '/' || p.endsWith('/') ? p : `${p}/`);
const path = withSlash(Astro.url.pathname);
const { ro: roPath, en: enPath } = hreflangPair(path);
const canonical = new URL(path, Astro.site).href;
const roHref = new URL(withSlash(roPath), Astro.site).href;
const enHref = new URL(withSlash(enPath), Astro.site).href;
const ogImage = new URL('og-claims-safe.png', Astro.site).href;

// Browser-chrome tint: --sc-deep-navy (theme tokens can't be var()'d in meta).
const themeColor = '#0e1f5b';
// The claims-safe image in /public is 1200×630 — the standard OG card size.
const ogLocale = lang === 'en' ? 'en_US' : 'ro_RO';
const ogLocaleAlt = lang === 'en' ? 'ro_RO' : 'en_US';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    {!errorDocument && <link rel="canonical" href={canonical} />}
    {!errorDocument && <link rel="alternate" hreflang="ro" href={roHref} />}
    {!errorDocument && <link rel="alternate" hreflang="en" href={enHref} />}
    {!errorDocument && <link rel="alternate" hreflang="x-default" href={roHref} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Smart Control" />
    <meta property="og:locale" content={ogLocale} />
    {!errorDocument && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!errorDocument && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Smart Control — Trusted Service Delivery Partner" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only">{t('a11y.skip')}</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Single bundled motion wiring. Imports the vanilla motion.js utilities
      // and runs them on every View-Transitions page load, collecting cleanups
      // and tearing them down on the next swap. Everything honors
      // prefers-reduced-motion inside motion.js (static fallbacks).
      import {
        initEmails,
        initNavShrink,
        initReveals,
        initCounters,
        initStepper,
        initStackTeardown,
        initConsole,
      } from '../scripts/motion.js';

      type Cleanup = () => void;
      let cleanups: Cleanup[] = [];

      function wire() {
        const doc = document;

        // Emails first (also fills the obfuscated text), then chrome + scene.
        initEmails(doc);

        const nav = doc.querySelector<HTMLElement>('[data-nav-shrink]');
        if (nav) cleanups.push(initNavShrink(nav));

        cleanups.push(initReveals(doc));
        cleanups.push(initCounters(doc));

        // Steppers: one per [data-stepper] container, with its own fill element.
        doc.querySelectorAll<HTMLElement>('[data-stepper]').forEach((container) => {
          const fill = container.querySelector<HTMLElement>('[data-stepper-fill]');
          if (fill) cleanups.push(initStepper(container, fill, { dark: container.hasAttribute('data-stepper-dark') }));
        });

        doc.querySelectorAll<HTMLElement>('[data-sctd]').forEach((container) => {
          cleanups.push(initStackTeardown(container));
        });

        doc.querySelectorAll<HTMLElement>('[data-console]').forEach((container) => {
          cleanups.push(initConsole(container));
        });

      }

      function teardown() {
        cleanups.forEach((fn) => {
          try { fn(); } catch { /* noop */ }
        });
        cleanups = [];
      }

      document.addEventListener('astro:page-load', wire);
      document.addEventListener('astro:before-swap', teardown);
    </script>
  </body>
</html>
