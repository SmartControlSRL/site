---
import type { ServiceArtwork } from "../content/service-pages";
import type { ProductArtwork } from "../content/product-pages";
import { Pause, Play } from "@lucide/astro";
import ServiceArtworkEffects from "./artwork/ServiceArtworkEffects.astro";
import ProductArtworkEffects from "./artwork/ProductArtworkEffects.astro";
import { getLangFromUrl } from "../i18n/ui";

interface Props {
  artwork: ServiceArtwork | ProductArtwork | "optical-dark";
  lazy?: boolean;
}
const { artwork: name, lazy = false } = Astro.props;
const productArtwork =
  name === "seknet-observability" || name === "svpn-connection";
const variant = name === "optical-dark" || productArtwork ? "dark" : "light";
const animated = name !== "optical-dark";
const en = getLangFromUrl(Astro.url) === "en";
const pauseLabel = en ? "Pause animation" : "Oprește animația";
const resumeLabel = en ? "Resume animation" : "Reia animația";
const artworkId = `artwork-${name}`;
---

<div
  id={artworkId}
  class:list={[
    "ambient-artwork",
    `ambient-artwork--${variant}`,
    {
      "ambient-artwork--product": productArtwork,
      "ambient-artwork--contained":
        name === "software-automation" ||
        name === "managed-services" ||
        productArtwork,
    },
  ]}
  data-artwork-name={name}
  data-artwork-animated={animated ? "" : undefined}
  data-artwork-state="static"
  aria-hidden="true"
>
  <div class="artwork-layer" data-artwork-layer>
    <picture>
      <source media="(max-width: 600px)" srcset={`/images/${name}-800.webp`} />
      <img
        src={`/images/${name}-1600.webp`}
        width="1600"
        height="900"
        alt=""
        loading={lazy ? "lazy" : "eager"}
        decoding="async"
        fetchpriority="low"
      />
    </picture>
    {
      animated &&
        (productArtwork ? (
          <ProductArtworkEffects artwork={name as ProductArtwork} />
        ) : (
          <ServiceArtworkEffects artwork={name as ServiceArtwork} />
        ))
    }
  </div>
</div>
{
  animated && (
    <button
      type="button"
      class="artwork-toggle"
      data-artwork-toggle={name}
      data-label-pause={pauseLabel}
      data-label-resume={resumeLabel}
      aria-controls={artworkId}
      aria-label={pauseLabel}
      aria-pressed="false"
      title={pauseLabel}
      hidden
    >
      <Pause
        size={17}
        stroke-width={1.8}
        aria-hidden="true"
        data-artwork-pause-icon
      />
      <Play
        size={17}
        stroke-width={1.8}
        aria-hidden="true"
        data-artwork-play-icon
      />
    </button>
  )
}
<style>
  .ambient-artwork {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    --artwork-play-state: paused;
  }
  .ambient-artwork[data-artwork-state="running"] {
    --artwork-play-state: running;
  }
  .artwork-layer {
    position: absolute;
    inset: 0;
    transform-origin: 80% 50%;
  }
  .artwork-layer picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ambient-artwork :global(.artwork-effects) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .ambient-artwork img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
  }
  .ambient-artwork--contained img {
    object-fit: contain;
  }
  .ambient-artwork::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .ambient-artwork--light::after {
    background: linear-gradient(
      90deg,
      var(--color-page) 0%,
      var(--color-page) 35%,
      color-mix(in srgb, var(--color-page) 90%, transparent) 48%,
      transparent 76%
    );
  }
  .ambient-artwork--dark::after {
    background: linear-gradient(
      90deg,
      var(--color-midnight) 0%,
      color-mix(in srgb, var(--color-midnight) 96%, transparent) 35%,
      color-mix(in srgb, var(--color-midnight) 35%, transparent) 100%
    );
  }
  @media (min-width: 901px) {
    .ambient-artwork--product img,
    .ambient-artwork--product :global(.artwork-effects) {
      position: absolute;
      top: 50%;
      right: 0;
      bottom: auto;
      left: auto;
      width: 85%;
      height: auto;
      max-height: 100%;
      transform: translateY(-50%);
      mask-image: linear-gradient(
        transparent,
        black 8%,
        black 92%,
        transparent
      );
    }
    .ambient-artwork--product::after {
      background: linear-gradient(
        90deg,
        var(--color-midnight) 0%,
        var(--color-midnight) 35%,
        color-mix(in srgb, var(--color-midnight) 96%, transparent) 52%,
        transparent 76%
      );
    }
  }
  @media (max-width: 900px) {
    .ambient-artwork--light {
      opacity: 0.2;
    }
    .ambient-artwork--dark::after {
      background: color-mix(in srgb, var(--color-midnight) 78%, transparent);
    }
  }
  .artwork-toggle {
    position: absolute;
    top: 16px;
    right: clamp(20px, 2vw, 32px);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border-blue);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-navy);
    cursor: pointer;
  }
  .artwork-toggle:hover {
    background: var(--color-page);
  }
  .artwork-toggle:focus-visible {
    outline: 3px solid var(--color-bright);
    outline-offset: 4px;
  }
  .artwork-toggle[hidden],
  .artwork-toggle :global([data-artwork-play-icon]),
  .artwork-toggle[aria-pressed="true"] :global([data-artwork-pause-icon]) {
    display: none;
  }
  .artwork-toggle[aria-pressed="true"] :global([data-artwork-play-icon]) {
    display: block;
  }
  .ambient-artwork[data-artwork-state="static"]
    :global([data-artwork-effects] *) {
    animation: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .artwork-toggle,
    .ambient-artwork :global([data-artwork-effects]) {
      display: none !important;
    }
    .artwork-layer {
      transform: none !important;
    }
    .ambient-artwork :global([data-artwork-effects] *) {
      animation: none !important;
    }
  }
</style>
<script>
  import "../scripts/artwork-motion";
</script>
