---
import { ChevronDown, Menu, X } from '@lucide/astro';
import { getLangFromUrl, useTranslations, localizedPath, altLocalePath } from '../i18n/ui';
import MailtoLink from './MailtoLink.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);

const navItems = [
  {
    code: '01',
    href: p('/servicii'),
    label: t('nav.services'),
    children: [
      { href: p('/servicii/cloud'), label: t('nav.cloud') },
      { href: p('/servicii/securitate'), label: t('footer.service.security') },
      { href: p('/servicii/software'), label: t('footer.service.software') },
      { href: p('/servicii/managed'), label: t('footer.service.managed') },
    ],
  },
  {
    code: '02',
    href: p('/solutii'),
    label: t('nav.products'),
    children: [
      { href: p('/solutii/seknet'), label: t('nav.seknet') },
      { href: p('/solutii/s-vpn'), label: t('nav.svpn') },
    ],
  },
  { code: '03', href: p('/#contact'), label: t('nav.contact') },
];

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const cleanPath = (href: string) => href.split('#')[0].replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const clean = cleanPath(href);
  return clean !== '/' && clean !== cleanPath(p('/')) && here === clean;
};
const inTree = (href: string) => {
  const clean = cleanPath(href);
  if (clean === '/' || clean === cleanPath(p('/'))) return false;
  return here === clean || here.startsWith(`${clean}/`);
};
// The single bilingual 404 has no duplicate /en/404 route; its locale escape
// returns to the real EN homepage instead of emitting a dead destination.
const altHref = Astro.url.pathname.startsWith('/404') ? '/en/' : altLocalePath(Astro.url.pathname);
---

<header class="site-header" data-site-header>
  <nav data-nav-shrink aria-label={t('a11y.nav')} class="site-nav">
    <div class="site-nav__inner">
      <a href={p('/')} class="site-brand" aria-label={t('a11y.home')}>
        <img src="/smartcontrol-mark-96.png" alt="" width="36" height="36" decoding="async" />
        <span class="site-brand__wordmark">
          <span>Smart<span>Control</span></span>
          <span aria-hidden="true"><i></i><b>DIN 2003</b></span>
        </span>
      </a>

      <ul class="site-command" role="list">
        {navItems.map((item) => item.children ? (
          <li class="site-command__group">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={['site-command__link', inTree(item.href) && 'is-active']}
            >
              <span aria-hidden="true">{item.code}</span>{item.label}
              <ChevronDown aria-hidden="true" stroke-width={1.5} />
            </a>
            <div class="site-command__panel" data-nav-dropdown>
              <ul role="list">
                {item.children.map((child, index) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={isActive(child.href) ? 'page' : undefined}
                      class:list={[isActive(child.href) && 'is-active']}
                    >
                      <span aria-hidden="true">{item.code}.{index + 1}</span>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ) : (
          <li>
            <a href={item.href} class="site-command__link">
              <span aria-hidden="true">{item.code}</span>{item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="site-nav__actions">
        <a href={altHref} class="site-nav__locale" aria-label={t('lang.switch.aria')}>
          {t('lang.switch')}
        </a>
        <MailtoLink variant="button" subject={t('subject.assessment')} class="site-nav__cta">
          {t('cta.assessment')}
        </MailtoLink>

        <details class="mobile-command" data-mobile-nav>
          <summary
            aria-label={t('nav.menu.open')}
            data-label-open={t('nav.menu.open')}
            data-label-close={t('nav.menu.close')}
          >
            <Menu class="mobile-command__open" stroke-width={1.5} aria-hidden="true" />
            <X class="mobile-command__close" stroke-width={1.5} aria-hidden="true" />
          </summary>
          <div class="mobile-command__panel">
            <div class="mobile-command__datum" aria-hidden="true"><span>SC / INDEX</span><span>03</span></div>
            <ul role="list">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.children ? (isActive(item.href) ? 'page' : undefined) : undefined}
                    class:list={[item.children && inTree(item.href) && 'is-active']}
                  >
                    <span aria-hidden="true">{item.code}</span>{item.label}
                  </a>
                  {item.children && (
                    <ul role="list">
                      {item.children.map((child, index) => (
                        <li>
                          <a
                            href={child.href}
                            aria-current={isActive(child.href) ? 'page' : undefined}
                            class:list={[isActive(child.href) && 'is-active']}
                          >
                            <span aria-hidden="true">{item.code}.{index + 1}</span>{child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
              <li class="mobile-command__cta">
                <MailtoLink variant="button" subject={t('subject.assessment')}>
                  {t('cta.assessment')}
                </MailtoLink>
              </li>
            </ul>
          </div>
        </details>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; }
  .site-nav {
    border-bottom: 1px solid transparent;
    background: var(--color-surface);
    transition: padding 240ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 240ms ease, border-color 240ms ease;
  }
  .site-nav__inner {
    display: grid;
    width: 100%;
    max-width: 1180px;
    min-height: var(--nav-offset);
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(20px, 3vw, 40px);
    margin-inline: auto;
    padding-inline: 40px;
    transition: min-height 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .site-nav[data-shrunk] .site-nav__inner { min-height: 66px; }
  .site-brand { display: inline-flex; align-items: center; gap: 11px; min-height: 44px; text-decoration: none; }
  .site-brand img { width: 36px; height: 36px; }
  .site-brand__wordmark { display: flex; flex-direction: column; color: var(--color-navy); line-height: 1; }
  .site-brand__wordmark > span:first-child { font-size: 19px; font-weight: 700; letter-spacing: -0.3px; }
  .site-brand__wordmark > span:first-child span { color: var(--color-bright); }
  .site-brand__wordmark > span:last-child { display: flex; align-items: center; gap: 6px; margin-top: 4px; }
  .site-brand__wordmark i { width: 15px; height: 1px; background: var(--color-bright); }
  .site-brand__wordmark b { color: var(--color-royal); font-family: var(--font-mono); font-size: 8px; font-weight: 600; letter-spacing: 0.18em; }
  .site-command { display: flex; justify-content: center; gap: clamp(16px, 2.3vw, 30px); margin: 0; padding: 0; list-style: none; }
  .site-command__group { position: relative; }
  .site-command__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 7px;
    border-bottom: 2px solid transparent;
    color: var(--color-slate);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 180ms ease, color 180ms ease;
  }
  .site-command__link > span,
  .site-command__panel a > span {
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
  }
  .site-command__link svg { width: 13px; height: 13px; transition: transform 180ms ease; }
  .site-command__link:hover,
  .site-command__link.is-active,
  .site-command__link:focus-visible { border-color: var(--color-bright); color: var(--color-navy); }
  .site-command__group:hover .site-command__link svg,
  .site-command__group:focus-within .site-command__link svg { transform: rotate(180deg); }
  .site-command__panel {
    position: absolute;
    top: 100%;
    left: 50%;
    width: 268px;
    padding-top: 8px;
    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, 5px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms;
  }
  .site-command__group:hover .site-command__panel,
  .site-command__group:focus-within .site-command__panel { visibility: visible; opacity: 1; transform: translate(-50%, 0); }
  .site-command__panel ul {
    margin: 0;
    padding: 8px;
    border: 1px solid var(--color-border-blue);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
    list-style: none;
  }
  .site-command__panel a {
    display: grid;
    min-height: 44px;
    grid-template-columns: 38px 1fr;
    align-items: center;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    color: var(--color-slate);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .site-command__panel a:hover,
  .site-command__panel a:focus-visible,
  .site-command__panel a.is-active { background: var(--color-blue-wash); color: var(--color-navy); }
  .site-nav__actions { display: flex; align-items: center; gap: 12px; }
  .site-nav__locale { display: grid; min-width: 44px; min-height: 44px; place-items: center; color: var(--color-cool); font-size: 13px; font-weight: 700; text-decoration: none; }
  .site-nav__locale:hover { color: var(--color-navy); }
  :global(.site-nav__cta) { min-height: 44px !important; padding: 8px 17px !important; font-size: 13px !important; }
  .mobile-command { display: none; }

  @media (max-width: 900px) {
    .site-command { display: none; }
    .site-nav__inner { grid-template-columns: auto 1fr; }
    .site-nav__actions { justify-self: end; }
    :global(.site-nav__cta) { display: none !important; }
    .mobile-command { display: block; }
    .mobile-command summary {
      display: grid;
      width: 44px;
      height: 44px;
      place-items: center;
      border-radius: var(--radius-sm);
      color: var(--color-navy);
      cursor: pointer;
      list-style: none;
    }
    .mobile-command summary::-webkit-details-marker { display: none; }
    .mobile-command summary:hover { background: var(--color-blue-wash); }
    .mobile-command summary svg { grid-area: 1 / 1; width: 22px; height: 22px; }
    .mobile-command__close { display: none; }
    .mobile-command[open] .mobile-command__open { display: none; }
    .mobile-command[open] .mobile-command__close { display: block; }
    .mobile-command__panel {
      position: fixed;
      inset: var(--nav-offset) 0 auto;
      max-height: calc(100dvh - var(--nav-offset));
      overflow-y: auto;
      border-block: 1px solid var(--color-border-blue);
      background: var(--color-surface);
      box-shadow: var(--shadow-lg);
    }
    .mobile-command__datum {
      display: flex;
      justify-content: space-between;
      padding: 15px 24px;
      border-bottom: 1px solid var(--color-divider);
      color: var(--color-cool);
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.14em;
    }
    .mobile-command__panel > ul { margin: 0; padding: 10px 24px 24px; list-style: none; }
    .mobile-command__panel > ul > li { border-bottom: 1px solid var(--color-divider); }
    .mobile-command__panel a {
      display: grid;
      min-height: 52px;
      grid-template-columns: 42px 1fr;
      align-items: center;
      color: var(--color-slate);
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
    }
    .mobile-command__panel a > span { color: var(--color-faint); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em; }
    .mobile-command__panel a.is-active { color: var(--color-navy); }
    .mobile-command__panel li ul { margin: 0 0 8px 20px; padding: 0 0 0 14px; border-left: 1px solid var(--color-border-blue); list-style: none; }
    .mobile-command__panel li li a { min-height: 46px; grid-template-columns: 42px 1fr; color: var(--color-cool); font-size: 13.5px; font-weight: 500; }
    .mobile-command__cta { padding-block: 16px 0; border: 0 !important; }
    .mobile-command__cta a { display: inline-flex; width: 100%; color: var(--color-surface); }
  }
  @media (max-width: 767px) {
    .site-nav__inner { padding-inline: 24px; }
    .site-brand__wordmark > span:last-child { display: none; }
  }
</style>

<script>
  let navController: AbortController | undefined;

  function wireCommandNav() {
    navController?.abort();
    navController = new AbortController();
    const { signal } = navController;
    const details = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');
    if (!details) return;
    const summary = details.querySelector<HTMLElement>('summary');
    const panel = details.querySelector<HTMLElement>('.mobile-command__panel');
    const desktop = window.matchMedia('(min-width: 901px)');

    const focusables = () => panel ? [...panel.querySelectorAll<HTMLElement>('a[href],button:not([disabled])')] : [];
    const close = (restore = false) => {
      details.open = false;
      document.body.style.overflow = '';
      if (summary) {
        summary.setAttribute('aria-label', summary.dataset.labelOpen || '');
        if (restore) summary.focus();
      }
    };

    details.addEventListener('toggle', () => {
      document.body.style.overflow = details.open ? 'hidden' : '';
      summary?.setAttribute('aria-label', details.open ? summary.dataset.labelClose || '' : summary.dataset.labelOpen || '');
      if (details.open) requestAnimationFrame(() => focusables()[0]?.focus());
    }, { signal });
    panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => close(false), { signal }));
    document.addEventListener('keydown', (event) => {
      if (!details.open) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close(true);
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        summary?.focus();
      } else if (event.shiftKey && document.activeElement === summary) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === summary) {
        event.preventDefault();
        first.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        summary?.focus();
      }
    }, { signal });
    desktop.addEventListener('change', (event) => { if (event.matches) close(false); }, { signal });
    document.addEventListener('astro:before-swap', () => close(false), { signal, once: true });
  }

  document.addEventListener('astro:page-load', wireCommandNav);
</script>
