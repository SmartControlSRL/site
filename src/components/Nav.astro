---
// Command/index bar (RESOLUTIONS §16): fixed top, ALWAYS light (logo on white),
// logo + links + assessment CTA (obfuscated mailto) + RO/EN switch. Active-page
// datum underline by pathname. The resting 1px blue hairline + the scrolled
// padding/shadow/deepened-border live in global.css ([data-nav-shrink]);
// initNavShrink (wired in BaseLayout) only toggles `.is-scrolled` past 24px.
// Desktop route menus are richer light "index cards"; the mobile panel is an
// intentional light navigation surface (focus-trapped, ESC closes, body
// scroll-lock, RO/EN switch in its footer cluster).
import { ChevronDown, Menu, X, Server, ShieldCheck, Code, LifeBuoy, Shield, Lock } from '@lucide/astro';
import { getLangFromUrl, useTranslations, localizedPath, altLocalePath } from '../i18n/ui';
import MailtoLink from './MailtoLink.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);

// Two dropdown groups (parent links to the hub/index, panel lists the child
// pages with their Lucide glyphs) + a plain Contact anchor. This surfaces every
// service/solution page one hover/tap deep and gives /servicii + /solutii their
// entry points. Icons are decorative (aria-hidden).
const navItems = [
  {
    href: p('/servicii'),
    label: t('nav.services'),
    children: [
      { href: p('/servicii/cloud'), label: t('nav.cloud'), icon: Server },
      { href: p('/servicii/securitate'), label: t('footer.service.security'), icon: ShieldCheck },
      { href: p('/servicii/software'), label: t('footer.service.software'), icon: Code },
      { href: p('/servicii/managed'), label: t('footer.service.managed'), icon: LifeBuoy },
    ],
  },
  {
    href: p('/solutii'),
    label: t('nav.products'),
    children: [
      { href: p('/solutii/seknet'), label: t('nav.seknet'), icon: Shield },
      { href: p('/solutii/s-vpn'), label: t('nav.svpn'), icon: Lock },
    ],
  },
  { href: p('/#contact'), label: t('nav.contact') },
];

// Active-page underline: compare against the current pathname (ignore anchors).
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const cleanPath = (href: string) => href.split('#')[0].replace(/\/$/, '') || '/';
// Exact match — for leaf links (children, Contact) and hub pages.
const isActive = (href: string) => {
  const clean = cleanPath(href);
  return clean !== '/' && clean !== p('/') && here === clean;
};
// Tree match — a parent is active on its hub page or any descendant page.
const inTree = (href: string) => {
  const clean = cleanPath(href);
  if (clean === '/' || clean === p('/')) return false;
  return here === clean || here.startsWith(clean + '/');
};

// Language switch → the alternate-locale version of this page.
const path = Astro.url.pathname;
const altHref = altLocalePath(path);
---

<header class="fixed inset-x-0 top-0 z-50">
  <nav data-nav-shrink aria-label={t('a11y.nav')} class="bg-surface">
    <div class="mx-auto flex max-w-[1180px] items-center justify-between gap-8">
      <!-- Logo -->
      <a href={p('/')} class="flex shrink-0 items-center gap-[11px]" aria-label={t('a11y.home')}>
        <img src="/smartcontrol-mark-96.png" alt="" width="34" height="34" class="h-[34px] w-[34px]" decoding="async" />
        <span class="flex flex-col leading-none">
          <span class="text-[17px] font-bold tracking-[-0.3px] text-navy">Smart<span class="text-bright">Control</span></span>
          <span class="mt-[3px] flex items-center gap-1.5" aria-hidden="true">
            <span class="h-px w-4 shrink-0 bg-bright"></span>
            <span class="font-mono text-[9px] font-semibold uppercase tracking-[2px] text-royal">DIN 2003</span>
          </span>
        </span>
      </a>

      <!-- Desktop links -->
      <ul class="hidden items-center gap-7 md:flex">
        {
          navItems.map((item) =>
            item.children ? (
              <li class="group relative">
                <a
                  href={item.href}
                  aria-current={inTree(item.href) ? 'page' : undefined}
                  class:list={[
                    'inline-flex items-center gap-[5px] border-b-2 pb-[3px] text-[13.5px] no-underline transition-colors hover:border-bright hover:text-navy',
                    inTree(item.href)
                      ? 'border-bright font-semibold text-navy'
                      : 'border-transparent font-medium text-slate',
                  ]}
                >
                  {item.label}
                  <ChevronDown
                    class="h-[13px] w-[13px] transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"
                    stroke-width={1.5}
                    aria-hidden="true"
                  />
                </a>
                {/* Dropdown "index card" — pt-3 is a hover bridge over the gap to the trigger */}
                <div
                  data-nav-dropdown
                  class="invisible absolute left-1/2 top-full z-10 -translate-x-1/2 translate-y-1 pt-3 opacity-0 transition-[opacity,transform] duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
                >
                  <div class="min-w-[264px] rounded-xl border border-border-blue bg-surface p-2.5 shadow-lg">
                    <p
                      class="px-2.5 pb-2 font-mono text-[11px] font-semibold uppercase tracking-[2px] text-faint"
                      aria-hidden="true"
                    >
                      {item.label}
                    </p>
                    <ul class="flex flex-col gap-0.5">
                      <li>
                        <a
                          href={item.href}
                          aria-current={isActive(item.href) ? 'page' : undefined}
                          class:list={[
                            'block border-b border-divider px-2.5 pb-2.5 pt-1 text-[13.5px] no-underline transition-colors hover:text-navy',
                            isActive(item.href) ? 'font-semibold text-navy' : 'font-medium text-slate',
                          ]}
                        >
                          {item.label}
                        </a>
                      </li>
                      {item.children.map((c) => {
                        const Icon = c.icon;
                        return (
                          <li>
                            <a
                              href={c.href}
                              aria-current={isActive(c.href) ? 'page' : undefined}
                              class:list={[
                                'flex items-center gap-2.5 rounded-md px-2.5 py-2.5 text-[13.5px] no-underline transition-colors hover:bg-blue-wash hover:text-navy',
                                isActive(c.href) ? 'font-semibold text-navy' : 'font-medium text-slate',
                              ]}
                            >
                              <Icon class="h-[15px] w-[15px] shrink-0 text-royal" stroke-width={1.5} aria-hidden="true" />
                              <span>{c.label}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'border-b-2 pb-[3px] text-[13.5px] no-underline transition-colors hover:border-bright hover:text-navy',
                    isActive(item.href)
                      ? 'border-bright font-semibold text-navy'
                      : 'border-transparent font-medium text-slate',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>

      <!-- Right cluster -->
      <div class="flex items-center gap-3">
        <a
          href={altHref}
          class="text-[13.5px] font-semibold text-cool transition-colors hover:text-navy"
          aria-label={t('lang.switch.aria')}
        >
          {t('lang.switch')}
        </a>
        <MailtoLink
          variant="button"
          subject={t('subject.assessment')}
          class="!hidden !px-[18px] !py-[9px] !text-[13.5px] md:!inline-flex"
        >
          {t('cta.assessment')}
        </MailtoLink>

        <!-- Mobile hamburger -->
        <button
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="nav-mobile-panel"
          aria-label={t('nav.menu.open')}
          data-label-open={t('nav.menu.open')}
          data-label-close={t('nav.menu.close')}
          class="flex h-10 w-10 items-center justify-center rounded-md text-navy transition-colors hover:bg-blue-wash md:hidden"
        >
          <Menu data-nav-icon-open class="h-[22px] w-[22px]" stroke-width={1.5} aria-hidden="true" />
          <X data-nav-icon-close class="hidden h-[22px] w-[22px]" stroke-width={1.5} aria-hidden="true" />
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile navigation surface -->
  <div
    id="nav-mobile-panel"
    data-nav-panel
    hidden
    class="max-h-[calc(100dvh_-_var(--nav-offset))] overflow-y-auto border-b border-border-blue bg-surface shadow-md md:hidden"
  >
    <div class="mx-auto flex max-w-[1180px] flex-col gap-5 px-6 py-5">
      {
        navItems.map((item) =>
          item.children ? (
            <div>
              <a
                href={item.href}
                aria-current={inTree(item.href) ? 'page' : undefined}
                class:list={[
                  'flex min-h-[44px] items-center rounded-md px-2 font-mono text-[12px] font-semibold uppercase tracking-[2px] transition-colors',
                  inTree(item.href) ? 'text-navy' : 'text-cool',
                ]}
              >
                {item.label}
              </a>
              <ul class="mt-1 flex flex-col border-l pl-4" style="border-color: var(--sc-datum-soft)">
                {item.children.map((c) => {
                  const Icon = c.icon;
                  return (
                    <li>
                      <a
                        href={c.href}
                        aria-current={isActive(c.href) ? 'page' : undefined}
                        class:list={[
                          'flex min-h-[44px] items-center gap-2.5 rounded-md px-2 text-[15px] transition-colors hover:bg-blue-wash hover:text-navy',
                          isActive(c.href) ? 'font-semibold text-navy' : 'font-medium text-slate',
                        ]}
                      >
                        <Icon class="h-[16px] w-[16px] shrink-0 text-royal" stroke-width={1.5} aria-hidden="true" />
                        <span>{c.label}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ) : (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'flex min-h-[44px] items-center rounded-md px-2 text-[15px] transition-colors hover:bg-blue-wash',
                isActive(item.href) ? 'font-semibold text-navy' : 'font-medium text-slate',
              ]}
            >
              {item.label}
            </a>
          )
        )
      }

      <!-- Footer cluster: assessment CTA pinned full-width + RO/EN switch -->
      <div class="mt-1 flex flex-col gap-3 border-t border-divider pt-4">
        <MailtoLink variant="button" subject={t('subject.assessment')} class="w-full">
          {t('cta.assessment')}
        </MailtoLink>
        <a
          href={altHref}
          class="flex min-h-[44px] items-center justify-center rounded-md font-mono text-[12px] font-semibold uppercase tracking-[2px] text-cool transition-colors hover:text-navy"
          aria-label={t('lang.switch.aria')}
        >
          {t('lang.switch')}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu: toggle the slide-down surface, swap icon, lock body scroll, ESC
  // closes and returns focus to the toggle. While open, Tab cycles within the
  // panel (the one sanctioned focus trap). Re-bound on every View Transition
  // page load. Idempotent: each run aborts the previous run's listeners (incl.
  // the document keydown) via an AbortController before re-wiring against the
  // fresh DOM.
  let mobileNavAborter: AbortController | undefined;
  function wireMobileNav() {
    mobileNavAborter?.abort();
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
    if (!toggle || !panel) return;
    mobileNavAborter = new AbortController();
    const { signal } = mobileNavAborter;
    const iconOpen = toggle.querySelector<SVGElement>('[data-nav-icon-open]');
    const iconClose = toggle.querySelector<SVGElement>('[data-nav-icon-close]');

    const focusable = () =>
      Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter(
        (el) => el.offsetParent !== null
      );

    let open = false;
    const set = (next: boolean) => {
      open = next;
      toggle.setAttribute('aria-expanded', String(open));
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (label) toggle.setAttribute('aria-label', label);
      panel.hidden = !open;
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) focusable()[0]?.focus();
    };
    set(false);

    toggle.addEventListener('click', () => set(!open), { signal });
    panel
      .querySelectorAll('a')
      .forEach((a) => a.addEventListener('click', () => set(false), { signal }));
    document.addEventListener(
      'keydown',
      (e) => {
        if (!open) return;
        if (e.key === 'Escape') {
          set(false);
          toggle.focus();
          return;
        }
        if (e.key === 'Tab') {
          const items = focusable();
          if (!items.length) return;
          const first = items[0];
          const last = items[items.length - 1];
          const activeEl = document.activeElement as HTMLElement | null;
          if (e.shiftKey && (activeEl === first || !panel.contains(activeEl))) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && (activeEl === last || !panel.contains(activeEl))) {
            e.preventDefault();
            first.focus();
          }
        }
      },
      { signal }
    );
  }

  document.addEventListener('astro:page-load', wireMobileNav);

  // Desktop dropdowns: Escape dismisses an open panel (WCAG 1.4.13). Focus case
  // → blur collapses :focus-within; hover case → inline-hide the panel until
  // the pointer leaves the trigger group. Registered ONCE at module scope with
  // event-time element resolution, so it survives View Transition swaps.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLElement>('[data-nav-dropdown]').forEach((panel) => {
      const group = panel.closest<HTMLElement>('li');
      if (!group) return;
      const focused = document.activeElement instanceof HTMLElement && group.contains(document.activeElement);
      if (focused) (document.activeElement as HTMLElement).blur();
      if (group.matches(':hover')) {
        panel.style.visibility = 'hidden';
        panel.style.opacity = '0';
        group.addEventListener(
          'mouseleave',
          () => {
            panel.style.visibility = '';
            panel.style.opacity = '';
          },
          { once: true }
        );
      }
    });
  });
</script>
