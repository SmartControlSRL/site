---
// Export nav (RESOLUTIONS §16): fixed top, ALWAYS light (logo on white), logo +
// links + assessment CTA (obfuscated mailto) + RO/EN switch. Active-page
// underline by pathname. initNavShrink (wired in BaseLayout) tightens padding +
// adds a hairline/shadow past 24px scroll — it targets [data-nav-shrink].
// Mobile/tablet (<1024px): hamburger toggles a light slide-down panel
// (aria-expanded, ESC closes, body scroll-lock while open). The 1024px desktop
// threshold keeps the full EN row on one line and avoids the 768px collision.
import { ChevronDown, Menu, X } from "@lucide/astro";
import {
  getLangFromUrl,
  useTranslations,
  localizedPath,
  altLocalePath,
} from "../i18n/ui";
import MailtoLink from "./MailtoLink.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);

// Overview links lead to homepage sections; dropdowns retain direct detail access.
const navItems = [
  {
    href: p("/#servicii"),
    label: t("nav.services"),
    children: [
      { href: p("/servicii/cloud"), label: t("nav.cloud") },
      { href: p("/servicii/securitate"), label: t("footer.service.security") },
      { href: p("/servicii/software"), label: t("footer.service.software") },
      { href: p("/servicii/managed"), label: t("footer.service.managed") },
    ],
  },
  {
    href: p("/#produse"),
    label: t("nav.products"),
    children: [
      { href: p("/solutii/seknet"), label: t("nav.seknet") },
      { href: p("/solutii/s-vpn"), label: t("nav.svpn") },
    ],
  },
  { href: p("/#cum-lucram"), label: t("nav.approach") },
  { href: p("/#contact"), label: t("nav.contact") },
];

// Active-page underline: compare against the current pathname (ignore anchors).
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const cleanPath = (href: string) =>
  href.split("#")[0].replace(/\/$/, "") || "/";
// Exact match — for leaf links (children, Contact).
const isActive = (href: string) => {
  if (href.includes("#")) return false;
  const clean = cleanPath(href);
  return clean !== "/" && clean !== p("/") && here === clean;
};

// Language switch → the alternate-locale version of this page.
const path = Astro.url.pathname;
const altHref = altLocalePath(path);
const productKey = path.includes("/solutii/seknet")
  ? "seknet"
  : path.includes("/solutii/s-vpn")
    ? "svpn"
    : null;
const navSubject = productKey
  ? t(`subject.demo.${productKey}`)
  : t("subject.assessment");
const navCta = productKey ? t(`cta.demo.${productKey}`) : t("cta.assessment");
const altLang = lang === "ro" ? "en" : "ro";
---

<header class="fixed inset-x-0 top-0 z-50">
  <nav
    data-nav-shrink
    aria-label={t("a11y.nav")}
    class="border-b border-transparent bg-surface px-4 py-[18px] transition-[padding,box-shadow,border-color] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] sm:px-6 lg:px-10"
  >
    <div class="mx-auto flex max-w-[1180px] items-center justify-between gap-5">
      <!-- Logo -->
      <a
        href={p("/")}
        class="flex shrink-0 items-center gap-[11px]"
        aria-label={t("a11y.home")}
      >
        <img
          src="/smartcontrol-mark-96.png"
          alt=""
          width="34"
          height="34"
          class="h-[34px] w-[34px]"
          decoding="async"
        />
        <span class="flex flex-col leading-none">
          <span
            data-brand-wordmark
            class="text-[17px] font-bold tracking-[-0.3px] text-navy"
            >Smart<span class="text-bright">Control</span></span
          >
          <span class="mt-[3px] flex items-center gap-1.5" aria-hidden="true">
            <span class="h-px w-4 shrink-0 bg-bright"></span>
            <span
              class="font-mono text-[9px] font-semibold uppercase tracking-[2px] text-royal"
              >IT ENTERPRISE</span
            >
          </span>
        </span>
      </a>

      <!-- Desktop links -->
      <ul data-nav-desktop class="hidden items-center gap-5 lg:flex">
        {
          navItems.map((item) =>
            item.children ? (
              <li class="group relative">
                <a
                  data-nav-dropdown-trigger
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "inline-flex items-center gap-[5px] border-b-2 pb-[3px] text-[13.5px] no-underline transition-colors hover:border-bright hover:text-navy",
                    item.children.some((child) => isActive(child.href))
                      ? "border-bright font-semibold text-navy"
                      : "border-transparent font-medium text-slate",
                  ]}
                >
                  {item.label}
                  <ChevronDown
                    class="h-[13px] w-[13px] transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"
                    stroke-width={1.5}
                    aria-hidden="true"
                  />
                </a>
                {/* Dropdown panel — pt-3 is a hover bridge over the gap to the trigger */}
                <div
                  data-nav-dropdown
                  class="invisible absolute left-1/2 top-full z-10 -translate-x-1/2 translate-y-1 pt-3 opacity-0 transition-[opacity,transform] duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
                >
                  <ul class="min-w-[232px] rounded-xl border border-border bg-surface p-2 [box-shadow:0_12px_32px_rgba(14,31,91,0.16)]">
                    {item.children.map((c) => (
                      <li>
                        <a
                          href={c.href}
                          aria-current={isActive(c.href) ? "page" : undefined}
                          class:list={[
                            "block rounded-md px-3 py-2.5 text-[13.5px] no-underline transition-colors hover:bg-blue-wash hover:text-navy",
                            isActive(c.href)
                              ? "font-semibold text-navy"
                              : "font-medium text-slate",
                          ]}
                        >
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "border-b-2 pb-[3px] text-[13.5px] no-underline transition-colors hover:border-bright hover:text-navy",
                    isActive(item.href)
                      ? "border-bright font-semibold text-navy"
                      : "border-transparent font-medium text-slate",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>

      <!-- Right cluster -->
      <div class="flex shrink-0 items-center gap-3">
        <a
          href={altHref}
          lang={altLang}
          hreflang={altLang}
          aria-labelledby="language-switch-token language-switch-action"
          class="text-[13.5px] font-semibold text-cool transition-colors hover:text-navy"
        >
          <span id="language-switch-token" lang={altLang}
            >{t("lang.switch")}</span
          >
          <span id="language-switch-action" lang={lang} class="sr-only"
            >{t("lang.switch.action")}</span
          >
        </a>
        <MailtoLink
          variant="button"
          subject={navSubject}
          class="!hidden !px-[18px] !py-[9px] !text-[13.5px] lg:!inline-flex"
        >
          {navCta}
        </MailtoLink>

        <!-- Mobile hamburger -->
        <button
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="nav-mobile-panel"
          aria-label={t("nav.menu.open")}
          data-label-open={t("nav.menu.open")}
          data-label-close={t("nav.menu.close")}
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md text-navy transition-colors hover:bg-blue-wash lg:hidden"
        >
          <Menu
            data-nav-icon-open
            class="h-[22px] w-[22px]"
            stroke-width={1.5}
            aria-hidden="true"
          />
          <X
            data-nav-icon-close
            class="hidden h-[22px] w-[22px]"
            stroke-width={1.5}
            aria-hidden="true"
          />
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile slide-down panel -->
  <div
    id="nav-mobile-panel"
    data-nav-panel
    hidden
    class="max-h-[calc(100dvh_-_var(--nav-offset))] overflow-y-auto border-b border-border bg-surface shadow-md lg:hidden"
  >
    <ul class="mx-auto flex max-w-[1180px] flex-col gap-1 px-4 py-4 sm:px-6">
      {
        navItems.map((item) =>
          item.children ? (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "block rounded-md px-3 py-3 text-[15px] transition-colors hover:bg-blue-wash",
                  item.children.some((child) => isActive(child.href))
                    ? "font-semibold text-navy"
                    : "font-medium text-slate",
                ]}
              >
                {item.label}
              </a>
              <ul class="mb-1 ml-3 flex flex-col gap-0.5 border-l border-divider pl-3">
                {item.children.map((c) => (
                  <li>
                    <a
                      href={c.href}
                      aria-current={isActive(c.href) ? "page" : undefined}
                      class:list={[
                        "block rounded-md px-3 py-2.5 text-[14px] transition-colors hover:bg-blue-wash hover:text-navy",
                        isActive(c.href)
                          ? "font-semibold text-navy"
                          : "font-medium text-cool",
                      ]}
                    >
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "block rounded-md px-3 py-3 text-[15px] transition-colors hover:bg-blue-wash",
                  isActive(item.href)
                    ? "font-semibold text-navy"
                    : "font-medium text-slate",
                ]}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
      <li class="mt-2 px-3">
        <MailtoLink variant="button" subject={navSubject} class="w-full">
          {navCta}
        </MailtoLink>
      </li>
    </ul>
  </div>
</header>

<script>
  // Mobile menu: toggle the slide-down panel, swap icon, lock body scroll, ESC
  // closes. Re-bound on every View Transition page load. Idempotent: each run
  // aborts the previous run's listeners (incl. the document keydown) via an
  // AbortController before re-wiring against the fresh DOM.
  let mobileNavAborter: AbortController | undefined;
  function wireMobileNav() {
    mobileNavAborter?.abort();
    const toggle =
      document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const panel = document.querySelector<HTMLElement>("[data-nav-panel]");
    if (!toggle || !panel) return;
    mobileNavAborter = new AbortController();
    const { signal } = mobileNavAborter;
    const iconOpen = toggle.querySelector<SVGElement>("[data-nav-icon-open]");
    const iconClose = toggle.querySelector<SVGElement>("[data-nav-icon-close]");

    let open = false;
    let desktop = window.innerWidth >= 1024;
    const set = (next: boolean) => {
      open = next;
      toggle.setAttribute("aria-expanded", String(open));
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (label) toggle.setAttribute("aria-label", label);
      panel.hidden = !open;
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
      document.body.style.overflow = open ? "hidden" : "";
    };
    set(false);

    toggle.addEventListener("click", () => set(!open), { signal });
    window.addEventListener(
      "resize",
      () => {
        const nextDesktop = window.innerWidth >= 1024;
        if (nextDesktop !== desktop) set(false);
        desktop = nextDesktop;
      },
      { signal },
    );
    panel
      .querySelectorAll("a")
      .forEach((a) =>
        a.addEventListener("click", () => set(false), { signal }),
      );
    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "Escape" && open) {
          set(false);
          toggle.focus();
        }
      },
      { signal },
    );
  }

  document.addEventListener("astro:page-load", wireMobileNav);

  // Desktop dropdowns: Escape dismisses the panel and returns focus to its
  // trigger. Inline hiding overrides :focus-within until focus/pointer leaves
  // the group, then resets so the next interaction can open it normally.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    document
      .querySelectorAll<HTMLElement>("[data-nav-dropdown]")
      .forEach((panel) => {
        const group = panel.closest<HTMLElement>("li");
        if (!group) return;
        const focused =
          document.activeElement instanceof HTMLElement &&
          group.contains(document.activeElement);
        if (focused || group.matches(":hover")) {
          const trigger = group.querySelector<HTMLElement>(
            "[data-nav-dropdown-trigger]",
          );
          panel.style.visibility = "hidden";
          panel.style.opacity = "0";
          panel.style.pointerEvents = "none";
          if (focused) trigger?.focus({ preventScroll: true });
          const reset = () => {
            panel.style.visibility = "";
            panel.style.opacity = "";
            panel.style.pointerEvents = "";
          };
          group.addEventListener(
            "focusout",
            (event) => {
              if (!group.contains(event.relatedTarget as Node | null)) reset();
            },
            { once: true },
          );
          group.addEventListener("mouseleave", reset, { once: true });
        }
      });
  });
</script>
