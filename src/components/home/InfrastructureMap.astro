---
import {
  Server,
  ShieldCheck,
  Code,
  Workflow,
  Pause,
  Play,
} from "@lucide/astro";
interface Props {
  en: boolean;
}
const { en } = Astro.props;
const nodes = [
  {
    label: en ? "Infrastructure" : "Infrastructură",
    detail: "Cloud · Data center",
    icon: Server,
    cls: "infra",
  },
  {
    label: en ? "Security" : "Securitate",
    detail: en ? "Network · Identity" : "Rețea · Identitate",
    icon: ShieldCheck,
    cls: "security",
  },
  { label: "Software", detail: "API · DevSecOps", icon: Code, cls: "software" },
  {
    label: en ? "Operations" : "Operare",
    detail: en ? "Monitoring · Support" : "Monitorizare · Suport",
    icon: Workflow,
    cls: "operations",
  },
];
---

<figure class="architecture" data-home-map>
  <div class="map-heading">
    <span>SMART CONTROL / {en ? "SERVICE MAP" : "SERVICII"}</span><span
      aria-hidden="true">01—04</span
    >
  </div>
  <div class="map-scene">
    <svg
      class="connections"
      viewBox="0 0 520 430"
      fill="none"
      aria-hidden="true"
    >
      <circle cx="260" cy="215" r="158" class="orbit"></circle>
      <circle cx="260" cy="215" r="108" class="orbit inner"></circle>
      <g class="routes"
        ><path d="M140 82H260V215"></path><path d="M380 82H260V215"></path><path
          d="M140 350H260V215"></path><path d="M380 350H260V215"></path></g
      >
      <g class="signals"
        ><path d="M140 82H260V215"></path><path d="M380 82H260V215"></path><path
          d="M140 350H260V215"></path><path d="M380 350H260V215"></path></g
      >
      <g class="junctions"
        ><circle cx="260" cy="82" r="4"></circle><circle cx="260" cy="82" r="4"
        ></circle><circle cx="260" cy="350" r="4"></circle><circle
          cx="260"
          cy="350"
          r="4"></circle></g
      >
    </svg>
    {
      nodes.map(({ label, detail, icon: Icon, cls }) => (
        <div class:list={["map-node", cls]}>
          <>
            <Icon size={21} stroke-width={1.5} />
            <div>
              <>
                <strong>{label}</strong>
                <span>{detail}</span>
              </>
            </div>
          </>
        </div>
      ))
    }
    <div class="map-core">
      <img
        src="/smartcontrol-mark-96.png"
        width="42"
        height="42"
        alt=""
      /><strong>Smart Control</strong><span
        >{en ? "Delivery coordination" : "Coordonarea livrării"}</span
      >
    </div>
  </div>
  <div class="map-footer">
    <figcaption>
      {
        en
          ? "Connected expertise. Coordinated delivery."
          : "Expertiză conectată. Livrare coordonată."
      }
    </figcaption><button
      type="button"
      data-map-toggle
      aria-pressed="false"
      aria-label={en ? "Pause diagram animation" : "Pauză animație diagramă"}
      data-pause={en ? "Pause diagram animation" : "Pauză animație diagramă"}
      data-play={en ? "Play diagram animation" : "Pornește animația diagramei"}
      hidden
      ><Pause class="pause-icon" size={16} /><Play
        class="play-icon"
        size={16}
      /></button
    >
  </div>
</figure>
<style>
  .architecture {
    position: relative;
    color: var(--color-navy);
    min-width: 0;
  }
  .map-heading,
  .map-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .map-heading {
    font: 12px var(--font-mono);
    letter-spacing: 1px;
    padding: 0 10px 18px;
    border-bottom: 1px solid var(--color-border-blue);
  }
  .map-scene {
    position: relative;
    aspect-ratio: 520/430;
    min-height: 380px;
    width: 100%;
    isolation: isolate;
  }
  .map-scene::before {
    content: "";
    position: absolute;
    inset: 10%;
    z-index: -1;
    background: radial-gradient(
      ellipse,
      var(--color-blue-wash),
      transparent 70%
    );
  }
  .connections {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .orbit {
    stroke: var(--color-border-blue);
    stroke-width: 1;
    stroke-dasharray: 3 6;
  }
  .inner {
    stroke-dasharray: none;
    opacity: 0.65;
  }
  .routes {
    stroke: var(--color-border-blue);
    stroke-width: 1.5;
  }
  .signals {
    stroke: var(--color-bright);
    stroke-width: 2;
    stroke-dasharray: none;
    opacity: 0.65;
  }
  [data-map-ready] .signals {
    stroke-dasharray: 14 290;
    stroke-dashoffset: 304;
    animation: flow 6s linear infinite;
  }
  .signals path:nth-child(2) {
    opacity: 0.65;
  }
  .signals path:nth-child(3) {
    opacity: 0.8;
  }
  .junctions {
    fill: var(--color-bright);
  }
  .map-node {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--color-surface);
    padding: 15px 17px;
    border: 1px solid var(--color-border-blue);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    width: 44%;
  }
  .map-node svg {
    flex-shrink: 0;
    color: var(--color-mid-blue);
  }
  .map-node strong {
    font-size: 14px;
    font-weight: 600;
    display: block;
  }
  .map-node span {
    font-size: 12px;
    color: var(--color-slate);
    display: block;
    margin-top: 3px;
    white-space: nowrap;
  }
  .infra {
    left: 0;
    top: 10%;
  }
  .security {
    right: 0;
    top: 10%;
  }
  .software {
    left: 0;
    top: 72%;
  }
  .operations {
    right: 0;
    top: 72%;
  }
  .map-core {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    width: 162px;
    height: 138px;
    background: var(--color-surface);
    border: 1px solid var(--color-border-blue);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }
  .map-core strong {
    font-size: 17px;
    letter-spacing: -0.5px;
    margin-top: 8px;
  }
  .map-core span {
    font-size: 12px;
    color: var(--color-slate);
    margin-top: 3px;
  }
  .map-footer {
    border-top: 1px solid var(--color-border-blue);
    padding: 16px 10px 0;
    min-height: 58px;
  }
  .map-footer figcaption {
    font-size: 13px;
    color: var(--color-slate);
  }
  button {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border-blue);
    border-radius: 50%;
    cursor: pointer;
  }
  button[hidden] {
    display: none;
  }
  button:hover {
    background: var(--color-blue-wash);
  }
  .play-icon {
    display: none;
  }
  [data-paused] .signals {
    animation-play-state: paused;
  }
  [data-paused] .pause-icon {
    display: none;
  }
  [data-paused] .play-icon {
    display: block;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 480px) {
    .map-heading {
      font-size: 12px;
    }
    .map-node {
      padding: 10px;
      gap: 7px;
    }
    .map-node strong {
      font-size: 12px;
    }
    .map-node span {
      font-size: 12px;
    }
    .map-node svg {
      width: 17px;
    }
    .map-core {
      width: 125px;
      height: 110px;
    }
    .map-core strong {
      font-size: 15px;
    }
    .map-core span {
      font-size: 12px;
    }
    .map-core img {
      width: 32px;
      height: 32px;
    }
    .map-footer figcaption {
      font-size: 12px;
    }
  }
  @media (max-width: 480px) {
    .map-node span {
      display: none;
    }
    .map-node {
      padding-inline: 7px;
    }
  }
  @media (max-width: 360px) {
    .map-node svg {
      display: none;
    }
    .map-node strong {
      font-size: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-map-ready] .signals {
      animation: none;
      stroke-dasharray: none;
      opacity: 0.5;
    }
  }
</style>
<script>
  let cleanup = () => {};
  function initMap() {
    cleanup();
    const root = document.querySelector<HTMLElement>("[data-home-map]");
    const button = root?.querySelector<HTMLButtonElement>("[data-map-toggle]");
    if (!root || !button) return;
    const media = window.matchMedia("(prefers-reduced-motion: reduce)");
    const controller = new AbortController();
    let paused = false;
    const sync = () => {
      root.toggleAttribute("data-paused", paused || media.matches);
      button.hidden = media.matches;
      button.setAttribute("aria-pressed", String(paused));
      button.setAttribute(
        "aria-label",
        (paused ? button.dataset.play : button.dataset.pause) || "",
      );
    };
    button.addEventListener(
      "click",
      () => {
        paused = !paused;
        sync();
      },
      { signal: controller.signal },
    );
    media.addEventListener("change", sync, { signal: controller.signal });
    root.setAttribute("data-map-ready", "");
    sync();
    cleanup = () => controller.abort();
  }
  document.addEventListener("astro:page-load", initMap);
  document.addEventListener("astro:before-swap", () => cleanup());
</script>
