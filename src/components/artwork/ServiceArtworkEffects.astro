---
import type { ServiceArtwork } from "../../content/service-pages";

interface Props {
  artwork: ServiceArtwork;
}

const { artwork } = Astro.props;

// Coordinates follow the visible surfaces in the approved 1600 × 900 artwork.
// The raster and SVG must share the same fit, position and parent transform.
const profiles: Record<
  ServiceArtwork,
  { fit: string; paths: Array<{ d: string; delay: string }> }
> = {
  "architecture-light": {
    fit: "xMaxYMid slice",
    paths: [
      { d: "M1130 30 L1368 95 L1368 629", delay: "-1s" },
      { d: "M974 220 L1231 317 L1231 695", delay: "-5s" },
      { d: "M1004 565 L1231 697 L1512 866", delay: "-9s" },
    ],
  },
  "network-security": {
    fit: "xMaxYMid slice",
    paths: [
      {
        d: "M1197 913 C1320 785 1272 654 1220 561 C1158 450 1158 379 1298 334",
        delay: "-2s",
      },
    ],
  },
  "software-automation": {
    fit: "xMaxYMid meet",
    paths: [
      { d: "M906 562 C943 550 926 494 967 479", delay: "0s" },
      { d: "M1065 442 C1094 429 1077 385 1119 365", delay: "-7.5s" },
      { d: "M1217 315 C1231 276 1241 255 1268 249", delay: "-5s" },
      {
        d: "M1378 211 C1436 195 1483 189 1508 249 C1544 330 1514 417 1488 448",
        delay: "-2.5s",
      },
    ],
  },
  "managed-services": {
    fit: "xMaxYMid meet",
    paths: [
      {
        d: "M1094 74 C1252 19 1421 158 1443 346 C1465 516 1364 639 1236 683",
        delay: "-1s",
      },
      {
        d: "M1080 180 C1195 133 1320 240 1318 400 C1317 506 1247 586 1161 605",
        delay: "-6s",
      },
      {
        d: "M1095 253 C1006 276 979 353 1006 438 C1020 482 1044 511 1081 533",
        delay: "-9s",
      },
    ],
  },
};

const profile = profiles[artwork];
---

{
  profile && (
    <svg
      class:list={["artwork-effects", `svc-artwork--${artwork}`]}
      data-artwork-effects
      aria-hidden="true"
      focusable="false"
      viewBox="0 0 1600 900"
      width="1600"
      height="900"
      preserveAspectRatio={profile.fit}
      fill="none"
    >
      {profile.paths.map(({ d, delay }) => (
        <g style={`--svc-delay: ${delay}`}>
          <path class="svc-stroke svc-stroke--halo" d={d} pathLength="100" />
          <path class="svc-stroke svc-stroke--core" d={d} pathLength="100" />
        </g>
      ))}
    </svg>
  )
}

<style>
  .artwork-effects {
    opacity: 0;
    pointer-events: none;
    --svc-duration: 12s;
  }

  :global(.ambient-artwork[data-artwork-state="running"]) .artwork-effects,
  :global(.ambient-artwork[data-artwork-state="paused"]) .artwork-effects {
    opacity: 1;
  }

  .svc-stroke {
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 14 100;
    stroke-dashoffset: 16;
    opacity: 0;
    animation: svc-travel var(--svc-duration) linear infinite;
    animation-delay: var(--svc-delay);
    animation-play-state: var(--artwork-play-state, paused);
  }

  .svc-stroke--halo {
    stroke: var(--color-sky);
    stroke-width: 10;
    stroke-opacity: 0.22;
  }

  .svc-stroke--core {
    stroke: var(--color-blue-wash);
    stroke-width: 3.2;
    stroke-opacity: 0.95;
  }

  .svc-artwork--network-security {
    --svc-duration: 8s;
  }

  .svc-artwork--network-security .svc-stroke {
    stroke-dasharray: 11 100;
  }

  .svc-artwork--network-security .svc-stroke--core,
  .svc-artwork--software-automation .svc-stroke--core {
    stroke-width: 4;
  }

  .svc-artwork--software-automation {
    --svc-duration: 10s;
  }

  .svc-artwork--software-automation .svc-stroke {
    stroke-dasharray: 20 100;
    animation-name: svc-assemble;
  }

  .svc-artwork--managed-services {
    --svc-duration: 13s;
  }

  .svc-artwork--managed-services .svc-stroke {
    stroke-dasharray: 10 100;
  }

  :global(.ambient-artwork[data-artwork-state="static"]) .svc-stroke {
    animation: none;
  }

  @keyframes svc-travel {
    0% {
      opacity: 0;
      stroke-dashoffset: 16;
    }
    12% {
      opacity: 0.85;
    }
    72% {
      opacity: 0.85;
    }
    88%,
    100% {
      opacity: 0;
      stroke-dashoffset: -110;
    }
  }

  /* Each stage lights up in order, with a breath before the next one. */
  @keyframes svc-assemble {
    0% {
      opacity: 0;
      stroke-dashoffset: 24;
    }
    3% {
      opacity: 0.9;
    }
    19% {
      opacity: 0.9;
    }
    23%,
    100% {
      opacity: 0;
      stroke-dashoffset: -120;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .artwork-effects {
      display: none;
    }

    .svc-stroke {
      animation: none;
    }
  }
</style>
