---
import type { ProductArtwork } from "../../content/product-pages";

interface Props {
  artwork: ProductArtwork;
}

const { artwork } = Astro.props;
const seknetBeams = [
  { path: "M 1040 189 L 1287 293", delay: "0s" },
  { path: "M 1038 385 L 1327 382", delay: "-4s" },
  { path: "M 1053 637 L 1289 479", delay: "-8s" },
];
---

<svg
  class="artwork-effects"
  data-artwork-effects
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 1600 900"
  width="1600"
  height="900"
  preserveAspectRatio="xMaxYMid meet"
>
  {
    artwork === "seknet-observability" ? (
      <>
        {seknetBeams.map(({ path, delay }) => (
          <g style={`--prod-signal-delay: ${delay}`}>
            <path
              class="prod-signal prod-signal--halo"
              d={path}
              pathLength="100"
            />
            <path
              class="prod-signal prod-signal--core"
              d={path}
              pathLength="100"
            />
          </g>
        ))}
        <path
          class="prod-collector-face"
          d="M 1330 73 L 1287 195 L 1284 545 L 1329 669 L 1378 546 L 1379 205 Z"
        />
        <path
          class="prod-collector-facet"
          d="M 1287 293 L 1328 382 L 1378 205 M 1289 479 L 1328 382 L 1378 546"
        />
      </>
    ) : (
      <>
        <path
          class="prod-channel prod-channel--halo"
          d="M 980 427 L 1260 448"
          pathLength="100"
        />
        <path
          class="prod-channel prod-channel--core"
          d="M 980 427 L 1260 448"
          pathLength="100"
        />
        <path class="prod-channel-edge" d="M 981 460 L 1261 482" />
      </>
    )
  }
</svg>

<style>
  .artwork-effects {
    opacity: 0;
    pointer-events: none;
  }

  :global(.ambient-artwork[data-artwork-state="running"]) .artwork-effects,
  :global(.ambient-artwork[data-artwork-state="paused"]) .artwork-effects {
    opacity: 1;
  }

  .prod-signal,
  .prod-channel {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 10 110;
    stroke-dashoffset: 10;
    opacity: 0;
  }

  .prod-signal {
    animation: prod-signal-travel 12s linear infinite;
    animation-delay: var(--prod-signal-delay, 0s);
  }

  .prod-signal--halo {
    stroke: var(--color-bright);
    stroke-width: 8;
    stroke-opacity: 0.16;
  }

  .prod-signal--core {
    stroke: var(--color-blue-wash);
    stroke-width: 2;
    stroke-opacity: 0.92;
  }

  .prod-collector-face {
    fill: var(--color-sky);
    animation: prod-collector-response 4s ease-in-out infinite;
  }

  .prod-collector-facet {
    fill: none;
    stroke: var(--color-blue-wash);
    stroke-width: 1.4;
    animation: prod-collector-facet 4s ease-in-out infinite;
  }

  .prod-channel {
    stroke-dasharray: 13 120;
    animation: prod-channel-travel 9s linear infinite;
  }

  .prod-channel--halo {
    stroke: var(--color-sky);
    stroke-width: 11;
    stroke-opacity: 0.22;
  }

  .prod-channel--core {
    stroke: var(--color-surface);
    stroke-width: 3;
    stroke-opacity: 0.95;
  }

  .prod-channel-edge {
    fill: none;
    stroke: var(--color-sky);
    stroke-width: 1.5;
    animation: prod-channel-response 9s ease-in-out infinite;
  }

  .prod-signal,
  .prod-collector-face,
  .prod-collector-facet,
  .prod-channel,
  .prod-channel-edge {
    animation-play-state: var(--artwork-play-state, paused);
  }

  @keyframes prod-signal-travel {
    0% {
      stroke-dashoffset: 10;
      opacity: 0;
    }
    8% {
      opacity: 0.8;
    }
    60% {
      stroke-dashoffset: -100;
      opacity: 0.8;
    }
    66%,
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }

  @keyframes prod-collector-response {
    0%,
    48%,
    100% {
      opacity: 0.015;
    }
    80% {
      opacity: 0.12;
    }
  }

  @keyframes prod-collector-facet {
    0%,
    48%,
    100% {
      opacity: 0.04;
    }
    80% {
      opacity: 0.3;
    }
  }

  @keyframes prod-channel-travel {
    0% {
      stroke-dashoffset: 13;
      opacity: 0;
    }
    10% {
      opacity: 0.92;
    }
    65% {
      stroke-dashoffset: -100;
      opacity: 0.92;
    }
    73%,
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }

  @keyframes prod-channel-response {
    0%,
    40%,
    100% {
      opacity: 0.04;
    }
    66% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .artwork-effects {
      opacity: 0 !important;
    }

    .prod-signal,
    .prod-collector-face,
    .prod-collector-facet,
    .prod-channel,
    .prod-channel-edge {
      animation: none;
    }
  }
</style>
