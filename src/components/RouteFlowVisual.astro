---
// A reusable, static process diagram for service and product pages. The text
// itself is the accessible equivalent: no meaning depends on connectors,
// colour, animation, or a third-party image request.
import SectionHeading from './SectionHeading.astro';

export interface FlowStep {
  label: string;
  title: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  description: string;
  steps: FlowStep[];
  caption: string;
  id?: string;
  surface?: 'page' | 'surface';
}

const {
  eyebrow,
  heading,
  description,
  steps,
  caption,
  id,
  surface = 'surface',
} = Astro.props;
const headingId = `${id ?? 'route-flow'}-heading`;
---

<section
  id={id}
  data-route-visual
  class:list={[
    'py-[56px] sm:py-[80px]',
    surface === 'page' ? 'bg-page' : 'bg-surface',
  ]}
>
  <div class="container">
    <figure aria-labelledby={headingId} aria-describedby={`${headingId}-caption`}>
      <div id={headingId}>
        <SectionHeading eyebrow={eyebrow} heading={heading}>{description}</SectionHeading>
      </div>

      <ol class="relative mt-10 grid gap-4 lg:grid-cols-[repeat(var(--flow-count),minmax(0,1fr))]" style={`--flow-count:${steps.length}`}>
        {
          steps.map((step, index) => (
            <li class="relative rounded-xl border border-border-blue bg-surface p-6 shadow-sm">
              <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-blue-wash font-mono text-[12px] font-semibold text-royal">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="font-mono text-[11px] font-semibold uppercase tracking-[1.5px] text-royal">
                  {step.label}
                </span>
              </div>
              <h3 class="mt-5 text-[18px] font-bold text-navy">{step.title}</h3>
              <p class="mt-3 text-[14px] leading-[1.7] text-cool">{step.body}</p>
              {
                index < steps.length - 1 && (
                  <span
                    aria-hidden="true"
                    class="absolute -bottom-[17px] left-1/2 h-[17px] w-px bg-border-blue lg:-right-[17px] lg:bottom-auto lg:left-auto lg:top-1/2 lg:h-px lg:w-[17px]"
                  />
                )
              }
            </li>
          ))
        }
      </ol>

      <figcaption id={`${headingId}-caption`} class="mt-6 max-w-[820px] text-[13.5px] leading-[1.7] text-slate">
        {caption}
      </figcaption>
    </figure>
  </div>
</section>
