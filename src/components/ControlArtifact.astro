---
/**
 * Decorative, code-native artifacts for the Control Plane system.
 *
 * Every variant shares the same viewBox, datum, path and depth grammar. Public
 * meaning always remains in adjacent semantic HTML; this SVG is intentionally
 * hidden from assistive technology. The shared scene lifecycle only adjusts
 * CSS custom properties on the wrapping route scene.
 */
type ControlArtifactVariant =
  | 'stack'
  | 'atlas'
  | 'cloud'
  | 'security'
  | 'software'
  | 'managed'
  | 'solutions'
  | 'seknet'
  | 'svpn'
  | 'missing';

interface Props {
  variant: ControlArtifactVariant;
  dark?: boolean;
  compact?: boolean;
  class?: string;
}

const { variant, dark = false, compact = false, class: extra = '' } = Astro.props;
---

<div
  class:list={[
    'control-artifact',
    dark && 'control-artifact--dark',
    compact && 'control-artifact--compact',
    extra,
  ]}
  data-artifact={variant}
  aria-hidden="true"
>
  <svg viewBox="0 0 560 440" fill="none" role="presentation">
    <g class="control-artifact__blueprint">
      <path d="M34 72H526M34 220H526M34 368H526" />
      <path d="M76 36V404M280 36V404M484 36V404" />
      <path d="M28 64h12M34 58v12M520 360h12M526 354v12" />
