        <circle class="node node--hot" cx="280" cy="115" r="7" />
        <circle class="node" cx="280" cy="177" r="6" />
        <circle class="node" cx="280" cy="239" r="6" />
        <circle class="node" cx="280" cy="301" r="6" />
      </g>
