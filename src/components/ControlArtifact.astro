    </g>

    <path class="control-artifact__datum" pathLength="1" d="M34 334H126V106H280V220H526" />

    {variant === 'stack' && (
      <g class="artifact-stack">
        <path class="plane plane--4" d="m116 115 164-68 164 68-164 68z" />
        <path class="plane plane--3" d="m116 177 164-68 164 68-164 68z" />
        <path class="plane plane--2" d="m116 239 164-68 164 68-164 68z" />
