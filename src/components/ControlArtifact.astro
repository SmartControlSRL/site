          <path class="slab-detail" d="M257 133h52m-52 18h34m-34 136h52m-52 18h34m151-167h72m-72 20h48m-48 118h72m-72 20h48" />
        </g>
        <circle class="node" cx="252" cy="215" r="7" />
        <circle class="node node--hot" cx="330" cy="215" r="8" />
        <circle class="node" cx="402" cy="220" r="7" />
      </g>
    )}

    {variant === 'security' && (
      <g class="artifact-security">
        <rect class="perimeter perimeter--outer" x="66" y="58" width="428" height="324" rx="28" />
        <rect class="perimeter perimeter--middle" x="116" y="96" width="328" height="248" rx="22" />
