    {variant === 'atlas' && (
      <g class="artifact-atlas">
        <path class="route" d="M280 220 154 123M280 220l126-97M280 220 154 317M280 220l126 97" />
        <rect class="slab slab--1" x="78" y="76" width="152" height="92" rx="10" />
        <rect class="slab slab--2" x="330" y="76" width="152" height="92" rx="10" />
        <rect class="slab slab--3" x="78" y="272" width="152" height="92" rx="10" />
        <rect class="slab slab--4" x="330" y="272" width="152" height="92" rx="10" />
        <path class="slab-detail" d="M98 106h72m-72 20h105m147-20h72m-72 20h105M98 302h72m-72 20h105m147-20h72m-72 20h105" />
        <rect class="core" x="238" y="178" width="84" height="84" rx="12" />
        <circle class="node node--hot" cx="280" cy="220" r="8" />
      </g>
    )}

    {variant === 'cloud' && (
      <g class="artifact-cloud">
        <g class="artifact-cloud__legacy">
          <rect class="slab" x="54" y="112" width="128" height="206" rx="10" />
