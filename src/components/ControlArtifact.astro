        <path class="core" d="m280 166 66 38v76l-66 38-66-38v-76z" />
        <circle class="node node--hot" cx="280" cy="242" r="12" />
        <circle class="node" cx="116" cy="142" r="7" />
        <circle class="node" cx="444" cy="142" r="7" />
        <circle class="node" cx="116" cy="298" r="7" />
        <circle class="node" cx="444" cy="298" r="7" />
      </g>
    )}

    {variant === 'software' && (
      <g class="artifact-software">
        <path class="route route--strong" pathLength="1" d="M54 220h452" />
        <g class="artifact-software__nodes">
          <rect class="slab slab--1" x="54" y="156" width="80" height="128" rx="10" />
          <rect class="slab slab--2" x="150" y="176" width="72" height="88" rx="10" />
          <rect class="slab slab--3" x="238" y="140" width="84" height="160" rx="10" />
          <rect class="slab slab--4" x="338" y="176" width="72" height="88" rx="10" />
          <rect class="slab slab--5" x="426" y="156" width="80" height="128" rx="10" />
        </g>
        <path class="slab-detail" d="M75 185h38m-38 22h38m-38 22h24m72-26h30m-30 22h30m58-52h42m-42 24h42m-42 24h42m-42 24h26m75-42h30m-30 22h30m58-44h38m-38 22h38m-38 22h24" />
        <circle class="node" cx="134" cy="220" r="6" />
        <circle class="node" cx="222" cy="220" r="6" />
        <circle class="node node--hot" cx="322" cy="220" r="7" />
        <circle class="node" cx="410" cy="220" r="6" />
      </g>
    )}

    {variant === 'managed' && (
      <g class="artifact-managed">
        <rect class="envelope" x="58" y="64" width="444" height="312" rx="24" />
        <path class="route route--strong" d="M100 106v228h360V106" />
        <path class="lane lane--1" d="M100 116h360" />
        <path class="lane lane--2" d="M100 151h360" />
        <path class="lane lane--3" d="M100 186h360" />
        <path class="lane lane--4" d="M100 221h360" />
        <path class="lane lane--5" d="M100 256h360" />
        <path class="lane lane--6" d="M100 291h360" />
        <path class="lane lane--7" d="M100 326h360" />
        <circle class="node node--hot" cx="100" cy="116" r="7" />
        <circle class="node" cx="460" cy="151" r="6" />
        <circle class="node" cx="100" cy="186" r="6" />
        <circle class="node" cx="460" cy="221" r="6" />
        <circle class="node" cx="100" cy="256" r="6" />
        <circle class="node" cx="460" cy="291" r="6" />
        <circle class="node" cx="100" cy="326" r="6" />
        <rect class="core" x="234" y="188" width="92" height="64" rx="10" />
      </g>
    )}

    {variant === 'solutions' && (
      <g class="artifact-solutions">
        <rect class="bay bay--signals" x="48" y="74" width="218" height="292" rx="16" />
        <rect class="bay bay--corridor" x="294" y="74" width="218" height="292" rx="16" />
        <path class="route" d="M70 130h56l42 48h64M70 220h162M70 310h56l42-48h64" />
        <circle class="node" cx="70" cy="130" r="6" />
        <circle class="node" cx="70" cy="220" r="6" />
        <circle class="node" cx="70" cy="310" r="6" />
        <rect class="core" x="198" y="174" width="46" height="92" rx="8" />
        <path class="corridor" d="M326 155h154v130H326zM350 177h106v86H350z" />
        <path class="route route--strong" d="M310 220h186" />
        <circle class="node node--hot" cx="326" cy="220" r="7" />
        <circle class="node" cx="480" cy="220" r="7" />
        <path class="artifact-solutions__join" d="M266 220h28" />
      </g>
    )}

    {variant === 'seknet' && (
      <g class="artifact-seknet">
        <path class="route" d="M50 92h92l92 92M50 174h116l68 32M50 266h116l68-32M50 348h92l92-92" />
        <path class="route" d="M510 92h-92l-92 92M510 174H394l-68 32M510 266H394l-68-32M510 348h-92l-92-92" />
        <circle class="node" cx="50" cy="92" r="6" />
        <circle class="node" cx="50" cy="174" r="6" />
        <circle class="node" cx="50" cy="266" r="6" />
        <circle class="node" cx="50" cy="348" r="6" />
        <circle class="node" cx="510" cy="92" r="6" />
        <circle class="node" cx="510" cy="174" r="6" />
        <circle class="node" cx="510" cy="266" r="6" />
        <circle class="node" cx="510" cy="348" r="6" />
        <rect class="core" x="220" y="152" width="120" height="136" rx="14" />
        <rect class="core core--inner" x="242" y="174" width="76" height="92" rx="9" />
        <circle class="node node--hot" cx="280" cy="220" r="10" />
      </g>
