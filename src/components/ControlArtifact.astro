    {variant === 'svpn' && (
      <g class="artifact-svpn">
        <path class="corridor corridor--outer" d="M112 116h336l62 104-62 104H112L50 220z" />
        <path class="corridor corridor--inner" d="M148 150h264l42 70-42 70H148l-42-70z" />
        <path class="route route--strong" pathLength="1" d="M50 220h460" />
        <path class="route" d="M112 116v208M448 116v208M148 150v140M412 150v140" />
        <circle class="node node--hot" cx="50" cy="220" r="9" />
        <circle class="node" cx="112" cy="220" r="7" />
        <circle class="node" cx="148" cy="220" r="7" />
        <circle class="node" cx="412" cy="220" r="7" />
        <circle class="node" cx="448" cy="220" r="7" />
        <circle class="node node--hot" cx="510" cy="220" r="9" />
        <rect class="core" x="244" y="180" width="72" height="80" rx="10" />
      </g>
    )}

    {variant === 'missing' && (
      <g class="artifact-missing">
        <path class="route route--strong" d="M58 220h142l44-44" />
        <path class="route route--strong route--broken" d="m316 264 44-44h142" />
        <circle class="node" cx="58" cy="220" r="8" />
        <circle class="node" cx="200" cy="220" r="7" />
        <circle class="node" cx="360" cy="220" r="7" />
        <circle class="node" cx="502" cy="220" r="8" />
        <path class="missing-bracket" d="M230 138h-28v164h28M330 138h28v164h-28" />
        <path class="missing-cross" d="m254 194 52 52m0-52-52 52" />
      </g>
    )}
  </svg>
</div>

<style>
  .control-artifact {
    width: 100%;
    color: var(--color-navy);
    --artifact-line: color-mix(in srgb, var(--color-royal) 42%, transparent);
    --artifact-faint: color-mix(in srgb, var(--color-royal) 15%, transparent);
    --artifact-surface: color-mix(in srgb, var(--color-surface) 92%, var(--color-blue-wash));
    --artifact-hot: var(--color-bright);
  }
  .control-artifact--dark {
    color: var(--color-sky);
    --artifact-line: color-mix(in srgb, var(--color-sky) 54%, transparent);
    --artifact-faint: color-mix(in srgb, var(--color-sky) 16%, transparent);
    --artifact-surface: color-mix(in srgb, var(--color-royal) 34%, transparent);
    --artifact-hot: var(--color-sky);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .control-artifact__blueprint {
    stroke: var(--artifact-faint);
    stroke-width: 1;
  }
  .control-artifact__datum,
  .route {
    stroke: var(--artifact-line);
    stroke-width: 1.5;
  }
  .control-artifact__datum,
  .route--strong {
    stroke: var(--artifact-hot);
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--scene-progress, 1));
  }
  .control-artifact__datum {
    opacity: 0.34;
  }
  .plane,
  .slab,
  .perimeter,
  .envelope,
  .bay,
  .corridor,
  .core {
    stroke: var(--artifact-line);
    stroke-width: 1.5;
    fill: var(--artifact-surface);
  }
  .plane {
    transform-box: fill-box;
    transform-origin: center;
  }
  .plane--4 { transform: translateY(calc(-12px * var(--scene-progress, 1))); }
  .plane--3 { transform: translateY(calc(-4px * var(--scene-progress, 1))); }
  .plane--2 { transform: translateY(calc(4px * var(--scene-progress, 1))); }
  .plane--1 { transform: translateY(calc(12px * var(--scene-progress, 1))); }
  .artifact-stack__routes,
  .artifact-stack__spine,
  .slab-detail,
  .lane,
  .artifact-solutions__join,
  .missing-bracket,
  .missing-cross {
    stroke: var(--artifact-line);
    stroke-width: 1.4;
  }
  .slab-detail { opacity: 0.6; }
  .node {
    fill: var(--artifact-surface);
    stroke: var(--artifact-line);
    stroke-width: 1.5;
  }
  .node--hot {
    fill: var(--artifact-hot);
    stroke: color-mix(in srgb, var(--artifact-hot) 60%, var(--color-surface));
  }
  .core {
    stroke: var(--artifact-hot);
    fill: color-mix(in srgb, var(--artifact-hot) 10%, var(--artifact-surface));
  }
  .core--inner { fill: transparent; }
  .perimeter--outer { opacity: 0.45; }
  .perimeter--middle { opacity: 0.68; }
  .perimeter--inner { opacity: 0.9; }
  .lane {
    transform-box: fill-box;
    transform-origin: left;
    transform: scaleX(calc(0.7 + var(--scene-progress, 1) * 0.3));
  }
  .artifact-managed .lane:nth-of-type(even) { transform-origin: right; }
  .route--broken { stroke-dasharray: 7 12; }
  .missing-cross { stroke: var(--artifact-hot); stroke-width: 2; }
  .control-artifact--compact svg { max-height: 300px; }

  @media (prefers-reduced-motion: no-preference) {
    .plane,
    .slab,
    .core,
    .node,
    .lane {
      transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1), opacity 420ms ease;
    }
  }
</style>
