---
// Networking & Security hero scene (see docs/design-proposals/
// service-hero-scenes): layered defence around a protected core. One SVG for
// every width; on phones it bleeds to the screen edges and engraves larger
// labels without the number prefix. src/scripts/scenes/security.ts plays the
// story. Decorative: the page copy carries the meaning, so it is aria-hidden.
import { securityMarkup } from "./security-scene";
import { getLangFromUrl } from "../../i18n/ui";
import "../../styles/scenes.css";

const lang = getLangFromUrl(Astro.url) === "en" ? "en" : "ro";
const html = securityMarkup(lang);
---

<div
  class="service-scene security-scene"
  data-scene="security"
  aria-hidden="true"
>
  <div class="ambient"></div>
  <div class="scene-svg-wrap" set:html={html} />
</div>

<style is:global>
  .security-scene .scene-svg-wrap {
    position: relative;
  }
  .security-scene .scene-svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .service-scene.security-scene .ambient {
    inset: -4% -8%;
    background: radial-gradient(
      46% 44% at 52% 50%,
      color-mix(in srgb, var(--color-sky) 34%, transparent),
      transparent 72%
    );
  }
  .security-scene .stop-bright {
    stop-color: var(--color-bright);
  }
  .security-scene .stop-sky {
    stop-color: var(--color-sky);
  }
  .security-scene .stop-wash {
    stop-color: var(--color-blue-wash);
  }
  .security-scene .stop-surface {
    stop-color: var(--color-surface);
  }
  .security-scene .stop-border {
    stop-color: var(--color-border-blue);
  }
  .security-scene .ground {
    fill: var(--color-navy);
    fill-opacity: 0.2;
    transform-box: fill-box;
    transform-origin: center;
  }
  .security-scene .frost {
    fill: var(--color-surface);
    fill-opacity: 0.55;
  }
  .security-scene .cast {
    fill: var(--color-navy);
    fill-opacity: 0.05;
    stroke: none;
  }
  .service-scene.security-scene .i {
    stroke-opacity: 0.62;
  }
  .security-scene .d {
    stroke: var(--color-navy);
    stroke-opacity: 0.42;
  }
  .service-scene.security-scene .if {
    fill-opacity: 0.55;
  }
  .security-scene .face * {
    vector-effect: non-scaling-stroke;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .security-scene .face .rim-hi,
  .security-scene .face .badge-on,
  .security-scene .face .sweep line {
    stroke-width: 1.8;
  }
  .security-scene .wedge {
    fill: var(--color-bright);
    stroke: none;
  }
  .security-scene .sweep {
    transform-origin: 0 0;
  }
  .security-scene .sweep line {
    stroke: var(--color-bright);
  }
  .security-scene text.lbl {
    font-size: 10.2px;
    letter-spacing: 1.2px;
    stroke: none;
  }
  .security-scene .core * {
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .security-scene .core-lines > * {
    stroke-width: 1.5;
  }
  .security-scene .core-lines .tier {
    stroke-width: 1.3;
  }
  .security-scene .core .shield {
    stroke-width: 1.6;
  }
  .security-scene .core-shadow {
    fill: var(--color-navy);
    fill-opacity: 0.14;
  }
  .security-scene .core-top {
    fill: var(--color-surface);
  }
  .security-scene .core-glow {
    fill: var(--color-bright);
    opacity: 0;
  }
  .security-scene .pk-dot {
    fill: var(--color-surface);
    stroke: var(--color-bright);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .security-scene .threat .ring {
    fill: var(--color-page);
    fill-opacity: 0.45;
    stroke: var(--color-navy);
    stroke-width: 1.6;
    stroke-dasharray: 4 4;
    vector-effect: non-scaling-stroke;
  }
  .security-scene .threat .dot {
    stroke: var(--color-navy);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }
  .security-scene .threat .ring,
  .security-scene .threat .dot {
    transform-box: fill-box;
    transform-origin: center;
  }
  .security-scene .wall line {
    stroke-width: 4;
    vector-effect: non-scaling-stroke;
  }
  .security-scene .blocked circle,
  .security-scene .blocked line {
    stroke: var(--color-bright);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  /* Final (settled) state: transient beats are hidden. */
  .security-scene .rim-hi,
  .security-scene .badge-on,
  .security-scene .sweep,
  .security-scene .wall,
  .security-scene .pk,
  .security-scene .threat,
  .security-scene .blocked {
    opacity: 0;
  }
  @media (max-width: 600px) {
    /* Edge to edge on phones so the engraved labels stay ≥10px. */
    .detail-hero .service-scene.security-scene {
      width: 100vw;
      max-width: none;
      margin-inline: calc(50% - 50vw);
    }
    .security-scene text.lbl {
      font-size: 16.5px;
      letter-spacing: 0.3px;
      transform: translateX(15px);
    }
    .security-scene text.lbl .code,
    .security-scene text.lbl .sp {
      display: none;
    }
    .security-scene .sz {
      transform: scale(1.5);
    }
  }
</style>
<script>
  import "../../scripts/scenes/security";
</script>
