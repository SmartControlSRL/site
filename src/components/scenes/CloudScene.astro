---
// Infrastructure & Cloud hero scene (see docs/design-proposals/
// service-hero-scenes). The markup is the composed final state, rendered
// once per layout (desktop composition, single-column mobile composition);
// src/scripts/scenes/cloud.ts plays the story on whichever is visible.
// Decorative: the page copy carries the meaning, so the scene is aria-hidden.
import { cloudLayout, cloudMarkup } from "./cloud-scene";
import { getLangFromUrl } from "../../i18n/ui";
import "../../styles/scenes.css";

const lang = getLangFromUrl(Astro.url) === "en" ? "en" : "ro";
const layouts = (["desktop", "mobile"] as const).map((kind) => {
  const layout = cloudLayout(kind);
  return { kind, box: layout.box, html: cloudMarkup(layout, lang) };
});
---

<div class="service-scene cloud-scene" data-scene="cloud" aria-hidden="true">
  {
    layouts.map(({ kind, box, html }) => (
      <div
        class="scene-layout"
        data-scene-layout={kind}
        style={`--box-w:${box[0]};--box-h:${box[1]}`}
      >
        <div class="scene-fit">
          <div class="scene-box" set:html={html} />
        </div>
      </div>
    ))
  }
</div>

<style is:global>
  .cloud-scene .scene-layout[data-scene-layout="desktop"] {
    --s-max: 1.06;
  }
  .cloud-scene .scene-layout[data-scene-layout="mobile"] {
    --s-max: 0.8;
  }
  .cloud-scene .cam {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 40% 55%;
  }
  .cloud-scene .gshadow {
    position: absolute;
    border-radius: 50%;
    filter: blur(10px);
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-navy) 22%, transparent),
      transparent
    );
  }
  .cloud-scene .slab {
    position: absolute;
    transform-origin: 50% 47.6%;
  }
  .cloud-scene .slab > * {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cloud-scene .slab img {
    display: block;
    max-width: none;
  }
  .cloud-scene .frost,
  .cloud-scene .sheen {
    clip-path: polygon(49.4% 1.2%, 99% 47.6%, 50.6% 94.1%, 1% 47.6%);
  }
  .cloud-scene .frost {
    backdrop-filter: blur(3px);
    background: color-mix(in srgb, var(--color-surface) 28%, transparent);
  }
  .cloud-scene .sheen {
    overflow: hidden;
    mix-blend-mode: screen;
  }
  .cloud-scene .sheen::before {
    content: "";
    position: absolute;
    inset-block: -20%;
    left: -40%;
    width: 34%;
    background: linear-gradient(
      100deg,
      transparent,
      color-mix(in srgb, var(--color-surface) 85%, transparent) 50%,
      transparent
    );
    transform: skewX(-18deg);
  }
  .cloud-scene .glow {
    opacity: 0;
    filter: blur(16px);
  }
  .cloud-scene .glow span,
  .cloud-scene .ring {
    position: absolute;
    inset: 0;
    mask: url("/images/hero-stack-slab-640.webp") center / 100% 100% no-repeat;
  }
  .cloud-scene .glow span {
    background: color-mix(in srgb, var(--color-bright) 85%, transparent);
  }
  .cloud-scene .ring {
    opacity: 0;
    background: var(--color-bright);
    filter: blur(3px);
    mix-blend-mode: screen;
  }
  .cloud-scene .dr {
    opacity: 0.8;
  }
  .cloud-scene [data-slab="floor"] .art {
    opacity: 0.5;
  }
  .cloud-scene .art * {
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.35;
  }
  .cloud-scene .small .art * {
    stroke-width: 1.1;
  }
  .cloud-scene .tag text {
    letter-spacing: 1.6px;
  }
  .cloud-scene [data-scene-layout="desktop"] .tag text {
    font-size: var(--fs-full);
  }
  .cloud-scene [data-scene-layout="mobile"] .tag text {
    letter-spacing: 1px;
  }
  /* Below 1440px the desktop composition is scaled down: drop the number
     prefix and engrave the bare name larger so it stays ≥10px. */
  @media (max-width: 1439px) {
    .cloud-scene [data-scene-layout="desktop"] .tag text {
      font-size: var(--fs-short);
      letter-spacing: 1px;
    }
    .cloud-scene [data-scene-layout="desktop"] .tag .code,
    .cloud-scene [data-scene-layout="desktop"] .tag .sp {
      display: none;
    }
  }
  /* Final (settled) state; the intro animates from earlier states. */
  .cloud-scene .tower,
  .cloud-scene .fp-s,
  .cloud-scene .mover,
  .cloud-scene .pulse,
  .cloud-scene .vm.moved,
  .cloud-scene [data-slab="cloud"] .ph {
    opacity: 0;
  }
  .cloud-scene .overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 40;
  }
  .cloud-scene .link-glow {
    stroke: var(--color-sky);
    stroke-opacity: 0.45;
    stroke-width: 5;
    filter: blur(2px);
  }
  .cloud-scene .link {
    stroke: var(--color-bright);
    stroke-width: 1.6;
  }
  .cloud-scene .sync {
    stroke: var(--color-royal);
    stroke-opacity: 0.6;
    stroke-width: 1.3;
    stroke-dasharray: 4 5;
  }
  .cloud-scene .sync-mask {
    fill: none;
    stroke: var(--color-surface);
    stroke-width: 6;
  }
  .cloud-scene .port {
    fill: var(--color-surface);
    stroke: var(--color-bright);
    stroke-width: 1.4;
  }
  .cloud-scene .port.dr-port {
    stroke: var(--color-royal);
    stroke-opacity: 0.7;
  }
  .cloud-scene .mover,
  .cloud-scene .pulse {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    z-index: 45;
    offset-rotate: 0deg;
    offset-anchor: 0 0;
  }
  .cloud-scene .mover svg {
    position: absolute;
    left: 0;
    top: 0;
    filter: drop-shadow(
      0 0 6px color-mix(in srgb, var(--color-bright) 55%, transparent)
    );
  }
  .cloud-scene .mover polygon {
    fill: color-mix(in srgb, var(--color-bright) 22%, transparent);
    stroke: var(--color-bright);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .cloud-scene .mover line {
    stroke: var(--color-bright);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .cloud-scene .pulse::before {
    content: "";
    position: absolute;
    left: -6px;
    top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      var(--color-surface) 0 25%,
      color-mix(in srgb, var(--color-sky) 95%, transparent) 45%,
      transparent 70%
    );
    box-shadow: 0 0 16px 3px
      color-mix(in srgb, var(--color-bright) 50%, transparent);
  }
  .cloud-scene .pulse.small::before {
    left: -4px;
    top: -4px;
    width: 8px;
    height: 8px;
    box-shadow: 0 0 10px 2px
      color-mix(in srgb, var(--color-royal) 35%, transparent);
  }
</style>
<script>
  import "../../scripts/scenes/cloud";
</script>
