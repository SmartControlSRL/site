---
// Animated, deliberately generic product visual. It exposes no specifications.
interface LogLine { time: string; msg: string; blocked?: boolean; }
interface Metric { label: string; value: string; accent?: boolean; }
interface Props { title: string; metrics: Metric[]; log: LogLine[]; class?: string; }
const { title, metrics, log, class: extra = '' } = Astro.props;
---
<div data-console class:list={['overflow-hidden rounded-xl border border-[rgba(122,180,232,0.16)] bg-console [box-shadow:0_40px_90px_-40px_rgba(4,12,43,0.85)]', extra]}>
  <div class="flex items-center justify-between border-b border-[rgba(122,180,232,0.12)] bg-[rgba(255,255,255,0.02)] px-[18px] py-3">
    <div class="flex items-center gap-2 font-mono text-[11.5px] tracking-[1.5px] text-[rgba(226,233,245,0.6)]"><span class="h-[7px] w-[7px] rounded-full bg-bright [animation:scBlink_1.8s_ease-in-out_infinite]" aria-hidden="true"></span>{title}</div>
    <div class="flex gap-1.5" aria-hidden="true">{[1,2,3].map(() => <span class="h-[9px] w-[9px] rounded-full bg-[rgba(122,180,232,0.25)]"></span>)}</div>
  </div>
  <div class="relative h-[240px]"><canvas data-console-canvas class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas></div>
  <div class="grid grid-cols-3 border-y border-[rgba(122,180,232,0.12)] font-mono">{metrics.map((m,i) => <div class:list={['px-4 py-3',i<2&&'border-r border-[rgba(122,180,232,0.12)]']}><div class="mb-1 text-[10px] uppercase tracking-[1px] text-[rgba(226,233,245,0.55)]">{m.label}</div><div class:list={['text-[15px] font-medium',m.accent?'text-bright':'text-white']}>{m.value}</div></div>)}</div>
  <ul data-console-log class="m-0 flex h-[132px] list-none flex-col gap-[5px] overflow-hidden p-[14px_16px] font-mono text-[11.5px] leading-[1.5]">{log.map(l => <li data-msg={l.msg} data-kind={l.blocked===false?'allow':'block'} class="flex items-center gap-2.5"><span class="text-sky">{l.time}</span><span style={`color:${l.blocked===false?'#7AB4E8':'#4487DC'}`}>{l.blocked===false?'▸':'■'}</span><span class="min-w-0 flex-1 truncate text-[rgba(226,233,245,0.72)]">{l.msg}</span></li>)}</ul>
</div>
