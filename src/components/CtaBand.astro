---
// Closing CTA band: dark midnight full-bleed section with a blueprint-grid
// texture, centered eyebrow + H2 + lead slot, and a single mailto button
// (NO email input — RESOLUTIONS §15) plus a mono contact line.
import SectionHeading from './SectionHeading.astro';
import GridTexture from './GridTexture.astro';
import MailtoLink from './MailtoLink.astro';
import { EMAIL_USER, EMAIL_DOMAIN } from '../i18n/ui';

interface Props {
  id?: string;
  eyebrow?: string;
  heading: string;
  /** mailto button label. */
  cta: string;
  /** Email subject appended to the mailto. */
  subject?: string;
  /** Render the mono contact line under the button (default true). */
  showContact?: boolean;
  class?: string;
}

const { id, eyebrow, heading, cta, subject, showContact = true, class: extra = '' } = Astro.props;
---

<section
  id={id}
  class:list={['relative overflow-hidden bg-midnight px-6 py-[72px] sm:px-10 sm:py-[110px]', extra]}
>
  <GridTexture dark opacity={0.7} />

  <div class="relative z-[1] mx-auto max-w-[760px] text-center">
    <div data-reveal>
      <SectionHeading eyebrow={eyebrow} heading={heading} variant="dark" size="cta" rule={false} center>
        <slot />
      </SectionHeading>

      <div class="mt-9 flex justify-center">
        <MailtoLink variant="button" dark subject={subject}>{cta}</MailtoLink>
      </div>

      {showContact && (
        <p class="mt-6 font-mono text-[13px] text-[rgba(226,233,245,0.55)]">
          <span data-email-user={EMAIL_USER} data-email-domain={EMAIL_DOMAIN}></span> · www.smartcontrol.ro
        </p>
      )}
    </div>
  </div>
</section>
