---
// Progressive-enhancement mail link. The static HTML is complete and usable;
// data attributes remain only so initEmails can repair legacy/injected markup.
import { EMAIL_USER, EMAIL_DOMAIN } from '../i18n/ui';

interface Props {
  /** Email subject, appended URL-encoded (e.g. "Evaluare gratuită"). */
  subject?: string;
  /** Visual treatment. button = filled CTA; link = inline text link. */
  variant?: 'button' | 'link' | 'plain';
  /** On a dark zone? Switches link/button colors to the dark palette. */
  dark?: boolean;
  /** Extra classes appended to the computed ones. */
  class?: string;
  user?: string;
  domain?: string;
}

const {
  subject,
  variant = 'link',
  dark = false,
  class: extra = '',
  user = EMAIL_USER,
  domain = EMAIL_DOMAIN,
} = Astro.props;

const address = `${user}@${domain}`;
const href = `mailto:${address}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`;
const hasLabel = Astro.slots.has('default');

const base =
  variant === 'button'
    ? 'inline-flex items-center justify-center rounded-md px-[22px] py-[11px] text-[14.5px] font-semibold transition-all'
    : variant === 'link'
      ? 'font-semibold transition-colors'
      : 'transition-colors';

// Buttons are flat — no glow. Dark zones get the confident white fill
// (navy ink on white, trivially AA on the midnight floor).
const tone =
  variant === 'button'
    ? dark
      ? 'bg-surface text-navy hover:bg-blue-wash'
      : 'bg-navy text-white hover:bg-midnight hover:[box-shadow:0_4px_16px_rgba(14,31,91,0.25)]'
    : dark
      ? 'text-sky hover:text-white'
      : 'text-royal hover:text-navy';
---

<a
  href={href}
  data-email-user={user}
  data-email-domain={domain}
  data-email-subject={subject}
  class:list={[base, tone, extra]}
>
  {hasLabel ? <slot /> : address}
</a>
