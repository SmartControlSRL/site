---
// StackTeardown — homepage "one partner, whole stack" section, ported from the
// "Design originality recommendations" Claude Design handoff and re-tokened to
// brand: bright #4487DC replaces the prototype's #2D5BFF accent, status-green
// dots become sky (green is product-UI only), IBM Plex/Space Grotesk become the
// site's Inter + JetBrains Mono, greys become warm-blue washes with navy-tinted
// shadows, and body-size links render royal (AA). Four exploded isometric
// plates (L4→L1) mirror four native disclosure controls. The visual plates
// stay decorative; an ambient auto-cycle can be paused and stops after the
// visitor picks a layer (disabled under prefers-reduced-motion). Copy comes in
// via props so RO / EN pages stay at full parity.
import SectionHeading from './SectionHeading.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Layer {
  /** mono level code, top of stack first (L4 … L1) */
  code: string;
  name: string;
  desc: string;
  chips: string[];
  href: string;
  linkLabel: string;
  /** Legacy accessible label retained in page data; visible button copy is canonical. */
  aria: string;
}

interface Props {
  eyebrow: string;
  /** Plain text (word-fill) — see SectionHeading. */
  heading: string;
  /** Exactly 4 layers, rendered top (L4) → bottom (L1). */
  layers: Layer[];
  note: string;
  cyclePauseLabel?: string;
  cycleResumeLabel?: string;
  id?: string;
  class?: string;
}

const t = useTranslations(getLangFromUrl(Astro.url));

const {
  eyebrow,
  heading,
  layers,
  note,
  cyclePauseLabel = t('sctd.cycle.pause'),
  cycleResumeLabel = t('sctd.cycle.resume'),
  id = 'stack',
  class: extra = '',
} = Astro.props;

// Vertical anchor (px) of each plate/callout pair inside the 565px visual.
const TOPS = [118, 202, 286, 370];
---

<section
  id={id}
  data-sctd
  class:list={['bg-page px-6 py-[56px] sm:py-[80px] md:px-10', extra]}
>
  <div class="mx-auto max-w-[1180px]">
    {/* Head split — heading left, context right (mirrors the Cloud teaser) */}
    <div data-reveal class="grid grid-cols-1 items-end gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">
      <SectionHeading eyebrow={eyebrow} heading={heading} headingMaxWidth="560px" />
      <p class="text-[16px] leading-[1.6] text-cool">
        <slot />
      </p>
    </div>

    <div data-reveal data-reveal-delay="100" class="sctd-grid mt-10">
      {/* ══ Exploded isometric stack ══ */}
      <div class="sctd-visual">
        <div class="sctd-spine" aria-hidden="true"></div>

        {
          layers.map((layer, i) => (
            <div
              class:list={['sctd-callout', { 'is-active': i === 0 }]}
              data-layer={i}
              style={`--top:${TOPS[i]}px`}
              aria-hidden="true"
            >
              <span class="sctd-code">{layer.code}</span>
              <span class="sctd-dash" />
            </div>
          ))
        }

        {/* L4 · applications & automation — app windows + CI/CD pipeline */}
        <div
          class="sctd-plate is-active"
          data-layer="0"
          style={`--top:${TOPS[0]}px;z-index:10`}
          aria-hidden="true"
        >
          <span class="sctd-inner"></span>
          <svg viewBox="0 0 280 280" fill="none" aria-hidden="true">
            <rect class="sctd-i" x="48" y="50" width="112" height="86" rx="8" stroke-width="1.5"></rect>
            <line class="sctd-i" x1="48" y1="72" x2="160" y2="72" stroke-width="1.5"></line>
            <circle class="sctd-hf" cx="58" cy="61" r="2.5"></circle>
            <circle class="sctd-if" cx="67" cy="61" r="2.5"></circle>
            <line class="sctd-i" x1="60" y1="88" x2="130" y2="88" stroke-width="1.5"></line>
            <line class="sctd-h" x1="60" y1="102" x2="112" y2="102" stroke-width="1.5"></line>
            <line class="sctd-i" x1="60" y1="116" x2="122" y2="116" stroke-width="1.5"></line>
            <rect class="sctd-i" x="178" y="64" width="54" height="44" rx="6" stroke-width="1.5"></rect>
            <line class="sctd-i" x1="188" y1="80" x2="222" y2="80" stroke-width="1.5"></line>
            <line class="sctd-i" x1="188" y1="92" x2="212" y2="92" stroke-width="1.5"></line>
            <line class="sctd-h" x1="160" y1="86" x2="178" y2="86" stroke-width="1.5" stroke-dasharray="3 3"></line>
            <line class="sctd-i" x1="68" y1="196" x2="212" y2="196" stroke-width="1.5" stroke-dasharray="3 4"></line>
            <rect class="sctd-i" x="56" y="184" width="24" height="24" rx="5" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="128" y="184" width="24" height="24" rx="5" stroke-width="1.5"></rect>
            <rect class="sctd-h" x="200" y="184" width="24" height="24" rx="5" stroke-width="1.5"></rect>
            <circle class="sctd-hf" cx="212" cy="196" r="4"></circle>
          </svg>
        </div>

        {/* L3 · platforms & data — container grid + cluster + volumes */}
        <div
          class="sctd-plate"
          data-layer="1"
          style={`--top:${TOPS[1]}px;z-index:9`}
          aria-hidden="true"
        >
          <span class="sctd-inner"></span>
          <svg viewBox="0 0 280 280" fill="none" aria-hidden="true">
            <rect class="sctd-i" x="50" y="52" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="82" y="52" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-h sctd-hf" x="114" y="52" width="22" height="22" rx="4" fill-opacity=".16" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="146" y="52" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="50" y="84" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="82" y="84" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="114" y="84" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="146" y="84" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="50" y="116" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-h sctd-hf" x="82" y="116" width="22" height="22" rx="4" fill-opacity=".16" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="114" y="116" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="146" y="116" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <circle class="sctd-i" cx="215" cy="84" r="26" stroke-width="1.5"></circle>
            <circle class="sctd-hf" cx="215" cy="84" r="5"></circle>
            <circle class="sctd-i" cx="215" cy="58" r="4" stroke-width="1.5"></circle>
