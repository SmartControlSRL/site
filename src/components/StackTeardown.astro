---
// StackTeardown — homepage "one partner, whole stack" section, ported from the
// "Design originality recommendations" Claude Design handoff and re-tokened to
// brand: bright #4487DC replaces the prototype's #2D5BFF accent, status-green
// dots become sky (green is product-UI only), IBM Plex/Space Grotesk become the
// site's Inter + JetBrains Mono, greys become warm-blue washes with navy-tinted
// shadows, and body-size links render royal (AA). Four exploded isometric
// plates (L4→L1) share one progressively enhanced semantic layer list: a
// deterministic sticky chapter at desktop and a compact accordion below it.
// Copy comes in via props so RO / EN pages stay at full parity.
import SectionHeading from './SectionHeading.astro';
import GridTexture from './GridTexture.astro';

interface Layer {
  /** mono level code, top of stack first (L4 … L1) */
  code: string;
  name: string;
  desc: string;
  chips: string[];
  href: string;
  linkLabel: string;
  /** aria-label for the clickable plate */
  aria: string;
}

interface Props {
  eyebrow: string;
  /** Plain text (word-fill) — see SectionHeading. */
  heading: string;
  /** Exactly 4 layers, rendered top (L4) → bottom (L1). */
  layers: Layer[];
  note: string;
  id?: string;
  class?: string;
}

const {
  eyebrow,
  heading,
  layers,
  note,
  id = 'stack',
  class: extra = '',
} = Astro.props;

// Vertical anchor (px) of each plate/callout pair inside the shared stack view.
const TOPS = [118, 202, 286, 370];
---

<section
  id={id}
  data-sctd
  class:list={['sctd bg-page', extra]}
>
  <div class="sctd-scroll">
    <div class="sctd-stage" data-sctd-stage>
      {/* 00-stage-bg + 10-blueprint-ruling */}
      <GridTexture class="sctd-blueprint" />

      {/* 20-datum-and-routing — decorative geometry shares the stage frame. */}
      <svg
        class="sctd-routing"
        viewBox="0 0 1180 640"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path data-sctd-route pathLength="1" d="M78 520H286V122H584V304H1084" />
        <path data-sctd-route pathLength="1" d="M132 574H412V470H742V164H1118" />
        <line x1="584" y1="82" x2="584" y2="564" />
        <g class="sctd-ticks">
          <path d="M72 112h18M81 103v18M1090 514h18M1099 505v18" />
          <path d="M196 80v12M384 80v12M772 548v12M960 548v12" />
        </g>
      </svg>

      <div class="sctd-frame">
        {/* 40/41 foreground framing — public copy remains server rendered. */}
        <div class="sctd-intro" data-sctd-intro>
          <SectionHeading eyebrow={eyebrow} heading={heading} headingMaxWidth="560px" />
          <p class="sctd-lead">
            <slot />
          </p>
        </div>

        <div class="sctd-grid">
      {/* ══ Exploded isometric stack ══ */}
      <div class="sctd-visual">
        <div class="sctd-spine" aria-hidden="true"></div>

        {
          layers.map((layer, i) => (
            <div class="sctd-callout" data-layer={i} style={`--top:${TOPS[i]}px`} aria-hidden="true">
              <span class="sctd-code">{layer.code}</span>
              <span class="sctd-dash" />
            </div>
          ))
        }

        {/* L4 · applications & automation — app windows + CI/CD pipeline */}
        <button
          type="button"
          class="sctd-plate"
          disabled
          data-layer="0"
          data-sctd-select
          style={`--top:${TOPS[0]}px;z-index:10`}
          aria-expanded="false"
          aria-label={layers[0].aria}
        >
          <span class="sctd-inner"></span>
          <svg viewBox="0 0 280 280" fill="none" aria-hidden="true">
            <rect class="sctd-i" x="48" y="50" width="112" height="86" rx="8" stroke-width="1.5"></rect>
            <line class="sctd-i" x1="48" y1="72" x2="160" y2="72" stroke-width="1.5"></line>
            <circle class="sctd-hf" cx="58" cy="61" r="2.5"></circle>
            <circle class="sctd-if" cx="67" cy="61" r="2.5"></circle>
            <line class="sctd-i" x1="60" y1="88" x2="130" y2="88" stroke-width="1.5"></line>
            <line class="sctd-h" x1="60" y1="102" x2="112" y2="102" stroke-width="1.5"></line>
            <line class="sctd-i" x1="60" y1="116" x2="122" y2="116" stroke-width="1.5"></line>
            <rect class="sctd-i" x="178" y="64" width="54" height="44" rx="6" stroke-width="1.5"></rect>
            <line class="sctd-i" x1="188" y1="80" x2="222" y2="80" stroke-width="1.5"></line>
            <line class="sctd-i" x1="188" y1="92" x2="212" y2="92" stroke-width="1.5"></line>
            <line class="sctd-h" x1="160" y1="86" x2="178" y2="86" stroke-width="1.5" stroke-dasharray="3 3"></line>
            <line class="sctd-i" x1="68" y1="196" x2="212" y2="196" stroke-width="1.5" stroke-dasharray="3 4"></line>
            <rect class="sctd-i" x="56" y="184" width="24" height="24" rx="5" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="128" y="184" width="24" height="24" rx="5" stroke-width="1.5"></rect>
            <rect class="sctd-h" x="200" y="184" width="24" height="24" rx="5" stroke-width="1.5"></rect>
            <circle class="sctd-hf" cx="212" cy="196" r="4"></circle>
          </svg>
        </button>

        {/* L3 · platforms & data — container grid + cluster + volumes */}
        <button
          type="button"
          class="sctd-plate"
          disabled
          data-layer="1"
          data-sctd-select
          style={`--top:${TOPS[1]}px;z-index:9`}
          aria-expanded="false"
          aria-label={layers[1].aria}
        >
          <span class="sctd-inner"></span>
          <svg viewBox="0 0 280 280" fill="none" aria-hidden="true">
            <rect class="sctd-i" x="50" y="52" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="82" y="52" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-h sctd-hf" x="114" y="52" width="22" height="22" rx="4" fill-opacity=".16" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="146" y="52" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="50" y="84" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="82" y="84" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="114" y="84" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="146" y="84" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="50" y="116" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-h sctd-hf" x="82" y="116" width="22" height="22" rx="4" fill-opacity=".16" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="114" y="116" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="146" y="116" width="22" height="22" rx="4" stroke-width="1.5"></rect>
            <circle class="sctd-i" cx="215" cy="84" r="26" stroke-width="1.5"></circle>
            <circle class="sctd-hf" cx="215" cy="84" r="5"></circle>
            <circle class="sctd-i" cx="215" cy="58" r="4" stroke-width="1.5"></circle>
            <circle class="sctd-i" cx="237" cy="97" r="4" stroke-width="1.5"></circle>
            <circle class="sctd-i" cx="193" cy="97" r="4" stroke-width="1.5"></circle>
            <line class="sctd-i" x1="215" y1="63" x2="215" y2="79" stroke-width="1.3"></line>
            <line class="sctd-i" x1="233" y1="95" x2="220" y2="87" stroke-width="1.3"></line>
            <line class="sctd-i" x1="197" y1="95" x2="210" y2="87" stroke-width="1.3"></line>
            <rect class="sctd-i" x="50" y="170" width="120" height="16" rx="5" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="50" y="194" width="120" height="16" rx="5" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="50" y="218" width="120" height="16" rx="5" stroke-width="1.5"></rect>
            <circle class="sctd-hf" cx="158" cy="178" r="3"></circle>
            <circle class="sctd-if" cx="158" cy="202" r="3"></circle>
            <circle class="sctd-if" cx="158" cy="226" r="3"></circle>
            <line class="sctd-i" x1="215" y1="114" x2="215" y2="200" stroke-width="1.3" stroke-dasharray="3 4"></line>
            <line class="sctd-i" x1="174" y1="202" x2="211" y2="202" stroke-width="1.3" stroke-dasharray="3 4"></line>
          </svg>
        </button>

        {/* L2 · network & connectivity — mesh topology */}
        <button
          type="button"
          class="sctd-plate"
          disabled
          data-layer="2"
          data-sctd-select
          style={`--top:${TOPS[2]}px;z-index:8`}
          aria-expanded="false"
          aria-label={layers[2].aria}
        >
          <span class="sctd-inner"></span>
          <svg viewBox="0 0 280 280" fill="none" aria-hidden="true">
            <line class="sctd-i" x1="225" y1="140" x2="183" y2="214" stroke-width="1.3" stroke-dasharray="3 4" opacity=".6"></line>
            <line class="sctd-i" x1="183" y1="214" x2="98" y2="214" stroke-width="1.3" stroke-dasharray="3 4" opacity=".6"></line>
            <line class="sctd-i" x1="98" y1="214" x2="55" y2="140" stroke-width="1.3" stroke-dasharray="3 4" opacity=".6"></line>
            <line class="sctd-i" x1="55" y1="140" x2="98" y2="66" stroke-width="1.3" stroke-dasharray="3 4" opacity=".6"></line>
            <line class="sctd-i" x1="98" y1="66" x2="183" y2="66" stroke-width="1.3" stroke-dasharray="3 4" opacity=".6"></line>
            <line class="sctd-i" x1="183" y1="66" x2="225" y2="140" stroke-width="1.3" stroke-dasharray="3 4" opacity=".6"></line>
            <line class="sctd-i" x1="140" y1="140" x2="225" y2="140" stroke-width="1.4"></line>
            <line class="sctd-i" x1="140" y1="140" x2="183" y2="214" stroke-width="1.4"></line>
            <line class="sctd-i" x1="140" y1="140" x2="98" y2="214" stroke-width="1.4"></line>
            <line class="sctd-i" x1="140" y1="140" x2="55" y2="140" stroke-width="1.4"></line>
            <line class="sctd-i" x1="140" y1="140" x2="98" y2="66" stroke-width="1.4"></line>
            <line class="sctd-h" x1="140" y1="140" x2="183" y2="66" stroke-width="1.4"></line>
            <circle class="sctd-i" cx="225" cy="140" r="6" stroke-width="1.5"></circle>
            <circle class="sctd-i" cx="183" cy="214" r="6" stroke-width="1.5"></circle>
            <circle class="sctd-i" cx="98" cy="214" r="6" stroke-width="1.5"></circle>
            <circle class="sctd-i" cx="55" cy="140" r="6" stroke-width="1.5"></circle>
            <circle class="sctd-i" cx="98" cy="66" r="6" stroke-width="1.5"></circle>
            <circle class="sctd-hf" cx="183" cy="66" r="6"></circle>
            <circle class="sctd-i" cx="140" cy="140" r="17" stroke-width="1.5"></circle>
            <circle class="sctd-hf" cx="140" cy="140" r="8"></circle>
            <circle class="sctd-hf" cx="97" cy="140" r="3.5"></circle>
          </svg>
        </button>

        {/* L1 · physical infrastructure — floor plan: racks + aisle + PDU */}
        <button
          type="button"
          class="sctd-plate"
          disabled
          data-layer="3"
          data-sctd-select
          style={`--top:${TOPS[3]}px;z-index:7`}
          aria-expanded="false"
          aria-label={layers[3].aria}
        >
          <span class="sctd-inner"></span>
          <svg viewBox="0 0 280 280" fill="none" aria-hidden="true">
            <rect class="sctd-i" x="56" y="56" width="32" height="54" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="102" y="56" width="32" height="54" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="148" y="56" width="32" height="54" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="194" y="56" width="32" height="54" rx="4" stroke-width="1.5"></rect>
            <line class="sctd-i" x1="62" y1="72" x2="82" y2="72" stroke-width="1.3"></line>
            <line class="sctd-i" x1="62" y1="84" x2="82" y2="84" stroke-width="1.3"></line>
            <line class="sctd-i" x1="108" y1="72" x2="128" y2="72" stroke-width="1.3"></line>
            <line class="sctd-h" x1="108" y1="84" x2="128" y2="84" stroke-width="1.3"></line>
            <line class="sctd-i" x1="154" y1="72" x2="174" y2="72" stroke-width="1.3"></line>
            <line class="sctd-i" x1="154" y1="84" x2="174" y2="84" stroke-width="1.3"></line>
            <line class="sctd-i" x1="200" y1="72" x2="220" y2="72" stroke-width="1.3"></line>
            <line class="sctd-i" x1="200" y1="84" x2="220" y2="84" stroke-width="1.3"></line>
            <line class="sctd-i" x1="56" y1="140" x2="226" y2="140" stroke-width="1.3" stroke-dasharray="4 5"></line>
            <rect class="sctd-i" x="40" y="134" width="12" height="12" rx="3" stroke-width="1.4"></rect>
            <rect class="sctd-hf" x="230" y="134" width="12" height="12" rx="3"></rect>
            <rect class="sctd-i" x="56" y="170" width="32" height="54" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="102" y="170" width="32" height="54" rx="4" stroke-width="1.5"></rect>
            <rect class="sctd-h sctd-hf" x="148" y="170" width="32" height="54" rx="4" fill-opacity=".12" stroke-width="1.5"></rect>
            <rect class="sctd-i" x="194" y="170" width="32" height="54" rx="4" stroke-width="1.5"></rect>
            <line class="sctd-i" x1="62" y1="186" x2="82" y2="186" stroke-width="1.3"></line>
            <line class="sctd-i" x1="62" y1="198" x2="82" y2="198" stroke-width="1.3"></line>
            <line class="sctd-i" x1="108" y1="186" x2="128" y2="186" stroke-width="1.3"></line>
            <line class="sctd-i" x1="108" y1="198" x2="128" y2="198" stroke-width="1.3"></line>
            <line class="sctd-h" x1="154" y1="186" x2="174" y2="186" stroke-width="1.3"></line>
            <line class="sctd-h" x1="154" y1="198" x2="174" y2="198" stroke-width="1.3"></line>
            <line class="sctd-i" x1="200" y1="186" x2="220" y2="186" stroke-width="1.3"></line>
            <line class="sctd-i" x1="200" y1="198" x2="220" y2="198" stroke-width="1.3"></line>
          </svg>
        </button>
      </div>

      {/* ══ One semantic layer list: normal-flow accordion below 1100px,
          finite narrative rail in the enhanced desktop chapter. ══ */}
      <div class="sctd-story" data-sctd-story>
        <div class="sctd-list-viewport" data-sctd-viewport>
          <ol class="sctd-list" data-sctd-list role="list">
            {
              layers.map((layer, i) => (
                <li class="sctd-row" data-sctd-item data-layer={i}>
                  <h3>
                    <button
                      type="button"
                      class="sctd-rowhead"
                      disabled
                      data-sctd-select
                      data-sctd-accordion
                      aria-expanded="true"
                      aria-controls={`${id}-layer-${i}`}
                    >
                      <span class="sctd-code">{layer.code}</span>
                      <span class="sctd-name">{layer.name}</span>
                    </button>
                  </h3>
                  {/* Visible and focusable in SSR. Enhancement may collapse
                      inactive compact panels only after initialization. */}
                  <div class="sctd-more" id={`${id}-layer-${i}`} data-sctd-panel>
                    <p class="sctd-desc">{layer.desc}</p>
                    <div class="sctd-chips">
                      {layer.chips.map((chip) => (
                        <span>{chip}</span>
                      ))}
                    </div>
                    <a class="sctd-link" data-sctd-link href={layer.href}>
                      {layer.linkLabel} <span aria-hidden="true">›</span>
                    </a>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="sctd-note" data-sctd-note>
          <i class="sctd-dot sctd-dot--ops" aria-hidden="true"></i>{note}
        </div>

        {/* Hidden until enhancement succeeds, so no-JS never ships dead UI.
            Accessible names reuse the reviewed layer names/labels. */}
        <div class="sctd-controls" data-sctd-controls hidden>
          <button type="button" class="sctd-arrow" data-sctd-prev aria-label={layers[0].aria} disabled>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m15 18-6-6 6-6M9 12h10" />
            </svg>
          </button>

          <div class="sctd-position" aria-live="polite" aria-atomic="true">
            <span data-sctd-position-code>{layers[0].code}</span>
            <span aria-hidden="true">·</span>
            <span data-sctd-position-name>{layers[0].name}</span>
          </div>

          <button type="button" class="sctd-arrow" data-sctd-next aria-label={layers[1].aria}>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m9 18 6-6-6-6M5 12h10" />
            </svg>
          </button>
        </div>
      </div>
    </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sctd {
    position: relative;
    isolation: isolate;
    padding: 56px 24px;
    --sctd-lift-0: 0px;
    --sctd-lift-1: 0px;
    --sctd-lift-2: 0px;
    --sctd-lift-3: 0px;
    --sctd-alpha-0: 1;
    --sctd-alpha-1: 1;
    --sctd-alpha-2: 1;
    --sctd-alpha-3: 1;
  }
  .sctd-scroll,
  .sctd-stage,
  .sctd-frame {
    position: relative;
  }
  .sctd-stage {
    background: var(--color-page);
  }
  .sctd-blueprint {
    z-index: 0;
    opacity: 0.7;
  }
  .sctd-routing {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: color-mix(in srgb, var(--color-royal) 20%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .sctd-routing [data-sctd-route] {
    stroke-dasharray: 1;
    stroke-dashoffset: var(--sctd-route-offset, 0.68);
  }
  .sctd-routing .sctd-ticks {
    stroke: color-mix(in srgb, var(--color-bright) 35%, transparent);
  }
  .sctd-frame {
    z-index: 2;
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
  }
  .sctd-intro {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .sctd-lead {
    max-width: 580px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-cool);
  }
  .sctd-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: start;
    margin-top: 40px;
  }

  /* 30-operational-stack */
  .sctd-visual {
    position: relative;
    height: 520px;
    min-width: 0;
    overflow: visible;
    transform: scale(var(--sctd-camera-scale, 1));
    transform-origin: 52% 52%;
  }
  .sctd-spine {
    position: absolute;
    left: 56%;
    top: 74px;
    z-index: 12;
    width: 0;
    height: 414px;
    border-left: 1px dashed color-mix(in srgb, var(--color-bright) 60%, transparent);
    opacity: var(--sctd-route-opacity, 0.5);
    pointer-events: none;
  }
  .sctd-callout {
    position: absolute;
    left: 0;
    right: 54%;
    top: calc(var(--top) + var(--sctd-layer-lift, 0px));
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: var(--sctd-layer-alpha, 1);
    pointer-events: none;
    transform: translateY(-50%);
    transition:
      top 0.32s cubic-bezier(0.22, 0.8, 0.36, 1),
      opacity 0.24s ease;
  }
  .sctd-code {
    flex: none;
    padding: 4px 8px;
    border: 1px solid var(--color-border-blue);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-cool);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .sctd-dash {
    flex: 1;
    border-top: 1px dashed var(--color-border-blue);
    transition: border-color 0.2s ease;
  }
  .sctd-plate {
    position: absolute;
    left: 56%;
    top: var(--top);
    width: clamp(220px, 66vw, 280px);
    height: clamp(220px, 66vw, 280px);
    padding: 0;
    border: 1.5px solid var(--color-border-blue);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-surface) 86%, transparent);
    box-shadow: 0 18px 34px -24px color-mix(in srgb, var(--color-navy) 28%, transparent);
    color: inherit;
    cursor: pointer;
    opacity: var(--sctd-layer-alpha, 1);
    transform:
      translate(-50%, -50%)
      translateY(var(--sctd-layer-lift, 0px))
      rotateX(58deg)
      rotateZ(-45deg);
    transition:
