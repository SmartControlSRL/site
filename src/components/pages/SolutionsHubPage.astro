---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../CtaBand.astro';
import Eyebrow from '../Eyebrow.astro';
import SectionHeading from '../SectionHeading.astro';
import TextLink from '../TextLink.astro';
import { getLangFromUrl, localizedPath, useTranslations } from '../../i18n/ui';
import type { SolutionsHubContent } from '../../content/hub-pages';

interface Props { content: SolutionsHubContent }

const { content } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: content.products.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: product.name,
      url: new URL(p(product.href), 'https://smartcontrol.ro').href,
      description: product.description,
      brand: { '@type': 'Brand', name: 'Smart Control' },
    },
  })),
};
---

<BaseLayout title={content.title} description={content.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

  <header class="bg-page">
    <div class="container pb-[64px] pt-[120px]">
      <Eyebrow>{content.hero.eyebrow}</Eyebrow>
      <h1 class="mt-6 max-w-[900px] text-[clamp(2.4rem,1.7rem+3vw,3.75rem)] font-extrabold leading-[1.1] text-midnight">
        {content.hero.lead} <span class="text-bright">{content.hero.accent}</span>
      </h1>
      <p class="mt-6 max-w-[720px] text-[18px] leading-[1.7] text-cool">{content.hero.body}</p>
    </div>
  </header>

  <section class="bg-surface py-[56px] sm:py-[80px]">
    <div class="container">
      <SectionHeading heading={content.productsHeading}>{content.productsBody}</SectionHeading>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {
          content.products.map((product) => (
            <article class="rounded-xl border border-border bg-surface p-8 shadow-md">
              <div class="font-mono text-[11px] uppercase tracking-[1.5px] text-royal">{product.suitedFor}</div>
              <h3 class="mt-3 text-[26px] font-bold text-navy">{product.name}</h3>
              <p class="mt-4 text-[15px] leading-[1.7] text-cool">{product.description}</p>
              <div class="mt-6"><TextLink href={p(product.href)}>{product.linkLabel}</TextLink></div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-page py-[56px] sm:py-[80px]">
    <div class="container">
      <SectionHeading eyebrow={content.principles.eyebrow} heading={content.principles.heading}>{content.principles.body}</SectionHeading>
      <ol class="mt-10 grid gap-5 md:grid-cols-3">
        {
          content.principles.items.map((item, index) => (
            <li class="rounded-xl border border-border-blue bg-surface p-7 shadow-sm">
              <span class="font-mono text-[11px] font-semibold text-royal">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 text-[18px] font-bold text-navy">{item.title}</h3>
              <p class="mt-3 text-[14px] leading-[1.7] text-cool">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand id="contact" heading={content.cta.heading} cta={t('cta.assessment')} subject={t('subject.assessment')}>
    {content.cta.body}
  </CtaBand>
</BaseLayout>
