---
import HeroVideoArtwork from "../HeroVideoArtwork.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MailtoLink from "../MailtoLink.astro";
import DetailMotion from "../DetailMotion.astro";
import ProductVisual from "../ProductVisual.astro";
import {
  ArrowUpRight,
  Activity,
  ShieldCheck,
  LayoutDashboard,
  KeyRound,
  SlidersHorizontal,
  Network,
} from "@lucide/astro";
import { getLangFromUrl, localizedPath, useTranslations } from "../../i18n/ui";
import {
  productPages,
  type ProductKey,
} from "../../content/product-pages";
import "../../styles/detail.css";
import "../../styles/product.css";
interface Props {
  product: ProductKey;
}
const { product } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const en = lang === "en";
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);
const copy = productPages[product][lang];
const otherKey = product === "seknet" ? "s-vpn" : "seknet";
const other = productPages[otherKey][lang];
// One icon per capability, in content order.
const icons =
  product === "seknet"
    ? [Activity, ShieldCheck, LayoutDashboard]
    : [KeyRound, SlidersHorizontal, Network];
const subject =
  product === "seknet" ? t("subject.demo.seknet") : t("subject.demo.svpn");
// Sections alternate wash/white; the related band takes whichever the
// optional associated-services band leaves.
const relatedWash = !copy.associatedServices;
const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: copy.name,
  description: copy.description,
  url: new URL(p("/solutii/" + product), "https://smartcontrol.ro").href,
  brand: { "@type": "Brand", name: "Smart Control" },
  manufacturer: { "@type": "Organization", name: "Smart Control SRL" },
};
---

<BaseLayout title={copy.title} description={copy.description}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
  <div class="detail-page product-page">
    <header class="detail-hero product-hero prd-hero">
      <HeroVideoArtwork variant={product} />
      <div class="detail-wrap detail-hero-grid">
        <div>
          <p class="detail-kicker">
            {en ? "Smart Control product" : "Produs Smart Control"} / {
              copy.name
            }
          </p><h1>{copy.name}.<br /><span>{copy.headline}</span></h1><p
            class="detail-lead"
          >
            {copy.intro}
          </p><ol class="prd-signal" data-detail-enter>
            {copy.signal.map((label) => <li><span>{label}</span></li>)}
          </ol><div class="detail-actions">
            <MailtoLink variant="button" dark subject={subject}
              >{t("cta.demo.seknet")}<ArrowUpRight size={20} /></MailtoLink
            >
          </div>
        </div>
      </div>
    </header>
    <section
      class="detail-section detail-wash prd-overview"
      id="capabilitati"
      aria-labelledby="prd-overview-heading"
    >
      <div class="detail-wrap prd-overview-grid">
        <div class="prd-overview-intro" data-detail-enter>
          <p class="detail-kicker">{copy.name}</p><h2
            id="prd-overview-heading"
          >
            {copy.contextTitle}
          </h2><p class="prd-lead">{copy.context}</p>
        </div>
        <div class="prd-overview-body">
          <figure class="prd-scene" data-route-visual data-detail-enter>
            <ProductVisual kind={product} tone="light" />
            <figcaption>
              {en ? "Conceptual overview" : "Schemă conceptuală"} / <span
                >{copy.name}</span
              >
            </figcaption>
          </figure>
          <ul class="prd-capabilities">
            {
              copy.capabilities.map((item, i) => {
                const Icon = icons[i];
                return (
                  <li class="prd-capability" data-detail-enter>
                    <span class="prd-capability-icon" aria-hidden="true">
                      <Icon size={22} stroke-width={1.5} />
                    </span>
                    <div>
                      <h3>{item.title}</h3>
                      <p>{item.body}</p>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </section>
    <section
      class="detail-section prd-journey"
      aria-labelledby="prd-journey-heading"
    >
      <div class="detail-wrap">
        <div class="prd-journey-intro" data-detail-enter>
          <p class="detail-kicker">{copy.journeyEyebrow}</p><h2
            id="prd-journey-heading"
          >
            {copy.journeyTitle}
          </h2><p class="prd-lead">{copy.journeyIntro}</p>
        </div>
        <ol class="prd-timeline">
          {
            copy.journey.map((step, i) => (
              <li class="prd-stop" data-detail-enter>
                <p class="prd-stop-label">
                  <span>0{i + 1}</span>
                  {step.label}
                </p>
                <span class="prd-stop-node" aria-hidden="true" />
                <h3>{step.title}</h3>
                <p class="prd-stop-body">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
    {
      copy.associatedServices && (
        <section
          class="detail-section detail-wash prd-assist"
          aria-labelledby="associated-services-heading"
        >
          <div class="detail-wrap prd-assist-grid">
            <div data-detail-enter>
              <p class="detail-kicker">{copy.associatedServices.eyebrow}</p>
              <h2 id="associated-services-heading">
                {copy.associatedServices.heading}
              </h2>
              <p class="prd-lead">{copy.associatedServices.body}</p>
            </div>
            <div data-detail-enter>
              <ul class="prd-chips">
                {copy.associatedServices.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )
    }
    <section
      class:list={["detail-section prd-related", { "detail-wash": relatedWash }]}
      aria-labelledby="prd-related-heading"
    >
      <div class="detail-wrap prd-related-grid">
        <div class="prd-related-intro" data-detail-enter>
          <p class="detail-kicker">Smart Control</p><h2
            id="prd-related-heading"
          >
            {
              en
                ? "Related services and products"
                : "Servicii și produse conexe"
            }
          </h2>
        </div>
        <a
          class="prd-card prd-card--product"
          href={p("/solutii/" + otherKey)}
          data-detail-enter
          ><h3 class="prd-wordmark">
            {other.name}<ArrowUpRight size={22} />
          </h3><p class="prd-card-headline">{other.headline}</p><p>
            {other.intro}
          </p></a
        >
        <a
          class="prd-card prd-card--service"
          href={p(copy.relatedHref)}
          data-detail-enter
          ><h3>{copy.relatedTitle}<ArrowUpRight size={20} /></h3><p>
            {copy.relatedBody}
          </p></a
        >
      </div>
    </section>
    <section class="detail-section detail-close">
      <div class="detail-wrap detail-close-grid">
        <div>
          <h2>{copy.cta.heading}</h2><p>{copy.cta.body}</p>
        </div><div class="detail-actions">
          <MailtoLink variant="button" dark subject={subject}
            >{t("cta.demo.seknet")}<ArrowUpRight size={20} /></MailtoLink
          >
        </div>
      </div>
    </section>
  </div>
  <DetailMotion />
</BaseLayout>
