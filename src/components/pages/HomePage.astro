---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MailtoLink from "../MailtoLink.astro";
import LogoMarquee from "../LogoMarquee.astro";
import HeroStack from "../HeroStack.astro";
import StackTeardown from "../StackTeardown.astro";
import ProductVisual from "../ProductVisual.astro";
import CloudScene from "../scenes/CloudScene.astro";
import { homeCopy, technologyPartners } from "../../content/home-page";
import { productPages } from "../../content/product-pages";
import {
  Server,
  ShieldCheck,
  Code,
  Workflow,
  ArrowUpRight,
  ArrowRight,
} from "@lucide/astro";
import { getLangFromUrl, useTranslations, localizedPath } from "../../i18n/ui";
const lang = getLangFromUrl(Astro.url);
const en = lang === "en";
const t = useTranslations(lang);
const copy = homeCopy[lang];
const p = (path: string) => localizedPath(lang, path);
const engagement = copy.process.steps;
const icons = [Server, ShieldCheck, Code, Workflow];
const description = copy.description;
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Smart Control SRL",
  url: en ? "https://smartcontrol.ro/en/" : "https://smartcontrol.ro/",
  logo: "https://smartcontrol.ro/smartcontrol-mark.png",
  description: copy.organizationDescription,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Intrarea Aviator Teodor Iliescu 37",
    postalCode: "011672",
    addressLocality: "București",
    addressCountry: "RO",
  },
};
---

<BaseLayout
  title="Smart Control — Trusted Service Delivery Partner"
  description={description}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(org)} />
  <div class="home-redesign">
    <header class="home-hero">
      <div class="home-wrap hero-layout">
        <div class="hero-copy">
          <p class="home-kicker hero-in">Trusted Service Delivery Partner</p>
          <h1 class="hero-in-2">
            {
              copy.hero.lead
                .split(/(?<=\.)\s+/)
                .map((line) => <span class="hero-line">{`${line} `}</span>)
            }<span class="hero-line hero-accent">{copy.hero.accent}</span>
          </h1>
          <p class="hero-lead hero-in-3">{copy.hero.body}</p>
          <div class="hero-actions hero-in-4">
            <MailtoLink
              variant="button"
              subject={t("subject.assessment")}
              class="home-primary"
              >{t("cta.assessment")}<ArrowUpRight size={19} /></MailtoLink
            ><a class="home-text-link" href="#servicii"
              >{en ? "View services" : "Vezi serviciile"}<ArrowRight
                size={18}
              /></a
            >
          </div>
        </div>
        <HeroStack
          layers={copy.layers
            .map(({ code, name }) => ({ code, name }))
            .reverse()}
        />
      </div>
    </header>
    <div class="home-band">
      <section
        id="servicii"
        class="home-wrap home-section"
        aria-labelledby="home-services-heading"
      >
        <div class="services-intro" data-home-enter>
          <p class="home-kicker">{copy.servicesLabel}</p><h2
            id="home-services-heading"
          >
            {copy.servicesTitle}
          </h2><p class="section-lead">{copy.servicesIntro}</p>
        </div>
        <div class="service-bento">
          {
            copy.services.map((service, index) => {
              const Icon = icons[index];
              const shape = ["feature", "side", "side", "wide"][index];
              return (
                <a
                  href={p(service.href)}
                  class:list={["service-link", `service-link--${shape}`]}
                  data-home-enter
                >
                  <Icon
                    class="service-icon"
                    size={index === 0 ? 32 : 26}
                    stroke-width={1.5}
                  />
                  <h3>
                    {service.title}
                    <ArrowUpRight class="service-arrow" size={24} />
                  </h3>
                  <p>{service.body}</p>
                  <span class="service-detail">{service.detail}</span>
                  {index === 0 && (
                    <div class="service-visual">
                      <CloudScene />
                    </div>
                  )}
                </a>
              );
            })
          }
        </div>
      </section>
    </div>
    <div class="home-stack">
      <StackTeardown
        visual={false}
        eyebrow={copy.stackLabel}
        heading={copy.stackTitle}
        layers={copy.layers.map((layer) => ({ ...layer, href: p(layer.href) }))}
        note={copy.stackNote}>{copy.stackBody}</StackTeardown
      >
    </div>
    <div class="home-band">
    <section
      id="cum-lucram"
      class="home-wrap home-section home-cloud"
      aria-labelledby="home-cloud-heading"
    >
      <div class="section-intro" data-home-enter>
        <div>
          <p class="home-kicker">{copy.process.eyebrow}</p><h2
            id="home-cloud-heading"
          >
            {copy.process.heading}
          </h2>
        </div><div>
          <p class="section-lead">{copy.process.description}</p><a
            href={p("/servicii/managed")}
            class="home-text-link cloud-link"
            >{en ? "Managed Services" : "Servicii Gestionate"}<ArrowUpRight
              size={20}
            /></a
          >
        </div>
      </div>
      <ol class="methodology">
        {
          engagement.map((stage, i) => (
            <li data-home-enter>
              <>
                <span class="stage-number">0{i + 1}</span>
                <h3>{stage.title}</h3>
                <p>{stage.body}</p>
              </>
            </li>
          ))
        }
      </ol>
    </section>
    </div>
    <section
      id="produse"
      class="home-products home-section"
      aria-labelledby="home-products-heading"
    >
      <div class="home-wrap">
        <div class="section-intro" data-home-enter>
          <div>
            <p class="home-kicker">{copy.productsLabel}</p><h2
              id="home-products-heading"
            >
              {copy.productsTitle}
            </h2>
          </div><p class="section-lead">{copy.productsIntro}</p>
        </div>
        <div class="product-rows">
          {
            copy.products.map((product, index) => {
              const key = index === 0 ? "seknet" : "s-vpn";
              const page = productPages[key][lang];
              return (
                <article
                  class:list={["product", { "product--flip": index === 1 }]}
                  data-home-enter
                >
                  <ProductVisual kind={key} />
                  <div class="product-content">
                    <p class="product-label">{product.label}</p>
                    <h3>{product.name}</h3>
                    <p class="product-headline">{page.headline}</p>
                    <p class="product-body">{page.intro}</p>
                    <ul class="product-points">
                      {page.capabilities.map((capability) => (
                        <li>{capability.title}</li>
                      ))}
                    </ul>
                    <a class="product-link" href={p(product.href)}>
                      {copy.explore} {product.name}
                      <ArrowUpRight size={21} />
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
    <section
      id="parteneri"
      class="home-partners"
      aria-labelledby="home-partners-heading"
    >
      <div class="home-wrap">
        <div class="section-intro" data-home-enter>
          <div>
            <p class="home-kicker">{copy.partnersLabel}</p><h2
              id="home-partners-heading"
            >
              {copy.partnersTitle}
            </h2>
          </div><p class="section-lead">{copy.partnersBody}</p>
        </div><LogoMarquee items={technologyPartners} />
      </div>
    </section>
    <section
      id="contact"
      class="home-contact"
      aria-labelledby="home-contact-heading"
    >
      <div class="home-wrap contact-layout">
        <div data-home-enter>
          <p class="home-kicker">{copy.contactLabel}</p><h2
            id="home-contact-heading"
          >
            {copy.contactTitle}
          </h2><p class="contact-body">{copy.contactBody}</p>
        </div><div class="contact-actions">
          <MailtoLink
            variant="button"
            dark
            subject={t("subject.assessment")}
            class="home-primary"
            >{t("cta.assessment")}<ArrowUpRight size={20} /></MailtoLink
          ><MailtoLink dark class="contact-email" /><span
            >{en ? "Bucharest, Romania" : "București, România"}</span
          >
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .home-redesign {
    color: var(--color-navy);
  }
  .home-wrap {
    width: min(100% - 80px, 1180px);
    margin-inline: auto;
  }
  .hero-copy {
    min-width: 0;
    width: 52%;
    max-width: 600px;
  }
  .home-hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    background: linear-gradient(
      180deg,
      var(--color-page) 0%,
      var(--color-page) 52%,
      var(--color-surface) 100%
    );
  }
  .hero-layout {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 560px;
    padding-block: 28px 56px;
  }
  .home-kicker {
    font: 500 12px/1.6 var(--font-mono);
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--color-royal);
  }
  h1 {
    font-size: clamp(2.6rem, 4.3vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.065em;
    font-weight: 600;
    margin-top: 25px;
    color: var(--color-midnight);
  }
  /* One word per line: Infrastructură. / Securitate. / Software. */
  .hero-line {
    display: block;
  }
  .hero-accent {
    color: var(--color-mid-blue);
  }
  .hero-lead {
    font-size: 18px;
    line-height: 1.65;
    max-width: 580px;
    margin-top: 28px;
    color: var(--color-slate);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: 30px;
  }
  .home-redesign :global(.home-primary) {
    gap: 14px;
    min-height: 52px;
    padding-inline: 23px;
    font-size: 15px;
    border-radius: var(--radius-sm);
  }
  .home-text-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    min-height: 44px;
    color: var(--color-royal);
  }
  .home-text-link svg {
    transition: transform 0.2s;
  }
  .home-text-link:hover svg {
    transform: translateX(4px);
  }
  .home-text-link:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  @media (max-width: 1000px) {
    h1 {
      font-size: clamp(2.6rem, 5.4vw, 3.5rem);
    }
    .hero-actions {
      gap: 12px;
    }
    .hero-lead {
      font-size: 17px;
    }
  }
  @media (max-width: 900px) {
    .hero-layout {
      flex-wrap: wrap;
      min-height: auto;
      padding-block: 48px 16px;
    }
    .hero-copy {
      width: 100%;
      max-width: 620px;
    }
  }
  @media (max-width: 760px) {
    .home-wrap {
      width: calc(100% - 40px);
    }
    h1 {
      font-size: clamp(2.35rem, 8.5vw, 3.5rem);
    }
    .hero-lead {
      max-width: 520px;
      font-size: 16px;
      margin-top: 22px;
    }
    .hero-layout {
      padding-top: 32px;
    }
    .hero-actions {
      margin-top: 20px;
    }
    .home-kicker {
      font-size: 11px;
      letter-spacing: 1.2px;
    }
  }
  h2 {
    font-size: clamp(2rem, 3.4vw, 2.875rem);
    line-height: 1.13;
    letter-spacing: -0.045em;
    font-weight: 600;
    white-space: pre-line;
    color: var(--color-midnight);
    margin-top: 18px;
  }
  .home-section {
    padding-block: 88px;
  }
  .section-intro {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 80px;
    align-items: end;
    margin-bottom: 48px;
  }
  .section-lead {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-slate);
    max-width: 440px;
  }
  .home-band {
    background: var(--color-page);
  }
  .services-intro {
    max-width: 760px;
    margin-bottom: 44px;
  }
  .services-intro .section-lead {
    max-width: 560px;
    margin-top: 20px;
  }
  /* Asymmetric bento: Cloud (the flagship) is the tall tile, Managed runs wide. */
  .service-bento {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    grid-template-areas:
      "feature side1"
      "feature side2"
      "wide wide";
    gap: 20px;
  }
  .service-link {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 30px 32px 28px;
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    color: var(--color-navy);
    transition:
      box-shadow 0.25s,
      transform 0.25s;
  }
  .service-link:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }
  .service-link--feature {
    grid-area: feature;
    padding: 40px 40px 0;
  }
  .service-link--side:nth-child(2) {
    grid-area: side1;
  }
  .service-link--side:nth-child(3) {
    grid-area: side2;
  }
  .service-link--wide {
    grid-area: wide;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-areas:
      "icon body"
      "title body"
      "title detail";
    column-gap: 56px;
    align-items: start;
  }
  .service-icon {
    color: var(--color-mid-blue);
    margin-bottom: 18px;
  }
  .service-link--wide .service-icon {
    grid-area: icon;
  }
  .service-link h3 {
    font-size: 23px;
    font-weight: 600;
    letter-spacing: -0.6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .service-link--feature h3 {
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    letter-spacing: -0.04em;
  }
  .service-link--wide h3 {
    grid-area: title;
    align-self: start;
    justify-content: flex-start;
  }
  .service-arrow {
    flex-shrink: 0;
    transition: transform 0.25s;
  }
  .service-link:hover .service-arrow {
    transform: translate(4px, -4px);
  }
  .service-link p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-slate);
    margin-top: 13px;
    max-width: 580px;
  }
  .service-link--feature p {
    font-size: 17px;
    max-width: 460px;
  }
  .service-link--wide p {
    grid-area: body;
    margin-top: 0;
  }
  .service-detail {
    display: block;
    margin-top: 19px;
    font-size: 13px;
    color: var(--color-royal);
  }
  .service-link--side .service-detail {
    margin-top: auto;
    padding-top: 19px;
  }
  .service-link--wide .service-detail {
    grid-area: detail;
  }
  .service-visual {
    margin-top: auto;
    padding-block: 32px 28px;
  }
  .home-stack,
  .home-stack :global(section) {
    background: var(--color-surface);
  }
  .home-stack :global(section) {
    padding-block: 88px;
  }
  .home-stack :global(h2) {
    font-weight: 600;
    letter-spacing: -0.045em;
    white-space: pre-line;
    font-size: clamp(2rem, 3.4vw, 2.875rem);
  }
  .home-stack :global(.eyebrow) {
    font-size: 12px;
    letter-spacing: 1.5px;
  }
  .home-stack :global(.eyebrow--rule) {
    border: 0;
    padding: 0;
  }
  .home-stack :global(.sctd-note) {
    font-family: var(--font-sans);
    font-size: 13px;
  }
  .home-products {
    background:
      radial-gradient(
        60% 50% at 80% 10%,
        color-mix(in srgb, var(--color-bright) 14%, transparent),
        transparent 70%
      ),
      var(--color-midnight);
    color: var(--color-surface);
    position: relative;
    overflow: hidden;
  }
  .home-products > .home-wrap {
    position: relative;
    z-index: 1;
  }
  .home-products .section-lead,
  .home-products .product-body {
    color: var(--color-border-blue);
  }
  .home-products h2 {
    color: var(--color-surface);
  }
  .home-products .home-kicker {
    color: var(--color-sky);
  }
  .home-products .section-lead {
    color: var(--color-on-dark);
  }
  /* Products alternate sides: each gets its own row and code-drawn scene. */
  .product-rows {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }
  .product {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }
  .product--flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
  }
  .product--flip > :global(.pv) {
    order: 2;
  }
  .product-content {
    max-width: 500px;
  }
  .product-label {
    font: 12px var(--font-mono);
    color: var(--color-sky);
  }
  .product h3 {
    font-size: 46px;
    letter-spacing: -2px;
    font-weight: 600;
    margin-top: 10px;
  }
  .product-headline {
    margin-top: 6px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.3px;
    color: var(--color-sky);
  }
  .product-body {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-on-dark);
    margin-top: 14px;
    max-width: 520px;
  }
  .product-points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 20px;
  }
  .product-points li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-surface);
  }
  .product-points li::before {
    content: "›";
    color: var(--color-sky);
  }
  .product-link {
    display: inline-flex;
    gap: 14px;
    align-items: center;
    margin-top: 26px;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-sky);
    min-height: 48px;
  }
  .product-link:hover {
    color: var(--color-surface);
  }
  .product-link svg {
    transition: transform 0.2s;
  }
  .product-link:hover svg {
    transform: translate(3px, -3px);
  }
  .cloud-link {
    margin-top: 18px;
  }
  /* Real sequence, so numbers stay; the steps descend as a connected stair. */
  .methodology {
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    padding-bottom: 8px;
  }
  .methodology li {
    position: relative;
    padding-top: 30px;
  }
  .methodology li:nth-child(2) {
    margin-top: 56px;
  }
  .methodology li:nth-child(3) {
    margin-top: 112px;
  }
  .methodology li::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--color-bright);
  }
  .methodology li:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 5px;
    left: 5px;
    width: calc(100% + 32px);
    height: 56px;
    border-top: 1.5px solid var(--color-border-blue);
    border-right: 1.5px solid var(--color-border-blue);
    border-top-right-radius: var(--radius-sm);
    z-index: -1;
  }
  .stage-number {
    font: 14px var(--font-mono);
    color: var(--color-royal);
  }
  .methodology h3 {
    font-size: 19px;
    line-height: 1.35;
    font-weight: 600;
    margin-top: 14px;
    letter-spacing: -0.3px;
  }
  .methodology p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-slate);
    margin-top: 10px;
    max-width: 320px;
  }
  .home-partners {
    padding-block: 88px;
  }
  .home-contact {
    padding-block: 80px;
    background: var(--color-navy);
    color: var(--color-surface);
  }
  .home-contact .home-kicker {
    color: var(--color-sky);
  }
  .home-contact h2 {
    color: var(--color-surface);
  }
  .contact-layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .contact-body {
    font-size: 17px;
    color: var(--color-on-dark);
    line-height: 1.7;
    margin-top: 22px;
    max-width: 560px;
  }
  .contact-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    justify-self: end;
  }
  .contact-actions > span {
    font-size: 13px;
    color: var(--color-on-dark);
  }
  .home-redesign :global(.contact-email) {
    font-size: 17px;
    color: var(--color-sky);
  }
  @media (max-width: 1000px) {
    .section-intro {
      gap: 40px;
    }
    .product,
    .product--flip {
      gap: 36px;
    }
    .service-link--wide {
      column-gap: 32px;
    }
    .methodology {
      gap: 20px;
    }
    .methodology li:not(:last-child)::after {
      width: calc(100% + 20px);
    }
    .methodology h3 {
      font-size: 16px;
    }
  }
  @media (max-width: 760px) {
    .home-section {
      padding-block: 60px;
    }
    .section-intro {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-bottom: 32px;
    }
    .section-lead {
      font-size: 16px;
      max-width: 560px;
    }
    .service-bento {
      grid-template-columns: 1fr;
      grid-template-areas: none;
      gap: 14px;
    }
    .service-link,
    .service-link--feature,
    .service-link--side:nth-child(2),
    .service-link--side:nth-child(3) {
      grid-area: auto;
      padding: 24px 22px;
    }
    .service-link--feature {
