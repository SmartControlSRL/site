---
import HeroVideoArtwork from "../HeroVideoArtwork.astro";
import CloudScene from "../scenes/CloudScene.astro";
import SecurityScene from "../scenes/SecurityScene.astro";
import SoftwareScene from "../scenes/SoftwareScene.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TextLink from "../TextLink.astro";
import MailtoLink from "../MailtoLink.astro";
import DetailMotion from "../DetailMotion.astro";
import { ArrowUpRight } from "@lucide/astro";
import { getLangFromUrl, localizedPath, useTranslations } from "../../i18n/ui";
import { homeCopy } from "../../content/home-page";
import type { ServicePageContent } from "../../content/service-pages";
import "../../styles/detail.css";
interface Props {
  content: ServicePageContent;
}
const { content } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const en = lang === "en";
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);
const related = homeCopy[lang].services.filter(
  (item) => !content.canonicalPath.includes(item.href),
);
const cloud = content.canonicalPath.includes("/cloud");
// Code-animated hero scenes replace the generated videos on three services
// (owner decision; docs/design-proposals/service-hero-scenes). Managed keeps
// its video.
const scenes = {
  "architecture-light": CloudScene,
  "network-security": SecurityScene,
  "software-automation": SoftwareScene,
} as const;
const Scene =
  content.hero.artwork === "managed-services"
    ? undefined
    : scenes[content.hero.artwork];
// Asymmetric bento: one featured tile beside two side tiles, then the rest in
// alternating 5/7 and 7/5 pairs; an odd leftover runs full width. This keeps
// 4, 5, 6 and 7 capabilities balanced without an equal-column grid.
const bentoShapes = (count: number) => {
  const shapes = ["feature", "side", "side"];
  let rest = count - shapes.length;
  let flip = false;
  while (rest >= 2) {
    shapes.push(...(flip ? ["seven", "five"] : ["five", "seven"]));
    flip = !flip;
    rest -= 2;
  }
  if (rest === 1) shapes.push("wide");
  return shapes.slice(0, count);
};
const shapes = bentoShapes(content.capabilities.items.length);
// Each service draws its own small motif in the featured tile, so the tile
// does not repeat one decoration across the template: Cloud = stacked plates,
// Security = a perimeter pane with a gate, Software = pipeline gates,
// Managed = an orbit around an operated block.
const motif = content.hero.artwork;
// Wash/white alternation: capabilities sit on the wash, the workflow on white,
// proof (when present) on the wash, and related services take whichever
// background its neighbour does not.
const relatedOnWash = !content.proof;
// Scope lists made only of short technical tokens get the larger pill size.
const scopeTokens = content.scope?.items.every((item) => item.length <= 24);
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: content.schemaName,
  description: content.description,
  serviceType: content.schemaServiceType,
  url: new URL(content.canonicalPath, "https://smartcontrol.ro").href,
  provider: {
    "@type": "Organization",
    name: "Smart Control SRL",
    url: "https://smartcontrol.ro/",
  },
};
---

<BaseLayout title={content.title} description={content.description}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
  <div class="detail-page">
    <header
      class:list={["detail-hero service-hero", { "service-hero--scene": Scene }]}
      data-hero-scene={Scene ? content.hero.artwork : undefined}
    >
      {!Scene && <HeroVideoArtwork variant="managed-services" />}
      <div class="detail-wrap detail-hero-grid">
        <div>
          <p class="detail-kicker">{content.hero.eyebrow}</p>
          <h1>
            {content.hero.lead}
            <span>{content.hero.accent}</span>{content.hero.tail}
          </h1>
          <p class="detail-lead">{content.hero.body}</p>
          <div class="detail-actions" data-service-hero-actions>
            <MailtoLink variant="button" subject={t("subject.assessment")}
              >{t("cta.assessment")}</MailtoLink
            >
            <TextLink
              href={cloud ? "#flux" : "#capabilities"}
              class="!text-base">{content.hero.secondary}</TextLink
            >
          </div>
        </div>
        {Scene && <Scene />}
      </div>
    </header>
    {
      content.scope && (
        <section class="svc-scope" aria-labelledby="svc-scope-heading">
          <div class="detail-wrap svc-scope-grid" data-detail-enter>
            <div class="svc-scope-intro">
              <h2 id="svc-scope-heading">{content.scope.heading}</h2>
              {content.scope.body && <p>{content.scope.body}</p>}
            </div>
            <ul class:list={["svc-pills", { "svc-pills--tokens": scopeTokens }]}>
              {content.scope.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
    <section class="detail-section detail-wash svc-capabilities" id="capabilities">
      <div class="detail-wrap">
        <div class="svc-stacked-intro" data-detail-enter>
          <p class="detail-kicker">{content.capabilities.eyebrow}</p>
          <h2>{content.capabilities.heading}</h2>
          {
            content.capabilities.description && (
              <p>{content.capabilities.description}</p>
            )
          }
        </div>
        <div class="svc-bento">
          {
            content.capabilities.items.map(({ title, body, items, Icon }, index) => (
              <article
                class:list={["svc-card", `svc-card--${shapes[index]}`]}
                data-detail-enter
              >
                <Icon
                  class="svc-card-icon"
                  size={shapes[index] === "feature" ? 34 : 26}
                  stroke-width={1.5}
                  aria-hidden="true"
                />
                <h3>{title}</h3>
                {body ? (
                  <p>{body}</p>
                ) : (
                  items && (
                    <ul class="svc-ticks">
                      {items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )
                )}
                {shapes[index] === "feature" && (
                  <svg
                    class="svc-card-art"
                    viewBox="0 0 320 132"
                    aria-hidden="true"
                    focusable="false"
                  >
                    {motif === "architecture-light" && (
                      <>
                        <rect class="svc-art-base" x="1" y="83" width="206" height="40" rx="6" />
                        <rect class="svc-art-mid" x="57" y="47" width="206" height="40" rx="6" />
                        <rect class="svc-art-top" x="113" y="11" width="206" height="40" rx="6" />
                      </>
                    )}
                    {motif === "network-security" && (
                      <>
                        <path class="svc-art-base" d="M150 50 V10 H318 V122 H150 V82" />
                        <path class="svc-art-line" d="M16 66 H210" />
                        <rect class="svc-art-accent" x="4" y="60" width="12" height="12" rx="2" />
                        <rect class="svc-art-top" x="144" y="38" width="12" height="12" rx="2" />
                        <rect class="svc-art-top" x="144" y="82" width="12" height="12" rx="2" />
                        <rect class="svc-art-mid" x="210" y="46" width="72" height="40" rx="6" />
                      </>
                    )}
                    {motif === "software-automation" && (
                      <>
                        <path class="svc-art-line" d="M4 66 H316" />
                        <rect class="svc-art-base" x="24" y="52" width="28" height="28" rx="4" />
                        <rect class="svc-art-base" x="96" y="48" width="36" height="36" rx="6" />
                        <rect class="svc-art-mid" x="176" y="44" width="44" height="44" rx="6" />
                        <rect class="svc-art-top" x="262" y="40" width="52" height="52" rx="6" />
                        <rect class="svc-art-accent" x="282" y="60" width="12" height="12" rx="2" />
                      </>
                    )}
                    {motif === "managed-services" && (
                      <>
                        <circle class="svc-art-line" cx="220" cy="66" r="58" />
                        <rect class="svc-art-mid" x="192" y="46" width="56" height="40" rx="6" />
                        <rect class="svc-art-accent" x="255" y="19" width="12" height="12" rx="2" />
                        <rect class="svc-art-top" x="173" y="101" width="12" height="12" rx="2" />
                      </>
                    )}
                  </svg>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section
      class="detail-section svc-flow"
      id={cloud ? "flux" : "workflow"}
    >
      <div class="detail-wrap svc-flow-grid">
        <div class="svc-flow-intro" data-detail-enter>
          <p class="detail-kicker">{content.flow.eyebrow}</p>
          <h2>{content.flow.heading}</h2>
          <p>{content.flow.description}</p>
        </div>
        <figure class="svc-timeline" data-route-visual data-stepper>
          <div class="svc-rail" aria-hidden="true">
            <div data-stepper-fill style="height:0"></div>
          </div>
          <ol class="svc-stages">
            {
              content.flow.steps.map((step, index) => (
                <li class="svc-stage" data-step data-detail-enter>
                  <span class="svc-stage-node" data-step-dot aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div class="svc-stage-body" data-step-body>
                    <span class="svc-stage-label">{step.label}</span>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <figcaption class="svc-flow-note">{content.flow.caption}</figcaption>
        </figure>
      </div>
    </section>
    {
      content.proof && (
        <section class="detail-section detail-wash svc-proof">
          <div class="detail-wrap svc-proof-grid">
            <div class="svc-proof-intro" data-detail-enter>
              <h2>{content.proof.heading}</h2>
              {content.proof.body && <p>{content.proof.body}</p>}
            </div>
            <ul class="svc-proof-list">
              {content.proof.items.map(({ title, body, Icon }) => (
                <li data-detail-enter>
                  <span class="svc-proof-chip" aria-hidden="true">
                    <Icon size={22} stroke-width={1.5} />
                  </span>
                  <div>
                    <h3>{title}</h3>
                    <p>{body}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
    <section
      class:list={["svc-related", { "detail-wash": relatedOnWash }]}
      aria-labelledby="svc-related-heading"
    >
      <div class="detail-wrap svc-related-grid" data-detail-enter>
        <div class="svc-related-intro">
          <h2 id="svc-related-heading">
            {en ? "Related services" : "Servicii conexe"}
          </h2>
          <p>{homeCopy[lang].servicesIntro}</p>
        </div>
        <ul class="svc-related-links">
          {
            related.map((item) => (
              <li>
                <a href={p(item.href)}>
                  <span>{item.title}</span>
                  <ArrowUpRight size={20} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <section class="detail-section detail-close">
      <div class="detail-wrap detail-close-grid">
        <div>
          <h2>{content.cta.heading}</h2><p>{content.cta.body}</p>
        </div><div class="detail-actions">
          <MailtoLink variant="button" dark subject={t("subject.assessment")}
            >{t("cta.assessment")}<ArrowUpRight size={20} /></MailtoLink
          >
        </div>
      </div>
    </section>
  </div>
  <DetailMotion />
</BaseLayout>
