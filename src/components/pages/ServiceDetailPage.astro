---
import AmbientArtwork from "../AmbientArtwork.astro";
import HeroVideoArtwork from "../HeroVideoArtwork.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TextLink from "../TextLink.astro";
import MailtoLink from "../MailtoLink.astro";
import DetailMotion from "../DetailMotion.astro";
import { ArrowUpRight } from "@lucide/astro";
import { getLangFromUrl, localizedPath, useTranslations } from "../../i18n/ui";
import { homeCopy } from "../../content/home-page";
import type { ServicePageContent } from "../../content/service-pages";
import "../../styles/detail.css";
interface Props {
  content: ServicePageContent;
}
const { content } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const en = lang === "en";
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);
const related = homeCopy[lang].services.filter(
  (item) => !content.canonicalPath.includes(item.href),
);
const cloud = content.canonicalPath.includes("/cloud");
const videoVariants = {
  "architecture-light": "cloud",
  "network-security": "network-security",
  "software-automation": "software-automation",
  "managed-services": "managed-services",
} as const;
const videoVariant = videoVariants[content.hero.artwork];
const managed = content.canonicalPath.includes("/managed");
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: content.schemaName,
  description: content.description,
  serviceType: content.schemaServiceType,
  url: new URL(content.canonicalPath, "https://smartcontrol.ro").href,
  provider: {
    "@type": "Organization",
    name: "Smart Control SRL",
    url: "https://smartcontrol.ro/",
  },
};
---

<BaseLayout title={content.title} description={content.description}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
  <div class="detail-page">
    <header class="detail-hero service-hero">
      {
        videoVariant ? (
          <HeroVideoArtwork variant={videoVariant} />
        ) : (
          <AmbientArtwork artwork={content.hero.artwork} />
        )
      }
      <div class="detail-wrap detail-hero-grid">
        <div>
          <p class="detail-kicker">{content.hero.eyebrow}</p>
          <h1>
            {content.hero.lead}
            <span>{content.hero.accent}</span>{content.hero.tail}
          </h1>
          <p class="detail-lead">{content.hero.body}</p>
          <div class="detail-actions" data-service-hero-actions>
            <MailtoLink variant="button" subject={t("subject.assessment")}
              >{t("cta.assessment")}</MailtoLink
            >
            <TextLink href="#capabilities" class="!text-base"
              >{en ? "View services" : "Vezi serviciile"}</TextLink
            >
          </div>
        </div>
      </div>
    </header>
    <section class="detail-wrap detail-section" id="capabilities">
      <div class="detail-intro" data-detail-enter>
        <div>
          <p class="detail-kicker">{en ? "Scope" : "Ce acoperim"}</p><h2>
            {content.capabilities.heading}
          </h2>
        </div>
        <p>
          {
            en
              ? "We agree which services you need and what each team will be responsible for."
              : "Stabilim împreună serviciile necesare și responsabilitățile fiecărei echipe."
          }
        </p>
      </div>
      <div class="detail-capabilities">
        {
          content.capabilities.items.map(({ title, body, Icon }) => (
            <article class="detail-capability" data-detail-enter>
              <>
                <h3>
                  <Icon size={24} stroke-width={1.5} />
                  {title}
                </h3>
                <p>{body}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section
      class="detail-section detail-wash"
      id={cloud ? "flux" : "workflow"}
    >
      <div class="detail-wrap">
        <div class="detail-intro" data-detail-enter>
          <div>
            <p class="detail-kicker">{content.flow.eyebrow}</p><h2>
              {content.flow.heading}
            </h2>
          </div><p>{content.flow.description}</p>
        </div>
        <figure data-route-visual>
          <ol class="detail-steps">
            {
              content.flow.steps.map((step, index) => (
                <li class="detail-step" data-step data-detail-enter>
                  <>
                    <span class="detail-step-number">
                      0{index + 1} / {step.label}
                    </span>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </>
                </li>
              ))
            }
          </ol>
          <figcaption class="detail-caption">{content.flow.caption}</figcaption>
        </figure>
      </div>
    </section>
    <section class="detail-wrap detail-section">
      <div class="detail-intro" data-detail-enter>
        <div>
          <p class="detail-kicker">
            {en ? "Related services" : "Servicii conexe"}
          </p><h2>
            {
              managed
                ? en
                  ? "Services we can manage"
                  : "Ce putem administra împreună"
                : en
                  ? "Other services for your project"
                  : "Alte servicii pentru proiectul tău"
            }
          </h2>
        </div><p>
          {
            en
              ? "We can include these services in the same project and coordinate the teams involved. Responsibilities, service levels and indicators are agreed contractually."
              : "Putem include și aceste servicii în proiect și coordona echipele implicate. Responsabilitățile, nivelurile de serviciu și indicatorii sunt agreați contractual."
          }
        </p>
      </div>
      <div class="detail-related">
        {
          related.map((item) => (
            <a href={p(item.href)}>
              <>
                <h3>
                  {item.title}
                  <ArrowUpRight size={20} />
                </h3>
                <p>{item.body}</p>
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="detail-section detail-close">
      <div class="detail-wrap detail-close-grid">
        <div>
          <h2>
            {
              en
                ? "Talk to our team."
                : "Discută cu echipa noastră."
            }
          </h2><p>
            {
              en
                ? "Describe your systems and what you want to improve. We will agree what needs to be assessed."
                : "Descrie-ne infrastructura și ce vrei să îmbunătățești. Stabilim împreună ce trebuie evaluat."
            }
          </p>
        </div><div class="detail-actions">
          <MailtoLink variant="button" dark subject={t("subject.assessment")}
            >{t("cta.assessment")}<ArrowUpRight size={20} /></MailtoLink
          >
        </div>
      </div>
    </section>
  </div>
  <DetailMotion />
</BaseLayout>
