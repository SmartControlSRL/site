---
// Home (RO) — / — cinematic Control Plane composition.
// All approved copy, metadata, routes and mail subjects remain unchanged.
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeExperience from '../components/HomeExperience.astro';
import { getLangFromUrl, useTranslations, localizedPath, yearsInBusiness } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);
const years = yearsInBusiness(new Date().getUTCFullYear());

const title = 'Smart Control — Trusted Service Delivery Partner';
const description = 'Infrastructură, networking, security și software enterprise, cu execuție 100% in-house și patru certificări ISO.';

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Smart Control SRL',
  url: 'https://smartcontrol.ro',
  logo: 'https://smartcontrol.ro/smartcontrol-mark.png',
  foundingDate: '2003',
  description: 'Infrastructură, securitate și software enterprise, execuție 100% in-house.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Intrarea Aviator Teodor Iliescu 37',
    postalCode: '011672',
    addressLocality: 'București',
    addressCountry: 'RO',
  },
};

const content = {
  hero: {
    eyebrow: 'Trusted Service Delivery Partner',
    title: 'Infrastructură. Securitate. Software.',
    accent: 'Execuție 100% in-house.',
    leadBefore: `Smart Control construiește și operează infrastructuri IT complexe de peste ${years} de ani, pentru clienți locali și internaționali. Lucrăm exclusiv cu `,
    leadStrong: 'echipa proprie de experți',
    leadAfter: ', într-o abordare consultativă: fiecare recomandare pleacă de la măsurători făcute în infrastructura clientului.',
    cta: 'Programează un assessment gratuit',
    servicesLink: 'Vezi serviciile',
    isoBadges: ['ISO 9001', 'ISO 27001', 'ISO 14001', 'ISO 45001'],
  },
  services: {
    heading: 'Un portofoliu integrat de servicii enterprise',
    lead: 'Patru piloni de servicii, susținuți de 50 de specialiști interni cu peste 500 de ani de experiență cumulată — on-site și remote, același nivel de calitate.',
    items: [
      {
        index: '01',
        title: 'Infrastructură & Cloud',
        body: 'Proiectăm și consolidăm centre de date, virtualizăm și operăm medii private, hibride și cloud.',
        items: ['Data Center Design & Implementation', 'Consolidare & Virtualizare', 'Private & Hybrid Cloud', 'Business Continuity & DR', 'Storage & Information Management', 'Infrastructure Management'],
        href: p('/servicii/cloud'),
      },
      {
        index: '02',
        title: 'Networking & Security',
        body: 'Securitate perimetrală și end-point, identitate și operațiuni de securitate gestionate.',
        items: ['Perimeter & End-point Security', 'Enterprise SSO / PKI', 'Data Leakage Prevention · WAF', 'Rapoarte de securitate și audit', 'Managed Security Operations'],
        href: p('/servicii/securitate'),
      },
      {
        index: '03',
        title: 'Software & Automatizare',
        body: 'Dezvoltare custom, modernizare aplicații și automatizare cu AI — livrare DevSecOps.',
        items: ['Dezvoltare software custom & API', 'DevOps / DevSecOps & CI/CD', 'Migrare și modernizare aplicații', 'Automatizare cu AI / LLM'],
        href: p('/servicii/software'),
      },
      {
        index: '04',
        title: 'Servicii Gestionate',
        body: 'Operăm infrastructura, rețeaua și securitatea cibernetică — service desk și suport on-site & remote.',
        items: ['Service Desk Outsourcing', 'Managed Infrastructure Operations', 'Network Managed Services', 'Cyber Security Managed Services', 'Outsourced Systems Support', 'Cloud Based System Support'],
        href: p('/servicii/managed'),
      },
    ],
  },
  accountability: {
    eyebrow: 'Stack Teardown',
    heading: 'Un singur partener, unic responsabil',
    lead: 'Acoperim întregul stack tehnologic — infrastructură, rețea, platforme și software — cu accent deosebit pe securitate, sub un SLA unic, end-to-end.',
    note: 'SLA 24/7, end-to-end — zero pasare a responsabilității între furnizori.',
    layers: [
      {
        code: 'L4',
        name: 'Aplicații & Automatizare',
        desc: 'Software custom, API-uri și automatizare cu AI / LLM.',
        chips: ['Custom dev & API', 'Modernizare aplicații', 'Automatizare AI / LLM', 'CI/CD & DevSecOps'],
        href: p('/servicii/software'),
        linkLabel: 'Software & Automatizare',
        aria: 'Nivel L4 — Aplicații și Automatizare',
      },
      {
        code: 'L3',
        name: 'Platforme & Date',
        desc: 'Virtualizare, cloud privat / hibrid, containere și storage.',
        chips: ['VMware · K8s / OpenShift', 'Private / Hybrid Cloud', 'Storage & backup', 'Disaster Recovery'],
        href: p('/servicii/cloud'),
        linkLabel: 'Infrastructură & Cloud',
        aria: 'Nivel L3 — Platforme și Date',
      },
      {
        code: 'L2',
        name: 'Rețea & Conectivitate',
        desc: 'Core networking, SD-WAN și acces remote securizat.',
        chips: ['LAN / WAN core', 'SD-WAN', 'Acces remote securizat', 'Load balancing'],
        href: p('/servicii/managed'),
        linkLabel: 'Network Managed Services',
        aria: 'Nivel L2 — Rețea și Conectivitate',
      },
      {
        code: 'L1',
        name: 'Infrastructură fizică',
        desc: 'Data center, compute, energie și cablare structurată.',
        chips: ['DC design & build', 'Compute & storage', 'Energie & cooling', 'Cablare structurată'],
        href: p('/servicii/cloud'),
        linkLabel: 'Infrastructură & Cloud',
        aria: 'Nivel L1 — Infrastructură fizică',
      },
    ],
  },
  products: {
    eyebrow: 'Produse proprietare',
    heading: 'Produse proprii pentru securitate și acces protejat',
    lead: 'SEKNET și S-VPN susțin organizațiile care au nevoie de control, vizibilitate și acces securizat. Detaliile tehnice sunt prezentate în cadrul unei discuții comerciale.',
    primaryLink: 'Explorează SEKNET',
    secondaryLink: 'Explorează S-VPN',
    statusTitle: 'SEKNET · VIZIBILITATE OPERAȚIONALĂ',
    metrics: [
      { label: 'Vizibilitate', value: 'Activă' },
      { label: 'Protecție', value: 'Continuă' },
      { label: 'Control', value: 'Centralizat' },
    ],
    signals: [
      { time: '08:14:02', msg: 'Starea infrastructurii a fost actualizată' },
      { time: '08:14:05', msg: 'Eveniment operațional analizat' },
      { time: '08:14:09', msg: 'Răspuns coordonat din punctul central' },
      { time: '08:14:12', msg: 'Contextul organizației a fost sincronizat' },
    ],
    items: [
      {
        name: 'SEKNET',
        body: 'Produs proprietar pentru monitorizarea și protejarea mediilor IT. Detaliile de capabilitate și integrare sunt disponibile la cerere.',
        href: p('/solutii/seknet'),
        linkLabel: 'Explorează SEKNET',
        artifact: 'seknet' as const,
      },
      {
        name: 'S-VPN',
        body: 'Produs proprietar pentru acces remote securizat. Detaliile de capabilitate și integrare sunt disponibile la cerere.',
        href: p('/solutii/s-vpn'),
        linkLabel: 'Explorează S-VPN',
        artifact: 'svpn' as const,
      },
    ],
  },
  cloud: {
    eyebrow: 'Cloud & Modernization',
    heading: 'Optimizarea bugetelor prin tranziția de la necesitatea de hardware la o arhitectură inteligentă',
    contextBefore: 'Prețurile componentelor critice cresc sub presiunea cererii pentru infrastructură AI, iar bugetele de refresh nu mai ajung. Re-arhitecturarea devine strategia principală, livrată printr-un flux în ',
    contextStrong: '5 etape',
    contextAfter: '.',
    linkLabel: 'Explorează Cloud & Modernization',
    href: p('/servicii/cloud'),
    steps: [
      { title: 'Evaluare', sub: 'assessment 2 zile' },
      { title: 'Re-arhitecturare', sub: 'design țintă' },
      { title: 'Containerizare', sub: 'K8s / OpenShift' },
      { title: 'Migrare', sub: 'zero-downtime' },
      { title: 'Validare ROI', sub: 'raport 90 zile' },
    ],
    rows: [
      { tag: 'CAPEX→OPEX', body: 'Migrarea investițiilor hardware spre modele cloud sau hibrid, cu costuri predictibile.' },
      { tag: 'K8S-READY', body: 'Containerizare și migrare pe Kubernetes / OpenShift / AKS / GKE, cu zero-downtime.' },
      { tag: 'ROI 90 ZILE', body: 'Validarea investiției printr-un raport de performanță măsurat după 90 de zile în producție.' },
    ],
  },
  partners: {
    eyebrow: 'Parteneri tehnologici',
    lead: 'Lucrăm direct cu producătorii și le folosim tehnologiile zi de zi, în proiectele clienților noștri.',
    items: ['Hitachi Vantara', 'Commvault', 'Fortinet', 'Cisco', 'Juniper', 'Lenovo', 'VMware', 'Fujitsu', 'Oracle', 'Microsoft', 'Palo Alto', 'Hanasis', 'IBM', 'HPE', 'DELL'],
  },
  cta: {
    eyebrow: 'Pașii următori',
    heading: 'Assessment inițial gratuit — 2 zile',
    lead: 'Fără obligații contractuale. Identificăm împreună zona de interes prioritară și livrăm un raport de recomandări la final.',
    label: t('cta.assessment'),
  },
};
---

<BaseLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(org)} />
  <HomeExperience content={content} assessmentSubject={t('subject.assessment')} />
</BaseLayout>
