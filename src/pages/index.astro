---
// Home (RO) — /
// Built 1:1 with docs/build-specs/home.md, applying RESOLUTIONS.md rulings:
//  · ISO 27701 stripped (4 ISO badges only); legal frameworks excluded from marketing copy.
//  · "Asset Management" stripped — the Produse dual cards pair SEKNET ↔ S-VPN.
//  · Years computed from 2003; © year dynamic (handled in Footer).
//  · No email inputs (no-forms); CTAs go straight to obfuscated mailto.
//  · Body-size link text royal on light / sky on dark (AA) via TextLink/MailtoLink.
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import GridTexture from '../components/GridTexture.astro';
import CtaBand from '../components/CtaBand.astro';
import ModuleCard from '../components/ModuleCard.astro';
import MonoPill from '../components/MonoPill.astro';
import IconChip from '../components/IconChip.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import TextLink from '../components/TextLink.astro';
import MailtoLink from '../components/MailtoLink.astro';
import SeknetConsole from '../components/SeknetConsole.astro';
import CloudPipeline from '../components/CloudPipeline.astro';
import StackTeardown from '../components/StackTeardown.astro';
import {
  getLangFromUrl,
  useTranslations,
  localizedPath,
  yearsInBusiness,
} from '../i18n/ui';
import { Server, ShieldCheck, Code, LifeBuoy, Shield, Lock } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);
const years = yearsInBusiness(new Date().getUTCFullYear());

const title = 'Smart Control — Trusted Service Delivery Partner';
const description = 'Infrastructură, networking, security și software enterprise, cu livrare coordonată de echipa Smart Control și patru certificări ISO.';

// — JSON-LD: Organization —
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Smart Control SRL',
  url: 'https://smartcontrol.ro',
  logo: 'https://smartcontrol.ro/smartcontrol-mark.png',
  foundingDate: '2003',
  description:
    'Infrastructură, securitate și software enterprise, cu livrare coordonată de echipa Smart Control.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Intrarea Aviator Teodor Iliescu 37',
    postalCode: '011672',
    addressLocality: 'București',
    addressCountry: 'RO',
  },
};

const isoBadges = ['ISO 9001', 'ISO 27001', 'ISO 14001', 'ISO 45001'];

const partners = [
  'Hitachi Vantara',
  'Commvault',
  'Fortinet',
  'Cisco',
  'Juniper',
  'Lenovo',
  'VMware',
  'Fujitsu',
  'Oracle',
  'Microsoft',
  'Palo Alto',
  'Hanasis',
  'IBM',
  'HPE',
  'DELL',
];

const consoleMetrics = [
  { label: 'Vizibilitate', value: 'Activă' },
  { label: 'Protecție', value: 'Continuă', accent: true },
  { label: 'Control', value: 'Centralizat' },
];
const consoleLog = [
  { time: '08:14:02', msg: 'Starea infrastructurii a fost actualizată', blocked: false },
  { time: '08:14:05', msg: 'Eveniment operațional analizat' },
  { time: '08:14:09', msg: 'Răspuns coordonat din punctul central', blocked: false },
  { time: '08:14:12', msg: 'Contextul organizației a fost sincronizat' },
];


// Stack Teardown — 4 operational layers, top of the stack (L4) first.
// Copy verbatim from the "Design originality recommendations" handoff.
const stackLayers = [
  {
    code: 'L4',
    name: 'Aplicații & Automatizare',
    desc: 'Software custom, API-uri și automatizare cu AI / LLM.',
    chips: ['Custom dev & API', 'Modernizare aplicații', 'Automatizare AI / LLM', 'CI/CD & DevSecOps'],
    href: p('/servicii/software'),
    linkLabel: 'Software & Automatizare',
    aria: 'Nivel L4 — Aplicații și Automatizare',
  },
  {
    code: 'L3',
    name: 'Platforme & Date',
    desc: 'Virtualizare, cloud privat / hibrid, containere și storage.',
    chips: ['VMware · K8s / OpenShift', 'Private / Hybrid Cloud', 'Storage & backup', 'Disaster Recovery'],
    href: p('/servicii/cloud'),
    linkLabel: 'Infrastructură & Cloud',
    aria: 'Nivel L3 — Platforme și Date',
  },
  {
    code: 'L2',
    name: 'Rețea & Conectivitate',
    desc: 'Core networking, SD-WAN și acces remote securizat.',
    chips: ['LAN / WAN core', 'SD-WAN', 'Acces remote securizat', 'Load balancing'],
    href: p('/servicii/managed'),
    linkLabel: 'Network Managed Services',
    aria: 'Nivel L2 — Rețea și Conectivitate',
  },
  {
    code: 'L1',
    name: 'Infrastructură fizică',
    desc: 'Data center, compute, energie și cablare structurată.',
    chips: ['DC design & build', 'Compute & storage', 'Energie & cooling', 'Cablare structurată'],
    href: p('/servicii/cloud'),
    linkLabel: 'Infrastructură & Cloud',
    aria: 'Nivel L1 — Infrastructură fizică',
  },
];

// Cloud & Modernization — 5-stage methodology, teaser pipeline.
const cloudSteps = [
  { title: 'Evaluare', sub: 'assessment inițial' },
  { title: 'Re-arhitecturare', sub: 'design țintă' },
  { title: 'Containerizare', sub: 'K8s / OpenShift' },
  { title: 'Migrare', sub: 'plan de rollback' },
  { title: 'Validare', sub: 'indicatori agreați' },
];

const cloudRows = [
  {
    tag: 'CAPEX→OPEX',
    body: 'Migrarea investițiilor hardware spre modele cloud sau hibrid, cu costuri predictibile.',
  },
  {
    tag: 'K8S-READY',
    body: 'Containerizare și migrare pe Kubernetes / OpenShift / AKS / GKE, cu ferestre și rollback planificate.',
  },
  {
    tag: 'VALIDARE POST-LANSARE',
    body: 'Validarea investiției prin indicatori și un interval de măsurare agreate pentru proiect.',
  },
];
---

<BaseLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(org)} />

  {/* ── SECTION 2 — Hero (light) ── */}
  <header
    class="relative overflow-hidden"
    style="background:var(--sc-gradient-hero-light)"
  >
    <GridTexture fade />

    <div
      class="relative z-[1] mx-auto max-w-[1180px] px-6 pb-[80px] pt-[120px] md:px-10 md:pt-[140px]"
    >
      <Eyebrow class="hero-in">
        Trusted Service Delivery Partner
      </Eyebrow>

      <h1
        class="hero-in-2 mt-7 max-w-[860px] text-[clamp(2.4rem,1.6rem+3.6vw,4rem)] font-extrabold leading-[1.08] tracking-[-2px] text-midnight"
      >
        Infrastructură. Securitate. Software.<br />
        <span class="text-bright">Livrare coordonată de echipa noastră.</span>
      </h1>

      <p
        class="hero-in-3 mt-7 max-w-[600px] text-[18px] leading-[1.7] text-slate"
      >
        Smart Control construiește și operează infrastructuri IT complexe de peste {years} de ani,
        pentru clienți locali și internaționali. Echipa Smart Control răspunde direct de livrare și
        coordonează specialiștii și partenerii tehnologici necesari. Fiecare recomandare pleacă de
        la măsurători făcute în infrastructura clientului.
      </p>

      <div class="hero-in-4 mt-[38px] flex flex-wrap items-center gap-[18px]">
        <MailtoLink variant="button" subject={t('subject.assessment')}>
          {t('cta.assessment')}
        </MailtoLink>
        <TextLink href="#servicii">Vezi serviciile</TextLink>
      </div>

      <div class="hero-in-4 mt-10 flex flex-wrap gap-2.5">
        {isoBadges.map((b) => <MonoPill class="!text-[13px] !px-3.5 !py-2 !tracking-[0.6px]">{b}</MonoPill>)}
      </div>
    </div>
  </header>

  {/* ── SECTION 4 — Servicii (bento, light) ── */}
  <section id="servicii" class="px-6 py-[56px] sm:py-[80px] md:px-10">
    <div class="mx-auto max-w-[1180px]">
      <div data-reveal>
        <SectionHeading
          heading="Un portofoliu integrat de servicii enterprise"
          headingMaxWidth="700px"
        >
          Patru piloni de servicii, susținuți de o echipă internă multidisciplinară, disponibilă
          on-site și remote, cu responsabilități clare pentru fiecare proiect.
        </SectionHeading>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-12">
        {/* Card 01 — span 7 */}
        <div
          data-reveal
          class="md:col-span-12 lg:col-span-7"
        >
          <ModuleCard
            title="Infrastructură & Cloud"
            index="01"
            body="Proiectăm și consolidăm centre de date, virtualizăm și operăm medii private, hibride și cloud."
            items={[
              'Data Center Design & Implementation',
              'Consolidare & Virtualizare',
              'Private & Hybrid Cloud',
              'Business Continuity & DR',
              'Storage & Information Management',
              'Infrastructure Management',
            ]}
            cols={2}
          >
            <Server slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5} />
          </ModuleCard>
        </div>

        {/* Card 02 — span 5 */}
        <div
          data-reveal
          data-reveal-delay="100"
          class="md:col-span-12 lg:col-span-5"
        >
          <ModuleCard
            title="Networking & Security"
            index="02"
            body="Securitate perimetrală și end-point, identitate și operațiuni de securitate gestionate."
            items={[
              'Perimeter & End-point Security',
              'Enterprise SSO / PKI',
              'Data Leakage Prevention · WAF',
              'Rapoarte de securitate și audit',
              'Managed Security Operations',
            ]}
            cols={1}
          >
            <ShieldCheck slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5} />
          </ModuleCard>
        </div>

        {/* Card 03 — span 5 */}
        <div
          data-reveal
          class="md:col-span-12 lg:col-span-5"
        >
          <ModuleCard
            title="Software & Automatizare"
            index="03"
            body="Dezvoltare custom, modernizare aplicații și automatizare cu AI — livrare DevSecOps."
            items={[
              'Dezvoltare software custom & API',
              'DevOps / DevSecOps & CI/CD',
              'Migrare și modernizare aplicații',
              'Automatizare cu AI / LLM',
            ]}
            cols={1}
          >
            <Code slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5} />
          </ModuleCard>
        </div>

        {/* Card 04 — span 7 */}
        <div
          data-reveal
          data-reveal-delay="100"
          class="md:col-span-12 lg:col-span-7"
        >
          <ModuleCard
            title="Servicii Gestionate"
            index="04"
            body="Operăm infrastructura, rețeaua și securitatea cibernetică — service desk și suport on-site & remote."
            items={[
              'Service Desk Outsourcing',
              'Managed Infrastructure Operations',
              'Network Managed Services',
              'Cyber Security Managed Services',
              'Outsourced Systems Support',
              'Cloud Based System Support',
            ]}
            cols={2}
          >
            <LifeBuoy slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5} />
          </ModuleCard>
        </div>
      </div>
    </div>
  </section>

  {/* ── SECTION 4b — Stack Teardown (light wash) ── */}
  <StackTeardown
    eyebrow="Stack Teardown"
    heading="Un singur partener, unic responsabil"
    layers={stackLayers}
    note="Un punct de contact și responsabilități contractuale definite pentru fiecare proiect."
  >
    Acoperim întregul stack tehnologic — infrastructură, rețea, platforme și software — cu accent
    deosebit pe securitate, cu niveluri de serviciu agreate pentru fiecare proiect.
  </StackTeardown>

  {/* ── SECTION 5 — Produse (DARK band) ── */}
  <section
    id="produse"
    class="relative overflow-hidden bg-midnight px-6 py-[56px] sm:py-[80px] md:px-10"
  >
    <GridTexture dark opacity={0.8} />

    <div class="relative z-[1] mx-auto max-w-[1180px]">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
        <div data-reveal>
          <SectionHeading
            eyebrow="Produse proprietare"
            heading="Produse proprii pentru securitate și acces protejat"
            variant="dark"
          >
            SEKNET și S-VPN susțin organizațiile care au nevoie de control, vizibilitate și acces securizat. Detaliile tehnice sunt prezentate în cadrul unei discuții comerciale.
          </SectionHeading>
          <div class="mt-7 flex flex-wrap items-center gap-5">
            <a
              href={p('/solutii/seknet')}
              class="inline-flex items-center gap-2 rounded-md bg-surface px-6 py-3 text-[14.5px] font-semibold text-navy transition-all hover:bg-blue-wash"
            >
              Explorează SEKNET <span aria-hidden="true">›</span>
            </a>
            <TextLink href={p('/solutii/s-vpn')} dark>Explorează S-VPN</TextLink>
          </div>

        </div>
        <div data-reveal data-reveal-delay="120">
          <SeknetConsole title="SEKNET · VIZIBILITATE OPERAȚIONALĂ" metrics={consoleMetrics} log={consoleLog} />
        </div>
      </div>

      {/* Bottom dual cards — SEKNET ↔ S-VPN (Asset Management stripped) */}
      <div data-reveal class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2">
        {/* Card A — SEKNET (link) */}
        <a
          href={p('/solutii/seknet')}
          class="flex items-start gap-[18px] rounded-lg border border-[rgba(122,180,232,0.18)] bg-[rgba(255,255,255,0.03)] px-7 py-6 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-[rgba(68,135,220,0.55)]"
        >
          <IconChip variant="dark" size={40} class="shrink-0">
            <Shield class="h-5 w-5 text-sky" stroke-width={1.5} />
          </IconChip>
          <div>
            <div class="text-[15.5px] font-bold text-white">SEKNET</div>
            <p class="mt-1.5 text-[13.5px] leading-[1.6] text-[rgba(226,233,245,0.6)]">
              Produs proprietar pentru monitorizarea și protejarea mediilor IT. Detaliile de capabilitate și integrare sunt disponibile la cerere.
            </p>
            <span class="mt-2.5 inline-block text-[13px] font-semibold text-sky"
              >Explorează SEKNET ›</span
            >
          </div>
        </a>

        {/* Card B — S-VPN (link) */}
        <a
          href={p('/solutii/s-vpn')}
          class="flex items-start gap-[18px] rounded-lg border border-[rgba(122,180,232,0.18)] bg-[rgba(255,255,255,0.03)] px-7 py-6 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-[rgba(68,135,220,0.55)]"
        >
          <IconChip variant="dark" size={40} class="shrink-0">
            <Lock class="h-5 w-5 text-sky" stroke-width={1.5} />
          </IconChip>
          <div>
            <div class="text-[15.5px] font-bold text-white">S-VPN</div>
            <p class="mt-1.5 text-[13.5px] leading-[1.6] text-[rgba(226,233,245,0.6)]">
              Produs proprietar pentru acces remote securizat. Detaliile de capabilitate și integrare sunt disponibile la cerere.
            </p>
            <span class="mt-2.5 inline-block text-[13px] font-semibold text-sky"
              >Explorează S-VPN ›</span
            >
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* ── SECTION 6 — Cloud teaser (light wash, tight tier) ── */}
  <section class="bg-page px-6 py-[44px] sm:py-[64px] md:px-10">
    <div class="mx-auto max-w-[1180px]">
      {/* Header split — heading left, context + CTA right */}
      <div data-reveal class="grid grid-cols-1 items-end gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">
        <SectionHeading
          eyebrow="Cloud & Modernization"
          heading="Optimizarea bugetelor prin tranziția de la necesitatea de hardware la o arhitectură inteligentă"
        />
        <div>
          <p class="text-[16px] leading-[1.6] text-cool">
            Prețurile componentelor critice cresc sub presiunea cererii pentru infrastructură AI, iar
            bugetele de refresh nu mai ajung. Re-arhitecturarea devine strategia principală, livrată
            printr-un flux în <strong class="font-semibold text-navy">5 etape</strong>.
          </p>
          <a
            href={p('/servicii/cloud')}
            class="mt-5 inline-flex items-center gap-2 rounded-md bg-navy px-6 py-3 text-[14.5px] font-semibold text-white transition-all hover:bg-midnight hover:[box-shadow:0_6px_20px_rgba(14,31,91,0.25)]"
          >
            Explorează Cloud & Modernization <span aria-hidden="true">›</span>
          </a>
        </div>
      </div>

      {/* 5-stage methodology pipeline */}
      <div data-reveal class="mt-12">
        <CloudPipeline steps={cloudSteps} />
      </div>

      {/* Capability cards */}
      <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-3">
        {
          cloudRows.map(({ tag, body }) => (
            <div class="rounded-lg border border-border bg-surface p-[26px] shadow-sm transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-[2px] hover:border-border-blue hover:shadow-lg">
              <span class="mb-3.5 inline-block rounded-sm bg-blue-wash px-2.5 py-1 font-mono text-[11.5px] tracking-[0.5px] text-royal">
                {tag}
              </span>
              <p class="text-[14.5px] leading-[1.55] text-slate">{body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── SECTION 7 — Parteneri (light marquee) ── */}
  <section id="parteneri" class="overflow-hidden bg-surface py-16">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10">
      <div data-reveal class="text-center">
        <Eyebrow>Parteneri tehnologici</Eyebrow>
        <p class="mx-auto mt-5 max-w-[540px] text-[15.5px] text-cool">
          Lucrăm direct cu producătorii și le folosim tehnologiile zi de zi, în proiectele
          clienților noștri.
        </p>
      </div>
    </div>
    <div class="mt-9 [will-change:transform]">
      <LogoMarquee items={partners} />
    </div>
  </section>

  {/* ── SECTION 8 — CTA / Contact (DARK band) ── */}
  <CtaBand
    id="contact"
    eyebrow="Pașii următori"
    heading="Discutăm un assessment inițial"
    cta={t('cta.assessment')}
    subject={t('subject.assessment')}
    showContact={false}
  >
    Clarificăm zona de interes prioritară, livrabilele și condițiile comerciale înainte de începerea
    assessment-ului.
  </CtaBand>
</BaseLayout>
