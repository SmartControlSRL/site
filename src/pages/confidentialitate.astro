---
import BaseLayout from '../layouts/BaseLayout.astro';
import MailtoLink from '../components/MailtoLink.astro';
---

<BaseLayout
  title="Confidențialitate — revizuire juridică în curs | Smart Control"
  description="Informațiile de confidențialitate Smart Control sunt în curs de validare juridică înainte de publicare."
  noindex
  unpublished
>
  <section
    data-privacy-status="pending-legal-review"
    class="container flex min-h-[55vh] max-w-[760px] items-center py-[72px] sm:py-[96px]"
  >
    <article class="rounded-xl border border-border bg-surface p-8 shadow-sm sm:p-12">
      <p class="font-mono text-[12px] uppercase tracking-[2px] text-royal">Revizuire juridică</p>
      <h1 class="mt-4 text-[clamp(2rem,1.5rem+2vw,3rem)] font-extrabold leading-tight text-midnight">
        Informațiile de confidențialitate sunt în curs de validare
      </h1>
      <p class="mt-6 text-[17px] leading-[1.7] text-slate">
        Versiunea completă nu este încă aprobată pentru publicare. Inventarul prelucrărilor,
        furnizorii, perioadele de păstrare, temeiurile juridice și datele de contact ale
        responsabilului sunt în curs de confirmare.
      </p>
      <p class="mt-5 text-[17px] leading-[1.7] text-slate">
        Pentru o solicitare privind datele cu caracter personal, contactați Smart Control la{' '}
        <MailtoLink variant="link" subject="Solicitare confidențialitate" />.
      </p>
      <p class="mt-6 text-[14px] leading-[1.6] text-cool" role="status">
        Această pagină este exclusă temporar din indexare și va fi publicată după aprobarea juridică.
      </p>
      <a class="mt-6 inline-block text-[14px] font-semibold text-royal underline decoration-bright underline-offset-4" href="/en/privacy/" lang="en">
        English legal-review notice
      </a>
    </article>
  </section>
</BaseLayout>
