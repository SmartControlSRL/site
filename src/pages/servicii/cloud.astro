---
// /servicii/cloud — Cloud & Modernization (RO). Template B flagship: light hero
// → "De ce acum" 3-card reasons grid → #flux 5-stage scroll stepper (wash band)
// → "Ce livrăm" capabilities bento → dark CtaBand (#contact). Copy verbatim from
// docs/build-specs/cloud.md; motion via data-attributes auto-wired by BaseLayout.
import BaseLayout from '../../layouts/BaseLayout.astro';
import GridTexture from '../../components/GridTexture.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ChevronList from '../../components/ChevronList.astro';
import CtaBand from '../../components/CtaBand.astro';
import MailtoLink from '../../components/MailtoLink.astro';
import TextLink from '../../components/TextLink.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import {
  Container,
  GitBranch,
  Cloud,
  Gauge,
} from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pageTitle = 'Cloud & Modernizare — Re-arhitecturare și optimizare aplicații | Smart Control';
const pageDescription =
  'Hardware-ul se scumpește. Propunem o abordare de re-arhitecturare, containerizare și migrare selectivă în cloud pentru performanță și costuri predictibile.';

// SECTION 4 — #flux 5-stage methodology (number / title / pill / body, verbatim).
const steps = [
  {
    title: 'Propunere de re-arhitecturare',
    pill: 'Fast Track',
    body: 'Pentru clienții cu care avem deja o relație stabilă: valorificăm cunoștințele despre infrastructura existentă pentru a identifica punctele critice și propunem modernizări bazate pe date reale.',
  },
  {
    title: 'Assessment inițial & quick wins',
    pill: '2 zile · gratuit',
    body: 'Inventarierea infrastructurii, analiza de performanță și evaluarea gap-urilor.',
  },
  {
    title: 'Planul de refactoring',
    pill: 'Plan tehnic',
    body: 'Roadmap tehnic cu prioritizarea aplicațiilor, testare în staging și plan de rollback.',
  },
  {
    title: 'Implementare agilă & transfer de cunoștințe',
    pill: 'DevSecOps',
    body: 'Containerizare și migrare, pipeline-uri de livrare, integrare hibridă, workshop-uri tehnice și documentație.',
  },
  {
    title: 'Monitorizare continuă și optimizare',
    pill: 'Indicatori propuși',
    body: 'Monitorizare și optimizare proactive pentru a atinge indicatorii propuși.',
  },
];

// SECTION 5 — Capabilities bento (icon / title / 3 bullets, verbatim).
const capabilities = [
  {
    Icon: Container,
    title: 'Containerizare & orchestrare',
    items: [
      'Prioritizarea aplicațiilor',
      'Migrare controlată',
      'Rollback planificat',
    ],
    reveal: { 'data-reveal': true },
  },
  {
    Icon: GitBranch,
    title: 'DevSecOps & CI/CD',
    items: [
      'Pipeline-uri de livrare',
      'Testare automată în staging',
      'Infrastructure-as-Code',
    ],
    reveal: { 'data-reveal': true },
  },
  {
    Icon: Cloud,
    title: 'Integrare hibridă',
    items: [
      'Integrare on-premise și cloud',
      'Migrare selectivă',
      'Costuri predictibile',
    ],
    reveal: { 'data-reveal': true },
  },
  {
    Icon: Gauge,
    title: 'Monitorizare & suport',
    items: [
      'Suport proactiv',
      'Monitorizare continuă',
      'Urmărirea indicatorilor propuși',
    ],
    reveal: { 'data-reveal': true },
  },
];

// JSON-LD: Service (Cloud & Modernization, provider Smart Control).
const SITE = 'https://smartcontrol.ro';
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Cloud & Modernizare',
  serviceType: 'Cloud modernization & application re-architecture',
  url: `${SITE}/servicii/cloud`,
  description:
    'Re-arhitecturare și optimizare a aplicațiilor, containerizare, DevSecOps și migrare selectivă în cloud printr-o abordare în 5 etape.',
  provider: {
    '@type': 'Organization',
    name: 'Smart Control SRL',
    url: SITE,
  },
  areaServed: ['RO', 'EU'],
  availableLanguage: ['ro', 'en'],
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceLd)} />

  {/* ============ SECTION 2 — HERO (light) ============ */}
  <header
    class="relative overflow-hidden"
    style="background:var(--sc-gradient-hero-light)"
  >
    <GridTexture fade />

    <div class="container relative pb-[72px] pt-[120px] md:pt-[120px]">
      <Eyebrow variant="light" class="hero-in">Cloud &amp; Modernization</Eyebrow>

      <h1
        class="hero-in-2 mt-6 max-w-[860px] text-[clamp(2.25rem,1.6rem+2.8vw,3.625rem)] font-extrabold leading-[1.1] tracking-[-1.8px] text-midnight"
      >
        Hardware-ul se scumpește.<br /><span class="text-bright">Propunem următoarea abordare.</span>
      </h1>

      <p class="hero-in-3 mt-6 max-w-[640px] text-[18px] leading-[1.7] text-slate">
        Prețurile componentelor critice cresc sub presiunea cererii pentru
        infrastructură AI, iar bugetele de refresh nu mai ajung.
        <span class="font-semibold text-navy">Re-arhitecturarea și optimizarea aplicațiilor</span>
        devin strategia principală — obții mai multă performanță din
        infrastructura existentă, înainte să cumperi una nouă.
      </p>

      <div class="hero-in-4 mt-[38px] flex flex-wrap items-center gap-4">
        <MailtoLink variant="button" subject={t('subject.assessment')}>
          Programează assessment-ul gratuit
        </MailtoLink>
        <TextLink href="#flux">Vezi fluxul în 5 etape</TextLink>
      </div>

    </div>
  </header>

  {/* ============ SECTION 4 — FLUX 5 ETAPE (#flux, scroll stepper, wash band) ============ */}
  <section id="flux" class="bg-page">
    <div class="container py-[64px] sm:py-[88px]">
      <div data-reveal>
        <SectionHeading
          eyebrow="Abordare"
          heading="Propunem 5 etape"
          headingMaxWidth="700px"
        />
      </div>

      {/* Page-local stepper composite — matches the initStepper data-contract
          (data-stepper / data-stepper-fill / data-step / -dot / -body) so
          BaseLayout auto-wires it. Spec dot = 52px, rail at 25px, with a mono
          pill the shared <Stepper> can't render yet (see sharedChangeRequests). */}
      <div class="relative mt-10" data-stepper>
        <div class="absolute left-[25px] top-7 bottom-7 w-[2px] bg-border-blue" aria-hidden="true">
          <div
            data-stepper-fill
            class="absolute left-0 top-0 w-full"
            style="height:0;background:linear-gradient(180deg,#4487DC,#7AB4E8)"
          >
          </div>
        </div>

        <ol class="relative">
          {
            steps.map((s, i) => (
              <li
                data-step
                class="relative grid grid-cols-[52px_1fr] gap-5 py-[26px] md:gap-8"
              >
                <span
                  data-step-dot
                  class="flex h-[52px] w-[52px] items-center justify-center rounded-[12px] border border-border-blue bg-surface font-mono text-[15px] font-semibold text-cool transition-[border-color,color,box-shadow,background] duration-[400ms]"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div
                  data-step-body
                  class="max-w-[760px] transition-opacity duration-[400ms]"
                  style="opacity:0.45"
                >
                  <div class="flex flex-wrap items-baseline gap-3.5">
                    <h3 class="text-[20px] font-bold tracking-[-0.3px] text-navy">{s.title}</h3>
                    <span class="rounded-full border border-border-blue bg-surface px-2.5 py-[3px] font-mono text-[11px] uppercase tracking-[1px] text-royal">
                      {s.pill}
                    </span>
                  </div>
                  <p class="mt-2.5 text-[14.5px] leading-[1.7] text-cool">{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* ============ SECTION 5 — STACK / CE LIVRĂM (light) ============ */}
  <section aria-labelledby="ce-livram" class="bg-surface">
    <div class="container py-[44px] sm:py-[64px]">
      <div data-reveal>
        <SectionHeading
          heading="Ce livrăm concret"
          headingMaxWidth="700px"
          headingId="ce-livram"
        />
      </div>

      <div class="mt-9 grid gap-5 md:grid-cols-2">
        {
          capabilities.map(({ Icon, title, items, reveal }) => (
            <div {...reveal}>
              <article class="box-border h-full rounded-xl border border-border bg-surface px-[34px] py-[30px] shadow-sm transition-all duration-[350ms] ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-[4px] hover:border-border-blue hover:shadow-lg">
                <div class="flex items-center gap-3">
                  <Icon class="h-5 w-5 text-bright" stroke-width={1.5} />
                  <h3 class="text-[17px] font-bold text-navy">{title}</h3>
                </div>
                <ChevronList items={items} cols={1} class="mt-4 gap-y-[9px]" />
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ============ SECTION 6 — CTA (#contact, dark band) ============ */}
  <CtaBand
    id="contact"
    heading="Cât te costă infrastructura actuală și cât ai putea economisi"
    cta={t('cta.assessment')}
    subject={t('subject.assessment')}
  >
    Assessment-ul gratuit de 2 zile cartografiază infrastructura actuală și estimează economia posibilă prin re-arhitecturare.
  </CtaBand>
</BaseLayout>
