---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Eyebrow from '../../components/Eyebrow.astro'; import SectionHeading from '../../components/SectionHeading.astro'; import ModuleCard from '../../components/ModuleCard.astro'; import CtaBand from '../../components/CtaBand.astro'; import MailtoLink from '../../components/MailtoLink.astro'; import TextLink from '../../components/TextLink.astro'; import { getLangFromUrl,useTranslations } from '../../i18n/ui'; import { Code,GitBranch,Layers,Bot,Users,FileCode as FileCode2,Gauge,MessageSquare } from '@lucide/astro';
const lang=getLangFromUrl(Astro.url); const t=useTranslations(lang);
const description='Dezvoltare software end-to-end: aplicații custom, DevSecOps, modernizare și automatizare cu AI, de la arhitectură la deployment și suport.';
const jsonLd={'@context':'https://schema.org','@type':'Service',name:'Software & Automatizare',description,provider:{'@type':'Organization',name:'Smart Control SRL',url:'https://smartcontrol.ro'},url:'https://smartcontrol.ro/servicii/software/',areaServed:['RO','EU'],serviceType:['Custom Software Development','DevOps','DevSecOps','Application Modernization','AI Automation','Architecture Consulting','Staff Augmentation']};
const caps=[{title:'Dezvoltare software custom & API',body:'Aplicații și integrări adaptate proceselor și sistemelor existente.',Icon:Code},{title:'DevOps / DevSecOps & CI/CD',body:'Fluxuri de livrare automatizate, testare și controale de securitate integrate.',Icon:GitBranch},{title:'Migrare & modernizare aplicații',body:'Refactoring, re-platforming și evoluția controlată a aplicațiilor existente.',Icon:Layers},{title:'Automatizare cu AI / LLM',body:'Automatizări pentru procesarea documentelor, raportare și asistență operațională.',Icon:Bot},{title:'Consultanță & Staff Augmentation',body:'Arhitectură, prioritizare și specialiști integrați în echipele clientului, cu SLA cu metrici garantate.',Icon:Users}];
---
<BaseLayout title="Software & Automatizare — Smart Control" description={description}><script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}/><header class="bg-page"><div class="container pb-[64px] pt-[120px] md:pt-[120px]"><Eyebrow>Software &amp; Automatizare</Eyebrow><h1 class="mt-6 text-[clamp(2.5rem,1.7rem+3vw,3.75rem)] font-extrabold leading-[1.1] text-midnight">Dezvoltare software <span class="text-bright">end-to-end</span></h1><p class="mt-6 max-w-[680px] text-[18px] leading-[1.7] text-cool">De la arhitectura inițială până la deployment în producție: dezvoltare custom, DevSecOps, modernizare și automatizare cu AI, cu responsabilitate pe întregul ciclu de livrare.</p><div class="mt-9 flex gap-4"><MailtoLink variant="button" subject={t('subject.assessment')}>{t('cta.assessment')}</MailtoLink><TextLink href="#capabilitati">Vezi capabilitățile</TextLink></div></div></header><section class="bg-surface py-[48px] sm:py-[72px]"><div class="container"><SectionHeading heading="Livrare software end-to-end">Preluăm responsabilitatea de la definirea arhitecturii până la deployment, suport și evoluția aplicației, cu un singur punct de contact și livrabile clare la fiecare etapă.</SectionHeading><div class="mt-9 grid gap-5 md:grid-cols-3">{[{title:'Acces la codul sursă',body:'Codul sursă și documentația sunt disponibile la livrare.',Icon:FileCode2},{title:'SLA cu metrici garantate',body:'Timpii, disponibilitatea și indicatorii relevanți sunt definiți explicit.',Icon:Gauge},{title:'Abordare consultativă',body:'Arhitectura și prioritățile pornesc de la cerințele reale.',Icon:MessageSquare}].map(({title,body,Icon})=><ModuleCard title={title} body={body}><Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div></div></section><section id="capabilitati" class="bg-page py-[56px] sm:py-[80px]"><div class="container"><SectionHeading eyebrow="Capabilități" heading="Cinci domenii de livrare"/><div class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{caps.map((c,i)=><ModuleCard title={c.title} index={String(i+1).padStart(2,'0')} body={c.body}><c.Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div></div></section><CtaBand heading="Discutăm arhitectura și constrângerile proiectului" cta={t('cta.assessment')} subject={t('subject.assessment')}>Clarificăm arhitectura, integrările și constrângerile, cu acces la codul sursă și handover documentat.</CtaBand></BaseLayout>
