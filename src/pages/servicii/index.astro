---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import MonoPill from '../../components/MonoPill.astro';
import CtaBand from '../../components/CtaBand.astro';
import RouteHero from '../../components/RouteHero.astro';
import ControlLane from '../../components/ControlLane.astro';
import ProofLedger from '../../components/ProofLedger.astro';
import { Server, ShieldCheck, Code, Settings2 } from '@lucide/astro';
import { useTranslations, getLangFromUrl, localizedPath, FOUNDED } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);

const pillars = [
  {
    index: '01',
    title: 'Infrastructură & Cloud',
    href: p('/servicii/cloud'),
    icon: Server,
    body: 'Proiectăm și consolidăm centre de date, infrastructuri hibride și soluții cloud, cu orchestrare Kubernetes end-to-end.',
    items: [
      'Data Center Design & Implementation',
      'Consolidare & Virtualizare',
      'Private Cloud & Hybrid Cloud',
      'Business Continuity & Disaster Recovery',
    ],
  },
  {
    index: '02',
    title: 'Networking & Security',
    href: p('/servicii/securitate'),
    icon: ShieldCheck,
    body: 'Protejăm infrastructuri enterprise, de la rețea și perimetru până la identitate și operațiuni de securitate gestionate.',
    items: [
      'Perimeter & End-point Security',
      'Enterprise SSO / PKI',
      'Monitorizare și raportare de securitate',
      'Managed Security Operations',
    ],
  },
  {
    index: '03',
    title: 'Software & Automatizare',
    href: p('/servicii/software'),
    icon: Code,
    body: 'Construim, modernizăm și automatizăm aplicații enterprise, cu refactoring, containerizare, DevSecOps și soluții bazate pe AI adaptate proceselor existente.',
    items: [
      'Dezvoltare software custom & API',
      'DevOps / DevSecOps & CI/CD',
      'Migrare și modernizare aplicații',
      'Automatizare cu AI / LLM',
    ],
  },
  {
    index: '04',
    title: 'Servicii Gestionate',
    href: p('/servicii/managed'),
    icon: Settings2,
    body: 'Preluăm operarea continuă a infrastructurii și aplicațiilor tale. Echipa noastră internă lucrează cu SLA-uri clare și raportare transparentă.',
    items: [
      'Managed Infrastructure Operations',
      'Service Desk Outsourcing',
      'Cyber Security Managed Services',
      'Cloud Based System Support',
    ],
  },
];

const accountability = [
  {
    title: 'Specialiști angajați direct',
    body: '50 de specialiști interni, disponibili on-site și remote, mențin același nivel de calitate pe fiecare proiect.',
  },
  {
    title: 'Abordare consultativă',
    body: 'Relații pe termen lung cu 250+ clienți, cu decizii de livrare bazate pe rezultate măsurate în teren.',
  },
  {
    title: 'Produse software proprii',
    body: 'Produsele software proprii sunt dezvoltate și susținute de echipa Smart Control, cu opțiuni de livrare stabilite pentru fiecare proiect.',
  },
  {
    title: 'Certificări active',
    body: '4 sisteme de management certificate simultan: ISO 9001, ISO 27001, ISO 14001, ISO 45001.',
  },
  {
    title: 'Un singur interlocutor pe toți cei patru piloni',
    body: 'Indiferent câți piloni combini într-un proiect, ai un singur punct de contact și o coordonare unitară a echipelor.',
  },
  {
    title: 'Evaluare și raportare de securitate',
    body: 'Evaluăm gap-urile de securitate și livrăm rapoarte utile pentru audit și guvernanță.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Servicii Smart Control',
  'description': 'Portofoliu integrat de servicii IT enterprise — infrastructură, securitate, software și servicii gestionate.',
  'url': 'https://smartcontrol.ro/servicii/',
  'numberOfItems': 4,
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'item': {
        '@type': 'Service',
        'name': 'Infrastructură & Cloud',
        'description': 'Data Center Design, Consolidare & Virtualizare, Private Cloud & Hybrid Cloud, Business Continuity & Disaster Recovery.',
        'url': 'https://smartcontrol.ro/servicii/cloud/',
        'provider': { '@type': 'Organization', 'name': 'Smart Control SRL' },
      },
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'item': {
        '@type': 'Service',
        'name': 'Networking & Security',
        'description': 'Perimeter & End-point Security, Enterprise SSO / PKI, security audit reporting and Managed Security Operations.',
        'url': 'https://smartcontrol.ro/servicii/securitate/',
        'provider': { '@type': 'Organization', 'name': 'Smart Control SRL' },
      },
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'item': {
        '@type': 'Service',
        'name': 'Software & Automatizare',
        'description': 'Dezvoltare software custom & API, DevOps / DevSecOps & CI/CD, Migrare și modernizare aplicații, Automatizare cu AI / LLM.',
        'url': 'https://smartcontrol.ro/servicii/software/',
        'provider': { '@type': 'Organization', 'name': 'Smart Control SRL' },
      },
    },
    {
      '@type': 'ListItem',
      'position': 4,
      'item': {
        '@type': 'Service',
        'name': 'Servicii Gestionate',
        'description': 'Managed Infrastructure Operations, Service Desk Outsourcing, Cyber Security Managed Services, Cloud Based System Support.',
        'url': 'https://smartcontrol.ro/servicii/managed/',
        'provider': { '@type': 'Organization', 'name': 'Smart Control SRL' },
      },
    },
  ],
};
---

<BaseLayout
  title="Servicii IT Enterprise — Smart Control"
  description="Portofoliu integrat de servicii IT: Infrastructură & Cloud, Networking & Security, Software & Automatizare și Servicii Gestionate."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <RouteHero eyebrow="SERVICII" artifact="atlas" index="01">
    <h1 slot="title">
      Un portofoliu integrat,<br />
      <span class="accent">de la arhitectura hardware până la nivelul de aplicație.</span>
    </h1>
    <p slot="lead">
      Patru piloni de servicii, susținuți de <strong>50 de specialiști interni</strong> angajați direct de Smart Control. Abordare consultativă, cod sursă inclus pentru fiecare proiect.
    </p>
  </RouteHero>

  <section id="piloni" class="service-atlas scroll-mt-24" aria-labelledby="service-atlas-title">
    <div class="container service-atlas__grid">
      <div class="service-atlas__intro" data-reveal>
        <SectionHeading
          eyebrow="Portofoliu"
          heading="Patru piloni de servicii enterprise"
          headingMaxWidth="680px"
          headingId="service-atlas-title"
        >
          Smart Control acoperă întregul spectru IT enterprise: infrastructură, securitate, software și operare curentă. Fiecare pilon este livrat de echipa internă.
        </SectionHeading>
      </div>

      <div class="service-atlas__frame" data-control-chapter>
        <span class="service-atlas__trunk" aria-hidden="true"></span>
        <ol class="service-atlas__lanes" role="list">
          {pillars.map((pillar) => {
            const PillarIcon = pillar.icon;
            return (
              <li data-chapter-step>
                <ControlLane
                  index={pillar.index}
                  title={pillar.title}
                  body={pillar.body}
                  items={pillar.items}
                  href={pillar.href}
                  linkLabel="Explorează"
                >
                  <PillarIcon slot="icon" class="h-[21px] w-[21px]" stroke-width={1.5} />
                </ControlLane>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>

  <section class="service-proof" aria-labelledby="service-proof-title">
    <div class="container">
      <div class="service-proof__certifications" data-reveal>
        <div class="service-proof__badges">
          <MonoPill>ISO 9001</MonoPill>
          <MonoPill>ISO 27001</MonoPill>
          <MonoPill>ISO 14001</MonoPill>
          <MonoPill>ISO 45001</MonoPill>
        </div>
        <p>Fondată în {FOUNDED}, cu 50 de specialiști interni și peste 500 de ani de experiență cumulată în echipă.</p>
      </div>

      <div class="service-proof__heading" data-reveal>
        <SectionHeading
          heading="Ce primești într-un proiect cu Smart Control"
          headingMaxWidth="640px"
          headingId="service-proof-title"
        />
      </div>
      <ProofLedger entries={accountability} />
    </div>
  </section>

  <CtaBand
    id="contact"
    heading="O evaluare de 2 zile care arată de unde începi"
    cta={t('cta.assessment')}
    subject={t('subject.assessment')}
  >
    Analizăm infrastructura, securitatea, aplicațiile și operarea curentă și recomandăm pilonul cu cel mai mare impact pentru primul proiect.
  </CtaBand>
</BaseLayout>

<style>
  .service-atlas {
    position: relative;
    overflow: clip;
    padding-block: clamp(72px, 9vw, 118px);
    background: var(--color-surface);
  }
  .service-atlas::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent calc(50% - 1px), color-mix(in srgb, var(--color-border-blue) 65%, transparent) 50%, transparent calc(50% + 1px)),
      linear-gradient(180deg, color-mix(in srgb, var(--color-blue-wash) 58%, transparent), transparent 30%);
    content: '';
    pointer-events: none;
  }
  .service-atlas__grid { position: relative; z-index: 1; }
  .service-atlas__intro { max-width: 820px; }
  .service-atlas__frame {
    position: relative;
    margin-top: clamp(42px, 6vw, 72px);
    padding: 12px 0 12px clamp(22px, 4vw, 64px);
    border-block: 1px solid var(--color-border-blue);
  }
  .service-atlas__trunk {
    position: absolute;
    inset: 0 auto 0 28px;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--color-bright) 8%, var(--color-royal) 92%, transparent);
  }
  .service-atlas__trunk::before,
  .service-atlas__trunk::after {
    position: absolute;
    left: -4px;
    width: 9px;
    height: 9px;
    border: 2px solid var(--color-surface);
    border-radius: 50%;
    background: var(--color-bright);
    box-shadow: 0 0 0 1px var(--color-bright);
    content: '';
  }
  .service-atlas__trunk::before { top: 6%; }
  .service-atlas__trunk::after { bottom: 6%; }
  .service-atlas__lanes { margin: 0; padding: 0; list-style: none; }
  .service-atlas__lanes > li { position: relative; }
  .service-atlas__lanes > li::before {
    position: absolute;
    top: 35px;
    right: 100%;
    width: clamp(22px, 4vw, 64px);
    height: 1px;
    background: var(--color-border-blue);
    content: '';
  }
  .service-atlas__lanes > li:nth-child(even) { margin-left: clamp(0px, 4vw, 58px); }

  @media (prefers-reduced-motion: no-preference) {
    .service-atlas__frame[data-scene-step] .service-atlas__lanes > li {
      transition: opacity 320ms ease, transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .service-atlas__frame[data-scene-step] .service-atlas__lanes > li:not([data-active]) { opacity: 0.56; }
    .service-atlas__frame[data-scene-step] .service-atlas__lanes > li[data-current] { transform: translateX(8px); }
  }

  .service-proof {
    padding-block: clamp(64px, 8vw, 104px);
    background: var(--color-page);
  }
  .service-proof__certifications {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.72fr);
    align-items: center;
    gap: 28px;
    padding-block: 22px 28px;
    border-block: 1px solid var(--color-border-blue);
  }
  .service-proof__badges { display: flex; flex-wrap: wrap; gap: 10px; }
  .service-proof__certifications p {
    color: var(--color-cool);
    font-size: 14px;
    line-height: 1.65;
  }
  .service-proof__heading { margin-top: clamp(54px, 7vw, 84px); margin-bottom: 34px; }

  @media (max-width: 767px) {
    .service-atlas__frame { padding-left: 22px; }
    .service-atlas__trunk { left: 7px; }
    .service-atlas__lanes > li:nth-child(even) { margin-left: 0; }
    .service-atlas__lanes > li::before { width: 15px; }
    .service-proof__certifications { grid-template-columns: 1fr; }
  }
</style>
