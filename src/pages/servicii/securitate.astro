---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Eyebrow from '../../components/Eyebrow.astro'; import SectionHeading from '../../components/SectionHeading.astro'; import ModuleCard from '../../components/ModuleCard.astro'; import MonoPill from '../../components/MonoPill.astro'; import CtaBand from '../../components/CtaBand.astro'; import MailtoLink from '../../components/MailtoLink.astro'; import TextLink from '../../components/TextLink.astro'; import { localizedPath,getLangFromUrl,useTranslations } from '../../i18n/ui'; import { DatabaseZap,KeyRound,BadgeCheck,Shield,AppWindow,ScanSearch } from '@lucide/astro'; const lang=getLangFromUrl(Astro.url); const p=(x:string)=>localizedPath(lang,x); const t=useTranslations(lang);
const description='Networking & Security pentru protecția rețelei, prevenirea scurgerilor de date, securitatea identității și operațiuni de securitate gestionate, susținute de patru certificări ISO.'; const ld={'@context':'https://schema.org','@type':'Service',name:'Networking & Security',description,serviceType:'Enterprise Networking and Security Services',url:'https://smartcontrol.ro/servicii/securitate/',provider:{'@type':'Organization',name:'Smart Control SRL',url:'https://smartcontrol.ro'}};
const caps=[{title:'Data Leakage Prevention',body:'Protecția datelor sensibile și vizibilitate asupra transferurilor.',items:['Politici pentru date sensibile','Monitorizare și investigații','Rapoarte pentru audit și investigații'],Icon:DatabaseZap},{title:'Acces Remote Securizat',body:'Acces remote securizat pentru utilizatori și locații, configurat în funcție de politicile și cerințele organizației.',items:['Control centralizat al accesului','Autentificare consolidată','Politici adaptate rolurilor','Administrare și suport'],Icon:KeyRound},{title:'Enterprise SSO & PKI',body:'Control coerent al identității și al accesului în infrastructuri enterprise.',items:['Administrarea identităților','Single sign-on','Certificate și chei'],Icon:BadgeCheck},{title:'Securitate perimetrală & endpoint',body:'Protecție stratificată pentru rețele, stații și servere.',items:['Politici de acces','Protecție endpoint','Evaluarea gap-urilor de securitate'],Icon:Shield},{title:'Web Application Firewall',body:'Protejarea aplicațiilor web și integrare în arhitectura de securitate existentă.',items:['Protecție aplicații web','Reguli adaptate aplicației','Integrare în arhitectura de securitate existentă'],Icon:AppWindow},{title:'Managed Security Operations',body:'Monitorizare și răspuns coordonat la evenimente de securitate.',items:['Monitorizare continuă a evenimentelor de securitate','Analiză și investigație','Răspuns la incidente'],Icon:ScanSearch}];
---
<BaseLayout title="Networking & Security — Smart Control" description={description}><script is:inline type="application/ld+json" set:html={JSON.stringify(ld)}/><header class="bg-page"><div class="container pb-[64px] pt-[120px] md:pt-[120px]"><Eyebrow>Networking &amp; Security</Eyebrow><h1 class="mt-6 max-w-[850px] text-[clamp(2.4rem,1.6rem+3vw,3.75rem)] font-extrabold leading-[1.1] text-midnight">Monitorizăm rețeaua. <span class="text-bright">Alertăm în sub 60 de secunde.</span></h1><p class="mt-6 max-w-[720px] text-[18px] leading-[1.7] text-cool">Acoperim protecția rețelei, prevenirea scurgerilor de date, securitatea identității și operațiuni de securitate gestionate, cu experiență în infrastructuri enterprise și patru certificări ISO.</p><div class="mt-9 flex gap-4"><MailtoLink variant="button" subject={t('subject.assessment')}>{t('cta.assessment')}</MailtoLink><TextLink href="#capabilitati">Vezi capabilitățile</TextLink></div></div></header><section class="bg-surface py-[44px] sm:py-[64px]"><div class="container grid gap-5 md:grid-cols-2"><article class="rounded-xl bg-page p-8"><h2 class="text-[18px] font-bold text-navy">Suprafața de atac se extinde</h2><p class="mt-3 text-[14px] leading-[1.65] text-cool">Infrastructurile distribuite cer vizibilitate și politici coerente.</p></article><article class="rounded-xl bg-page p-8"><h2 class="text-[18px] font-bold text-navy">Răspunsul trebuie coordonat</h2><p class="mt-3 text-[14px] leading-[1.65] text-cool">Echipele au nevoie de informații clare pentru a prioritiza și trata incidentele.</p></article></div></section><section id="capabilitati" class="bg-page py-[56px] sm:py-[80px]"><div class="container"><SectionHeading eyebrow="Capabilități" heading="Șase domenii de Networking & Security"/><div class="mt-9 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{caps.map((c,i)=><ModuleCard title={c.title} index={String(i+1).padStart(2,'0')} body={c.body} items={c.items}><c.Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div></div></section><section class="bg-surface py-[48px] sm:py-[72px]"><div class="container"><SectionHeading eyebrow="Certificări" heading="Patru sisteme de management certificate"/><div class="mt-8 flex flex-wrap gap-3">{['ISO 9001','ISO 27001','ISO 14001','ISO 45001'].map(x=><MonoPill>{x}</MonoPill>)}</div><article class="mt-12 max-w-[760px] rounded-xl bg-page p-8"><h3 class="text-[20px] font-bold text-navy">SEKNET — produs propriu pentru monitorizare și protecție</h3><p class="mt-3 text-[15px] leading-[1.7] text-cool">SEKNET poate completa serviciile de securitate Smart Control. Capabilitățile, integrarea și configurația sunt prezentate în cadrul unei discuții comerciale.</p><div class="mt-5"><TextLink href={p('/solutii/seknet')}>Descoperă SEKNET</TextLink></div></article></div></section><CtaBand heading="Evaluăm arhitectura de securitate" cta={t('cta.assessment')} subject={t('subject.assessment')}>Assessment-ul inițial evidențiază prioritățile tehnice și pașii următori.</CtaBand></BaseLayout>
