---
import BaseLayout from '../../layouts/BaseLayout.astro'; import SectionHeading from '../../components/SectionHeading.astro'; import Eyebrow from '../../components/Eyebrow.astro'; import ModuleCard from '../../components/ModuleCard.astro'; import MailtoLink from '../../components/MailtoLink.astro'; import TextLink from '../../components/TextLink.astro'; import CtaBand from '../../components/CtaBand.astro'; import IconChip from '../../components/IconChip.astro'; import { getLangFromUrl,useTranslations,localizedPath } from '../../i18n/ui'; import { Headset,Server,Network,ShieldCheck,Wrench,Cloud,Bot } from '@lucide/astro'; const lang=getLangFromUrl(Astro.url); const t=useTranslations(lang); const p=(x:string)=>localizedPath(lang,x);
const description='Servicii IT gestionate pentru service desk, infrastructură, rețea, securitate, suport cloud și automatizare software, cu SLA contractual.'; const jsonLd={'@context':'https://schema.org','@type':'Service',name:'Servicii Gestionate — Smart Control',description,url:'https://smartcontrol.ro/servicii/managed/',provider:{'@type':'Organization',name:'Smart Control SRL',url:'https://smartcontrol.ro'},serviceType:'Managed IT Services'};
const caps=[{title:'Service Desk Outsourcing',body:'Operarea completă a suportului pentru utilizatori, cu ținte contractuale de răspuns și rezolvare.',items:['Suport utilizatori L1 / L2 / L3','SLA contractual','Raportare de performanță'],Icon:Headset},{title:'Managed Infrastructure Operations',body:'Operarea și mentenanța proactive ale infrastructurii critice.',items:['Monitorizare continuă','Patch management','Backup și recovery'],Icon:Server},{title:'Network Managed Services',body:'Operarea rețelei cu vizibilitate asupra traficului și incidentelor.',items:['Monitorizarea disponibilității','Gestionarea echipamentelor','Politici de acces'],Icon:Network},{title:'Cyber Security Managed Services',body:'Monitorizare continuă de securitate, detectarea amenințărilor și răspuns la incidente.',items:['Monitorizarea evenimentelor de securitate','Răspuns la incidente','Rapoarte de securitate și audit'],Icon:ShieldCheck},{title:'Outsourced Systems Support',body:'Asistență tehnică on-site și remote în limitele SLA agreat.',items:['Intervenție on-site','Acces remote securizat pentru intervenții','Documentația configurațiilor'],Icon:Wrench},{title:'Cloud Based System Support',body:'Operarea și optimizarea continuă a mediilor cloud.',items:['Operațiuni cloud','Optimizarea resurselor','Suport pentru migrare'],Icon:Cloud},{title:'Software Automation',body:'Automatizarea proceselor repetitive, a integrărilor și a raportării.',items:['Automatizarea fluxurilor','Integrări între sisteme','Procesarea documentelor'],Icon:Bot}];
---
<BaseLayout title="Servicii Gestionate — Smart Control" description={description}><script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}/><header class="bg-page"><div class="container pb-[90px] pt-[150px] md:pt-[190px]"><Eyebrow>Servicii Gestionate</Eyebrow><h1 class="mt-6 text-[clamp(2.5rem,1.7rem+3vw,3.75rem)] font-extrabold leading-[1.1] text-midnight">Infrastructura ta, <span class="text-bright">operată de echipa noastră.</span></h1><p class="mt-6 max-w-[680px] text-[18px] leading-[1.7] text-cool">Preluăm operarea, monitorizarea și securizarea infrastructurii tale IT, cu SLA contractual și experiență în livrarea serviciilor enterprise.</p><div class="mt-9 flex gap-4"><MailtoLink variant="button" subject={t('subject.assessment')}>{t('cta.assessment')}</MailtoLink><TextLink href="#capabilities">Vezi capabilitățile</TextLink></div></div></header><section id="capabilities" class="bg-surface py-[72px] sm:py-[110px]"><div class="container"><SectionHeading eyebrow="Capabilități" heading="Ce acoperă serviciile Smart Control"/><div class="mt-11 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{caps.map((c,i)=><ModuleCard title={c.title} index={String(i+1).padStart(2,'0')} body={c.body} items={c.items}><c.Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div></div></section><section class="bg-page py-[64px] sm:py-[92px]"><div class="container"><SectionHeading heading="Produse proprii pentru contexte de operare gestionată">SEKNET și S-VPN pot completa serviciile gestionate Smart Control. Potrivirea și configurația se stabilesc după analiza mediului clientului.</SectionHeading><div class="mt-10 grid gap-5 md:grid-cols-2">{[{name:'SEKNET',body:'Produs proprietar pentru monitorizarea și protejarea mediilor IT, disponibil ca opțiune în proiectele relevante.',href:'/solutii/seknet',Icon:ShieldCheck},{name:'S-VPN',body:'Produs proprietar pentru acces remote securizat, disponibil ca opțiune în proiectele relevante.',href:'/solutii/s-vpn',Icon:Network}].map(x=><article class="rounded-xl bg-surface p-8 shadow-sm"><div class="flex items-center gap-3"><IconChip><x.Icon class="h-5 w-5 text-navy" stroke-width={1.5}/></IconChip><h3 class="text-[19px] font-bold text-navy">{x.name}</h3></div><p class="mt-4 text-[14px] leading-[1.65] text-cool">{x.body}</p><div class="mt-5"><TextLink href={p(x.href)}>Explorează {x.name}</TextLink></div></article>)}</div></div></section><CtaBand cta={t('cta.assessment')} subject={t('subject.assessment')} showContact={false}/></BaseLayout>
