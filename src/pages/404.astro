---
// Romanian error document. The production server maps unknown non-/en paths
// to this file while preserving the original URL and 404 status. /en/* errors
// use src/pages/en/404.astro. Error-document URLs are deployment internals:
// no canonical, hreflang, alternate or og:url metadata is emitted.
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import TextLink from '../components/TextLink.astro';
---

<BaseLayout
  title="404 — Pagina nu a fost găsită | Smart Control"
  description="Pagina căutată nu există sau a fost mutată."
  noindex
  errorDocument
>
  <section class="px-6 md:px-10" style="background:var(--sc-gradient-hero-light)">
    <div class="mx-auto max-w-[1180px] py-[110px] text-center md:py-[150px]">
      <Eyebrow>Eroare 404</Eyebrow>

      <p
        class="mt-8 font-mono text-[clamp(4.5rem,3rem+6vw,7rem)] font-bold leading-none tracking-[-2px] text-navy"
        aria-hidden="true"
      >
        404
      </p>

      <h1 class="mt-6 text-[clamp(1.75rem,1.45rem+1.3vw,2.375rem)] font-bold leading-[1.15] text-midnight">
        Pagina nu a fost găsită
      </h1>

      <p class="mx-auto mt-5 max-w-[560px] leading-[1.7] text-slate">
        Pagina căutată nu există sau a fost mutată. Verificați adresa sau
        continuați din pagina principală.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-md bg-navy px-6 py-3 text-[14.5px] font-semibold text-white transition-all hover:bg-midnight hover:[box-shadow:0_6px_20px_rgba(14,31,91,0.25)]"
        >
          Înapoi la pagina principală
        </a>
        <TextLink href="/servicii/">Explorează serviciile</TextLink>
      </div>
    </div>
  </section>
</BaseLayout>
