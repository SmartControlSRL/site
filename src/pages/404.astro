---
// 404 — served by the static host for ANY unknown path (RO or EN), so the
// page is bilingual: RO-led message + one EN line, with links to both
// homepages. Chrome (Nav/Footer) resolves RO via getLangFromUrl('/404').
// noindex: error pages have no business in the index.
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import TextLink from '../components/TextLink.astro';
---

<BaseLayout
  title="404 — Pagina nu a fost găsită | Smart Control"
  description="Pagina căutată nu există sau a fost mutată. / The page you are looking for does not exist or has moved."
  noindex
>
  <section class="px-6 md:px-10" style="background:var(--sc-gradient-hero-light)">
    <div class="mx-auto max-w-[1180px] py-[110px] text-center md:py-[150px]">
      <Eyebrow>Eroare 404 — Not Found</Eyebrow>

      <p
        class="mt-8 font-mono text-[clamp(4.5rem,3rem+6vw,7rem)] font-bold leading-none tracking-[-2px] text-navy"
        aria-hidden="true"
      >
        404
      </p>

      <h1 class="mt-6 text-[clamp(1.75rem,1.45rem+1.3vw,2.375rem)] font-bold leading-[1.15] text-midnight">
        Pagina nu a fost găsită
      </h1>

      <p class="mx-auto mt-5 max-w-[560px] leading-[1.7] text-slate">
        Pagina căutată nu există sau a fost mutată. Verificați adresa sau
        continuați din pagina principală.
      </p>
      <p class="mx-auto mt-2 max-w-[560px] leading-[1.7] text-cool" lang="en">
        The page you are looking for does not exist or has moved.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        <TextLink href="/">Pagina principală</TextLink>
        <TextLink href="/en/">English homepage</TextLink>
      </div>
    </div>
  </section>
</BaseLayout>
