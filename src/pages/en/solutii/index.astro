---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import Eyebrow from '../../../components/Eyebrow.astro'; import SectionHeading from '../../../components/SectionHeading.astro'; import TextLink from '../../../components/TextLink.astro'; import CtaBand from '../../../components/CtaBand.astro'; import { localizedPath,getLangFromUrl,useTranslations } from '../../../i18n/ui'; const lang=getLangFromUrl(Astro.url); const p=(x:string)=>localizedPath(lang,x); const t=useTranslations(lang);
const products=[{name:'SEKNET',description:'A proprietary product for monitoring and protecting IT environments.',url:'https://smartcontrol.ro/en/solutii/seknet/'},{name:'S-VPN',description:'A proprietary product for secure remote access.',url:'https://smartcontrol.ro/en/solutii/s-vpn/'}]; const ld={'@context':'https://schema.org','@type':'ItemList',itemListElement:products.map((x,i)=>({'@type':'ListItem',position:i+1,item:{'@type':'Product',name:x.name,url:x.url,description:x.description,brand:{'@type':'Brand',name:'Smart Control'}}}))};
---
<BaseLayout title="Proprietary solutions — SEKNET & S-VPN | Smart Control" description="Proprietary software products for protecting IT environments and secure remote access. SEKNET and S-VPN, developed and supported by Smart Control."><script is:inline type="application/ld+json" set:html={JSON.stringify(ld)}/><header class="bg-page"><div class="container pb-[64px] pt-[120px] md:pt-[120px]"><Eyebrow>Proprietary solutions</Eyebrow><h1 class="mt-6 max-w-[800px] text-[clamp(2.4rem,1.7rem+3vw,3.75rem)] font-extrabold leading-[1.1] text-midnight">Proprietary software, <span class="text-bright">locally supported.</span></h1><p class="mt-6 max-w-[680px] text-[18px] leading-[1.7] text-cool">SEKNET and S-VPN are developed and supported by the Smart Control team. Technical details, delivery options, and commercial terms are available on request.</p></div></header><section class="bg-surface py-[56px] sm:py-[80px]"><div class="container"><SectionHeading heading="Two proprietary products, supported by the same team"/><div class="mt-9 grid gap-5 md:grid-cols-2"><article class="rounded-xl bg-surface p-8 shadow-md"><div class="font-mono text-[11px] uppercase tracking-[1.5px] text-royal">Proprietary product</div><h2 class="mt-2 text-[24px] font-bold text-navy">SEKNET</h2><p class="mt-4 text-[15px] leading-[1.7] text-cool">SEKNET supports unified monitoring and protection of IT environments. The appropriate configuration and capabilities are defined for each organization’s context.</p><div class="mt-6"><TextLink href={p('/solutii/seknet')}>Explore SEKNET</TextLink></div></article><article class="rounded-xl bg-surface p-8 shadow-md"><div class="font-mono text-[11px] uppercase tracking-[1.5px] text-royal">Proprietary product</div><h2 class="mt-2 text-[24px] font-bold text-navy">S-VPN</h2><p class="mt-4 text-[15px] leading-[1.7] text-cool">S-VPN supports secure remote access for organizations. The appropriate configuration and capabilities are defined for each organization’s context.</p><div class="mt-6"><TextLink href={p('/solutii/s-vpn')}>Explore S-VPN</TextLink></div></article></div></div></section><section class="bg-page py-[48px] sm:py-[72px]"><div class="container"><SectionHeading eyebrow="Why proprietary solutions" heading="Integration in your organization’s context"/><article class="mt-9 max-w-[680px] rounded-xl bg-surface p-8 shadow-sm"><h3 class="text-[18px] font-bold text-navy">Native integration</h3><p class="mt-3 text-[15px] leading-[1.7] text-cool">The products are integrated into the customer environment based on requirements validated during the assessment stage.</p></article></div></section><CtaBand heading="Let’s discuss the right product" cta={t('cta.assessment')} subject={t('subject.assessment')}>Mention the product you are interested in — SEKNET or S-VPN — and your message will reach the right team. Details are discussed through a commercial process.</CtaBand></BaseLayout>
