---
// SEKNET — product page. General public content without technical specifications.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import ModuleCard from '../../../components/ModuleCard.astro';
import CtaBand from '../../../components/CtaBand.astro';
import MailtoLink from '../../../components/MailtoLink.astro';
import TextLink from '../../../components/TextLink.astro';
import IconChip from '../../../components/IconChip.astro';
import GridTexture from '../../../components/GridTexture.astro';
import { getLangFromUrl, useTranslations, localizedPath } from '../../../i18n/ui';
import { Activity, ShieldCheck, SlidersHorizontal, Network, Cloud } from '@lucide/astro';
const lang=getLangFromUrl(Astro.url); const t=useTranslations(lang); const p=(path:string)=>localizedPath(lang,path);
const description='SEKNET is a Smart Control solution for operational visibility and IT infrastructure protection, adapted to each organization’s requirements.';
const productLd={'@context':'https://schema.org','@type':'Product',name:'SEKNET',brand:{'@type':'Brand',name:'Smart Control'},category:'IT infrastructure monitoring and protection',description:'Smart Control solution for operational visibility and IT infrastructure protection.',url:'https://smartcontrol.ro/en/solutii/seknet/',manufacturer:{'@type':'Organization',name:'Smart Control SRL'}};
const capabilities=[
 {title:'Operational monitoring',body:'Provides teams with a coherent view of infrastructure health and supports the timely identification of situations that need attention.',Icon:Activity},
 {title:'Integrated protection',body:'Supports risk visibility and the coordination of response activities from a central point.',Icon:ShieldCheck},
 {title:'Centralized control',body:'Brings relevant information together in a clear experience for technical and operational teams.',Icon:SlidersHorizontal},
];
---
<BaseLayout title="SEKNET — Monitoring, security and control | Smart Control" description={description}>
 <script is:inline type="application/ld+json" set:html={JSON.stringify(productLd)}/>
 <header class="relative overflow-hidden bg-midnight"><GridTexture dark/><div class="container relative pb-[100px] pt-[150px] md:pt-[190px]"><Eyebrow variant="dark">Smart Control product</Eyebrow><h1 class="mt-6 max-w-[850px] text-[clamp(2.5rem,1.7rem+3vw,4rem)] font-extrabold leading-[1.08] tracking-[-1.8px] text-white">SEKNET. <span class="text-sky">Monitoring. Security. Control.</span></h1><p class="mt-6 max-w-[650px] text-[18px] leading-[1.7] text-[rgba(226,233,245,.78)]">A unified view of IT infrastructure that helps teams monitor operations, identify risks and coordinate response.</p><div class="mt-9"><MailtoLink variant="button" dark subject={t('subject.demo.seknet')}>{t('cta.demo.seknet')}</MailtoLink></div></div></header>
 <section id="capabilities" class="bg-surface py-[72px] sm:py-[110px]"><div class="container"><SectionHeading heading="Visibility and protection in one unified experience">SEKNET centralizes the information needed to operate and protect IT infrastructure in an experience adapted to the organization’s context.</SectionHeading><div class="mt-11 grid gap-5 md:grid-cols-3">{capabilities.map(({title,body,Icon})=><ModuleCard kicker="SEKNET" title={title} body={body}><Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div></div></section>
 <section class="bg-page py-[64px] sm:py-[92px]"><div class="container"><SectionHeading eyebrow="Other Smart Control solutions" heading="Continue exploring"/><div class="mt-10 grid gap-5 md:grid-cols-2"><article class="rounded-xl bg-surface p-8 shadow-sm"><div class="flex items-center gap-3"><IconChip><Network class="h-5 w-5 text-navy" stroke-width={1.5}/></IconChip><h3 class="text-[19px] font-bold text-navy">S-VPN</h3></div><p class="mt-4 text-[14px] leading-[1.65] text-cool">Smart Control solution for secure remote access, adapted to the organization’s requirements.</p><div class="mt-5"><TextLink href={p('/solutii/s-vpn')}>Explore S-VPN</TextLink></div></article><article class="rounded-xl bg-surface p-8 shadow-sm"><div class="flex items-center gap-3"><IconChip><Cloud class="h-5 w-5 text-navy" stroke-width={1.5}/></IconChip><h3 class="text-[19px] font-bold text-navy">Cloud &amp; Modernization</h3></div><p class="mt-4 text-[14px] leading-[1.65] text-cool">Re-architecture, containerization and selective migration for your organization’s infrastructure and applications.</p><div class="mt-5"><TextLink href={p('/servicii/cloud')}>Explore Cloud &amp; Modernization</TextLink></div></article></div></div></section>
 <CtaBand heading="Let’s discuss your organization’s requirements" cta={t('cta.demo.seknet')} subject={t('subject.demo.seknet')}>We present SEKNET and determine together whether the solution fits your operational context.</CtaBand>
</BaseLayout>
