---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import ModuleCard from '../../../components/ModuleCard.astro';
import CtaBand from '../../../components/CtaBand.astro';
import MailtoLink from '../../../components/MailtoLink.astro';
import TextLink from '../../../components/TextLink.astro';
import IconChip from '../../../components/IconChip.astro';
import GridTexture from '../../../components/GridTexture.astro';
import RouteFlowVisual from '../../../components/RouteFlowVisual.astro';
import { getLangFromUrl, useTranslations, localizedPath } from '../../../i18n/ui';
import { Activity, ShieldCheck, SlidersHorizontal, BellRing, Network, Cloud } from '@lucide/astro';
const lang=getLangFromUrl(Astro.url); const t=useTranslations(lang); const p=(path:string)=>localizedPath(lang,path);
const description='SEKNET is the Smart Control solution for monitoring and protecting IT infrastructure, with operational visibility and centralised control.';
const productLd={'@context':'https://schema.org','@type':'Product',name:'SEKNET',brand:{'@type':'Brand',name:'Smart Control'},category:'IT infrastructure monitoring and protection',description,url:'https://smartcontrol.ro/en/solutii/seknet/',manufacturer:{'@type':'Organization',name:'Smart Control SRL'}};
const capabilities=[
 {title:'Operational monitoring',body:'A coherent view of infrastructure health, helping teams identify situations that require attention sooner.',Icon:Activity},
 {title:'Integrated protection',body:'Relevant events are brought together for analysis and coordinated response from a central point.',Icon:ShieldCheck},
 {title:'Centralised control',body:'Technical information is organised in a unified experience for operational and security roles.',Icon:SlidersHorizontal},
];
const uses=[
 {title:'Visibility across distributed environments',body:'For organisations operating heterogeneous infrastructure that need a shared view of events.'},
 {title:'Alert prioritisation',body:'For teams that need to reduce the time between an event, its analysis and the appropriate action.'},
 {title:'Operational and audit support',body:'For contexts where history, traceability and reporting must be maintained consistently.'},
];
const journey=[
 {label:'Observe',title:'Bring relevant signals together',body:'Visibility is configured for the environment and responsibilities agreed with the organisation.'},
 {label:'Context',title:'Organise operational information',body:'Events are grouped and prioritised for the roles that need to analyse and decide.'},
 {label:'Coordinate',title:'Support the appropriate action',body:'Teams use shared context for investigation, response, and reporting within the agreed process.'},
];
---
<BaseLayout title="SEKNET — Monitoring, security and control | Smart Control" description={description}>
 <script is:inline type="application/ld+json" set:html={JSON.stringify(productLd)}/>
 <header class="relative overflow-hidden bg-midnight"><GridTexture dark/><div class="container relative pb-[88px] pt-[120px] md:pb-[96px] md:pt-[140px]"><Eyebrow variant="dark">Proprietary Smart Control product</Eyebrow><h1 class="mt-6 max-w-[850px] text-[clamp(2.5rem,1.7rem+3vw,4rem)] font-extrabold leading-[1.08] tracking-[-1.8px] text-white">SEKNET. <span class="text-sky">Monitoring. Security. Control.</span></h1><p class="mt-6 max-w-[660px] text-[18px] leading-[1.7] text-[rgba(226,233,245,.78)]">A unified view of IT infrastructure that helps teams monitor operations, identify risks and coordinate response.</p><div class="mt-9 flex flex-wrap items-center gap-5"><MailtoLink variant="button" dark subject={t('subject.demo.seknet')}>{t('cta.demo.seknet')}</MailtoLink><TextLink href="#capabilities" dark>View capabilities</TextLink></div></div></header>
 <RouteFlowVisual id="operational-context" eyebrow="Conceptual context" heading="From signal to operational context" description="A high-level representation of how SEKNET can support team workflows without exposing product architecture, topology, or configuration." caption="This conceptual diagram does not describe data sources, protocols, capacity, vendors, or a client environment. It has been reviewed to avoid sensitive information." steps={journey} surface="page"/>
 <section id="capabilities" class="bg-surface py-[64px] sm:py-[88px]"><div class="container"><SectionHeading eyebrow="The SEKNET platform" heading="Visibility and protection in one unified experience">SEKNET centralises information relevant to operating and protecting IT infrastructure, configured around the organisation’s environment and requirements.</SectionHeading><div class="mt-10 grid gap-5 md:grid-cols-3">{capabilities.map(({title,body,Icon})=><ModuleCard kicker="SEKNET" title={title} body={body}><Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div></div></section>
 <section class="bg-surface py-[56px] sm:py-[80px]"><div class="container"><SectionHeading eyebrow="Use contexts" heading="Where SEKNET adds value"/><div class="mt-10 grid gap-5 md:grid-cols-3">{uses.map(({title,body},i)=><article class="rounded-xl bg-surface p-8 shadow-sm"><div class="flex items-center gap-3"><IconChip><BellRing class="h-5 w-5 text-navy" stroke-width={1.5}/></IconChip><span class="font-mono text-[11px] text-royal">0{i+1}</span></div><h3 class="mt-5 text-[18px] font-bold text-navy">{title}</h3><p class="mt-3 text-[14px] leading-[1.7] text-cool">{body}</p></article>)}</div></div></section>
 <section class="bg-page py-[56px] sm:py-[72px]"><div class="container"><SectionHeading eyebrow="Smart Control ecosystem" heading="Continue exploring"/><div class="mt-10 grid gap-5 md:grid-cols-2"><article class="rounded-xl bg-surface p-8 shadow-sm"><div class="flex items-center gap-3"><IconChip><Network class="h-5 w-5 text-navy" stroke-width={1.5}/></IconChip><h3 class="text-[19px] font-bold text-navy">S-VPN</h3></div><p class="mt-4 text-[14px] leading-[1.65] text-cool">Smart Control solution for secure remote access, adapted to the organisation’s requirements.</p><div class="mt-5"><TextLink href={p('/solutii/s-vpn')}>Explore S-VPN</TextLink></div></article><article class="rounded-xl bg-surface p-8 shadow-sm"><div class="flex items-center gap-3"><IconChip><Cloud class="h-5 w-5 text-navy" stroke-width={1.5}/></IconChip><h3 class="text-[19px] font-bold text-navy">Cloud &amp; Modernisation</h3></div><p class="mt-4 text-[14px] leading-[1.65] text-cool">Re-architecture, containerisation and selective migration for your organisation’s infrastructure and applications.</p><div class="mt-5"><TextLink href={p('/servicii/cloud')}>Explore Cloud &amp; Modernisation</TextLink></div></article></div></div></section>
 <CtaBand heading="See SEKNET in the context of your infrastructure" cta={t('cta.demo.seknet')} subject={t('subject.demo.seknet')}>We present the platform and discuss the requirements, integration and configuration appropriate for your environment.</CtaBand>
</BaseLayout>
