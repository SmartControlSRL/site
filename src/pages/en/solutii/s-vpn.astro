---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import Eyebrow from '../../../components/Eyebrow.astro'; import SectionHeading from '../../../components/SectionHeading.astro'; import ModuleCard from '../../../components/ModuleCard.astro'; import ChevronList from '../../../components/ChevronList.astro'; import CtaBand from '../../../components/CtaBand.astro'; import MailtoLink from '../../../components/MailtoLink.astro'; import GridTexture from '../../../components/GridTexture.astro';
import { getLangFromUrl,useTranslations } from '../../../i18n/ui'; import { KeyRound,SlidersHorizontal,Network } from '@lucide/astro';
const lang=getLangFromUrl(Astro.url); const t=useTranslations(lang);
const description='S-VPN is Smart Control’s solution for secure remote access, simplified administration and adaptation to organisational requirements.';
const productLd={'@context':'https://schema.org','@type':'Product',name:'S-VPN',url:'https://smartcontrol.ro/en/solutii/s-vpn/',brand:{'@type':'Brand',name:'Smart Control'},manufacturer:{'@type':'Organization',name:'Smart Control SRL'},category:'Secure remote access solution',description};
const cards=[{title:'Secure access',body:'Connect users to the resources they need, in line with organisational policies.',Icon:KeyRound},{title:'Simplified administration',body:'Centralised control and operational visibility for the IT team.',Icon:SlidersHorizontal},{title:'Integration with the existing environment',body:'Configuration adapted to existing infrastructure, processes and security requirements.',Icon:Network}];
const includedItems=['Initial assessment and configuration','Integration with the existing environment','Technical assistance','Maintenance and updates'];
const audiences=[['ORGANISATIONS','Organisations that need secure remote access with consistent administration.'],['IT TEAMS','Teams looking to simplify user access administration.'],['REGULATED ENVIRONMENTS','Organisations with demanding control, audit and governance requirements.'],['DISTRIBUTED ENVIRONMENTS','Organisations with distributed users and locations.']];
---
<BaseLayout title="S-VPN — Secure remote access, integrated | Smart Control" description={description}>
 <script is:inline type="application/ld+json" set:html={JSON.stringify(productLd)}/>
 <header class="relative overflow-hidden bg-midnight"><GridTexture dark/><div class="container relative pb-[100px] pt-[150px] md:pt-[190px]"><Eyebrow variant="dark">Proprietary product · Secure remote access</Eyebrow><h1 class="mt-6 text-[clamp(2.5rem,1.7rem+3vw,4rem)] font-extrabold leading-[1.08] tracking-[-1.8px] text-white">S-VPN. <span class="text-sky">Secure remote access.</span></h1><p class="mt-6 max-w-[650px] text-[18px] leading-[1.7] text-[rgba(226,233,245,.78)]">S-VPN gives organisations a secure and straightforward way to connect users to work resources, adapted to their existing infrastructure and policies.</p><div class="mt-9"><MailtoLink variant="button" dark subject={t('subject.demo.svpn')}>{t('cta.demo.svpn')}</MailtoLink></div></div></header>
 <section class="bg-surface py-[72px] sm:py-[110px]"><div class="container"><SectionHeading eyebrow="S-VPN" heading="Remote access adapted to your organisation">A unified approach to secure user connectivity and access administration, configured for each organisation’s environment and requirements.</SectionHeading><div class="mt-11 grid gap-5 md:grid-cols-3">{cards.map(({title,body,Icon})=><ModuleCard kicker="S-VPN" title={title} body={body}><Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div></div></section>
 <section class="bg-page py-[64px] sm:py-[92px]"><div class="container grid gap-12 lg:grid-cols-2"><div><SectionHeading eyebrow="Associated services" heading="Support throughout implementation and operation">The Smart Control team provides the services needed to configure, integrate and use the solution within the organisation’s environment.</SectionHeading><ChevronList items={includedItems} class="mt-7"/></div><div class="grid gap-4 sm:grid-cols-2">{audiences.map(([title,body])=><article class="rounded-xl bg-surface p-6 shadow-sm"><h3 class="font-mono text-[11px] tracking-[1.5px] text-royal">{title}</h3><p class="mt-3 text-[14px] leading-[1.65] text-cool">{body}</p></article>)}</div></div></section>
 <CtaBand heading="Talk to us about S-VPN" cta={t('cta.demo.svpn')} subject={t('subject.demo.svpn')}>We assess your organisation’s context and show how S-VPN can support secure remote access.</CtaBand>
</BaseLayout>
