---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RouteHero from '../../../components/RouteHero.astro';
import ControlArtifact from '../../../components/ControlArtifact.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import ChevronList from '../../../components/ChevronList.astro';
import CtaBand from '../../../components/CtaBand.astro';
import MailtoLink from '../../../components/MailtoLink.astro';
import IconChip from '../../../components/IconChip.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/ui';
import { KeyRound, SlidersHorizontal, Network } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const description = 'S-VPN is Smart Control’s solution for secure remote access, simplified administration and adaptation to organisational requirements.';
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'S-VPN',
  url: 'https://smartcontrol.ro/en/solutii/s-vpn/',
  brand: { '@type': 'Brand', name: 'Smart Control' },
  manufacturer: { '@type': 'Organization', name: 'Smart Control SRL' },
  category: 'Secure remote access solution',
  description,
};

const cards = [
  {
    title: 'Secure access',
    body: 'Connect users to the resources they need, in line with organisational policies.',
    Icon: KeyRound,
  },
  {
    title: 'Simplified administration',
    body: 'Centralised control and operational visibility for the IT team.',
    Icon: SlidersHorizontal,
  },
  {
    title: 'Integration with the existing environment',
    body: 'Configuration adapted to existing infrastructure, processes and security requirements.',
    Icon: Network,
  },
];

const includedItems = [
  'Initial assessment and configuration',
  'Integration with the existing environment',
  'Technical assistance',
  'Maintenance and updates',
];

const audiences = [
  ['ORGANISATIONS', 'Organisations that need secure remote access with consistent administration.'],
  ['IT TEAMS', 'Teams looking to simplify user access administration.'],
  ['REGULATED ENVIRONMENTS', 'Organisations with demanding control, audit and governance requirements.'],
  ['DISTRIBUTED ENVIRONMENTS', 'Organisations with distributed users and locations.'],
];
---

<BaseLayout title="S-VPN — Secure remote access, integrated | Smart Control" description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productLd)} />

  <RouteHero eyebrow="Proprietary product · Secure remote access" artifact="svpn" index="09" dark>
    <h1 slot="title">S-VPN. <span class="accent">Secure remote access.</span></h1>
    <p slot="lead">S-VPN gives organisations a secure and straightforward way to connect users to work resources, adapted to their existing infrastructure and policies.</p>
    <MailtoLink slot="actions" variant="button" dark subject={t('subject.demo.svpn')}>{t('cta.demo.svpn')}</MailtoLink>
  </RouteHero>

  <section class="corridor-section" aria-labelledby="corridor-heading">
    <div class="container">
      <SectionHeading eyebrow="S-VPN" headingId="corridor-heading" heading="Remote access adapted to your organisation">
        A unified approach to secure user connectivity and access administration, configured for each organisation’s environment and requirements.
      </SectionHeading>

      <div class="corridor-path" data-control-scene data-scene-kind="svpn">
        <div class="corridor-path__artifact">
          <ControlArtifact variant="svpn" compact />
        </div>

        <ol class="corridor-path__stages" role="list">
          {cards.map(({ title, body, Icon }, index) => (
            <li>
              <div class="corridor-path__station">
                <IconChip><Icon class="h-[21px] w-[21px] text-navy" stroke-width={1.5} aria-hidden="true" /></IconChip>
                <span><b>S-VPN</b> 0{index + 1}</span>
              </div>
              <h3>{title}</h3>
              <p>{body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="implementation-section" aria-labelledby="implementation-heading">
    <div class="container implementation-section__grid">
      <div class="implementation-section__narrative">
        <SectionHeading
          eyebrow="Associated services"
          headingId="implementation-heading"
          heading="Support throughout implementation and operation"
        >
          The Smart Control team provides the services needed to configure, integrate and use the solution within the organisation’s environment.
        </SectionHeading>

        <div class="implementation-section__list">
          <ChevronList items={includedItems} />
        </div>
      </div>

      <div class="audience-matrix">
        {audiences.map(([title, body], index) => (
          <article>
            <span class="audience-matrix__index">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
        <span class="audience-matrix__axis audience-matrix__axis--x" aria-hidden="true"></span>
        <span class="audience-matrix__axis audience-matrix__axis--y" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Talk to us about S-VPN"
    cta={t('cta.demo.svpn')}
    subject={t('subject.demo.svpn')}
  >
    We assess your organisation’s context and show how S-VPN can support secure remote access.
  </CtaBand>
</BaseLayout>

<style>
  .corridor-section {
    overflow: clip;
    padding-block: clamp(68px, 8vw, 104px);
    background: var(--color-surface);
  }

  .corridor-path {
    position: relative;
    margin-top: 46px;
    border-block: 1px solid var(--color-border-blue);
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-blue-wash) 52%, transparent), transparent 65%);
  }

  .corridor-path__artifact {
    width: min(780px, 82%);
    margin-inline: auto;
    padding: 10px 0 4px;
  }

  .corridor-path__stages {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border-blue);
    list-style: none;
  }

  .corridor-path__stages::before {
    position: absolute;
    top: -1px;
    right: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-bright) 12%, var(--color-bright) 88%, transparent);
    opacity: 0.68;
    content: '';
  }

  .corridor-path__stages li {
    position: relative;
    min-width: 0;
    padding: 29px clamp(20px, 3vw, 34px) 34px;
  }

  .corridor-path__stages li + li {
    border-left: 1px solid var(--color-border-blue);
  }

  .corridor-path__stages li::before {
    position: absolute;
    top: -5px;
    left: clamp(20px, 3vw, 34px);
    width: 9px;
    height: 9px;
    border: 2px solid var(--color-surface);
    border-radius: 50%;
    background: var(--color-bright);
    box-shadow: 0 0 0 1px var(--color-bright);
    content: '';
  }

  .corridor-path__station {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .corridor-path__station > span {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--color-royal);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
  }

  .corridor-path__station b {
    font-weight: 500;
  }

  .corridor-path__stages h3 {
    margin-top: 19px;
    color: var(--color-navy);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
  }

  .corridor-path__stages p {
    margin-top: 10px;
    color: var(--color-cool);
    font-size: 14px;
    line-height: 1.7;
  }

  .implementation-section {
    padding-block: clamp(64px, 7.5vw, 96px);
    background: var(--color-page);
  }

  .implementation-section__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(420px, 1.12fr);
    align-items: start;
    gap: clamp(52px, 8vw, 108px);
  }

  .implementation-section__narrative {
    min-width: 0;
  }

  .implementation-section__list {
    position: relative;
    margin-top: 30px;
    padding: 24px 22px 24px 34px;
    border-block: 1px solid var(--color-border-blue);
    background: color-mix(in srgb, var(--color-surface) 64%, transparent);
  }

  .implementation-section__list::before {
    position: absolute;
    inset: 0 auto 0 12px;
    width: 1px;
    background: var(--color-bright);
    opacity: 0.55;
    content: '';
  }

  .audience-matrix {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-width: 0;
    border-block: 1px solid var(--color-border-blue);
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
  }

  .audience-matrix article {
    position: relative;
    min-height: 184px;
    padding: 26px 27px 30px;
  }

  .audience-matrix article:nth-child(odd) {
    border-right: 1px solid var(--color-border-blue);
  }

  .audience-matrix article:nth-child(-n + 2) {
    border-bottom: 1px solid var(--color-border-blue);
  }

  .audience-matrix__index {
    position: absolute;
    top: 15px;
    right: 17px;
    color: var(--color-royal);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.13em;
  }

  .audience-matrix h3 {
    max-width: calc(100% - 28px);
    color: var(--color-royal);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    line-height: 1.45;
  }

  .audience-matrix p {
    margin-top: 18px;
    color: var(--color-cool);
    font-size: 14px;
    line-height: 1.68;
  }

  .audience-matrix__axis {
    position: absolute;
    z-index: 2;
    display: block;
    width: 11px;
    height: 11px;
    border: 3px solid var(--color-page);
    border-radius: 50%;
    background: var(--color-bright);
    box-shadow: 0 0 0 1px var(--color-bright);
  }

  .audience-matrix__axis--x {
    top: 50%;
    left: -5px;
    transform: translateY(-50%);
  }

  .audience-matrix__axis--y {
    top: -5px;
    left: 50%;
    transform: translateX(-50%);
  }

  @media (max-width: 900px) {
    .implementation-section__grid {
      grid-template-columns: 1fr;
      gap: 46px;
    }
  }

  @media (max-width: 767px) {
    .corridor-path__artifact {
      width: 100%;
    }

    .corridor-path__stages {
      grid-template-columns: 1fr;
    }

    .corridor-path__stages li + li {
      border-top: 1px solid var(--color-border-blue);
      border-left: 0;
    }

    .corridor-path__stages li::before {
      left: 0;
    }

    .audience-matrix {
      grid-template-columns: 1fr;
    }

    .audience-matrix article {
      min-height: 0;
      padding-inline: 20px;
    }

    .audience-matrix article:nth-child(odd) {
      border-right: 0;
    }

    .audience-matrix article:nth-child(-n + 3) {
      border-bottom: 1px solid var(--color-border-blue);
    }

    .audience-matrix__axis--y {
      left: 0;
    }
  }
</style>
