---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import Eyebrow from '../../../components/Eyebrow.astro'; import SectionHeading from '../../../components/SectionHeading.astro'; import ModuleCard from '../../../components/ModuleCard.astro'; import MonoPill from '../../../components/MonoPill.astro'; import CtaBand from '../../../components/CtaBand.astro'; import MailtoLink from '../../../components/MailtoLink.astro'; import TextLink from '../../../components/TextLink.astro'; import { localizedPath,getLangFromUrl,useTranslations } from '../../../i18n/ui'; import { DatabaseZap,KeyRound,BadgeCheck,Shield,AppWindow,ScanSearch } from '@lucide/astro'; const lang=getLangFromUrl(Astro.url); const p=(x:string)=>localizedPath(lang,x); const t=useTranslations(lang);
const description='Networking & Security for network protection, data leakage prevention, identity security and managed security operations, backed by four ISO certifications.'; const ld={'@context':'https://schema.org','@type':'Service',name:'Networking & Security',description,serviceType:'Enterprise Networking and Security Services',url:'https://smartcontrol.ro/en/servicii/securitate/',provider:{'@type':'Organization',name:'Smart Control SRL',url:'https://smartcontrol.ro'}}; const caps=[{title:'Data Leakage Prevention',body:'Sensitive-data protection and visibility across transfers.',items:['Sensitive-data policies','Monitoring and investigations','Reports for audits and investigations'],Icon:DatabaseZap},{title:'Secure Remote Access',body:'Secure remote access for users and locations, configured around the organization’s policies and requirements.',items:['Centralized access control','Strengthened authentication','Role-based policies','Administration and support'],Icon:KeyRound},{title:'Enterprise SSO & PKI',body:'Consistent identity and access control across enterprise infrastructure.',items:['Identity administration','Single sign-on','Certificates and keys'],Icon:BadgeCheck},{title:'Perimeter & endpoint security',body:'Layered protection for networks, workstations and servers.',items:['Access policies','Endpoint protection','Security gap assessment'],Icon:Shield},{title:'Web Application Firewall',body:'Web application protection and integration with the existing security architecture.',items:['Web application protection','Application-specific rules','Integration with the existing security architecture'],Icon:AppWindow},{title:'Managed Security Operations',body:'Coordinated monitoring and response for security events.',items:['Continuous security event monitoring','Analysis and investigation','Incident response'],Icon:ScanSearch}];
---
<BaseLayout title="Networking & Security — Smart Control" description={description}><script is:inline type="application/ld+json" set:html={JSON.stringify(ld)}/><header class="bg-page"><div class="container pb-[90px] pt-[150px] md:pt-[190px]"><Eyebrow>Networking &amp; Security</Eyebrow><h1 class="mt-6 max-w-[850px] text-[clamp(2.4rem,1.6rem+3vw,3.75rem)] font-extrabold leading-[1.1] text-midnight">We monitor the network. <span class="text-bright">We alert in under 60 seconds.</span></h1><p class="mt-6 max-w-[720px] text-[18px] leading-[1.7] text-cool">We cover network protection, data leakage prevention, identity security and managed security operations, with enterprise infrastructure experience and four ISO certifications.</p><div class="mt-9 flex gap-4"><MailtoLink variant="button" subject={t('subject.assessment')}>{t('cta.assessment')}</MailtoLink><TextLink href="#capabilities">View capabilities</TextLink></div></div></header><section class="bg-surface py-[56px] sm:py-[84px]"><div class="container grid gap-5 md:grid-cols-2"><article class="rounded-xl bg-page p-8"><h2 class="text-[18px] font-bold text-navy">The attack surface is expanding</h2><p class="mt-3 text-[14px] leading-[1.65] text-cool">Distributed infrastructure requires visibility and consistent policies.</p></article><article class="rounded-xl bg-page p-8"><h2 class="text-[18px] font-bold text-navy">Response must be coordinated</h2><p class="mt-3 text-[14px] leading-[1.65] text-cool">Teams need clear information to prioritize and handle incidents.</p></article></div></section><section id="capabilities" class="bg-page py-[72px] sm:py-[110px]"><div class="container"><SectionHeading eyebrow="Capabilities" heading="Six Networking & Security domains"/><div class="mt-11 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{caps.map((c,i)=><ModuleCard title={c.title} index={String(i+1).padStart(2,'0')} body={c.body} items={c.items}><c.Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div></div></section><section class="bg-surface py-[64px] sm:py-[92px]"><div class="container"><SectionHeading eyebrow="Certifications" heading="Four certified management systems"/><div class="mt-8 flex flex-wrap gap-3">{['ISO 9001','ISO 27001','ISO 14001','ISO 45001'].map(x=><MonoPill>{x}</MonoPill>)}</div><article class="mt-12 max-w-[760px] rounded-xl bg-page p-8"><h3 class="text-[20px] font-bold text-navy">SEKNET — proprietary product for monitoring and protection</h3><p class="mt-3 text-[15px] leading-[1.7] text-cool">SEKNET can complement Smart Control security services. Capabilities, integration, and configuration are presented through a commercial discussion.</p><div class="mt-5"><TextLink href={p('/solutii/seknet')}>Discover SEKNET</TextLink></div></article></div></section><CtaBand heading="Assess your security architecture" cta={t('cta.assessment')} subject={t('subject.assessment')}>The initial assessment highlights technical priorities and next steps.</CtaBand></BaseLayout>
