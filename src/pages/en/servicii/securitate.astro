---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import MonoPill from '../../../components/MonoPill.astro';
import CtaBand from '../../../components/CtaBand.astro';
import MailtoLink from '../../../components/MailtoLink.astro';
import TextLink from '../../../components/TextLink.astro';
import RouteHero from '../../../components/RouteHero.astro';
import ControlLane from '../../../components/ControlLane.astro';
import { localizedPath, getLangFromUrl, useTranslations } from '../../../i18n/ui';
import { DatabaseZap, KeyRound, BadgeCheck, Shield, AppWindow, ScanSearch } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const p = (path: string) => localizedPath(lang, path);
const t = useTranslations(lang);

const description = 'Networking & Security for network protection, data leakage prevention, identity security and managed security operations, backed by four ISO certifications.';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Networking & Security',
  description,
  serviceType: 'Enterprise Networking and Security Services',
  url: 'https://smartcontrol.ro/en/servicii/securitate/',
  provider: { '@type': 'Organization', name: 'Smart Control SRL', url: 'https://smartcontrol.ro' },
};

const caps = [
  {
    title: 'Data Leakage Prevention',
    body: 'Sensitive-data protection and visibility across transfers.',
    items: ['Sensitive-data policies', 'Monitoring and investigations', 'Reports for audits and investigations'],
    Icon: DatabaseZap,
  },
  {
    title: 'Secure Remote Access',
    body: 'Secure remote access for users and locations, configured around the organization’s policies and requirements.',
    items: ['Centralized access control', 'Strengthened authentication', 'Role-based policies', 'Administration and support'],
    Icon: KeyRound,
  },
  {
    title: 'Enterprise SSO & PKI',
    body: 'Consistent identity and access control across enterprise infrastructure.',
    items: ['Identity administration', 'Single sign-on', 'Certificates and keys'],
    Icon: BadgeCheck,
  },
  {
    title: 'Perimeter & endpoint security',
    body: 'Layered protection for networks, workstations and servers.',
    items: ['Access policies', 'Endpoint protection', 'Security gap assessment'],
    Icon: Shield,
  },
  {
    title: 'Web Application Firewall',
    body: 'Web application protection and integration with the existing security architecture.',
    items: ['Web application protection', 'Application-specific rules', 'Integration with the existing security architecture'],
    Icon: AppWindow,
  },
  {
    title: 'Managed Security Operations',
    body: 'Coordinated monitoring and response for security events.',
    items: ['Continuous security event monitoring', 'Analysis and investigation', 'Incident response'],
    Icon: ScanSearch,
  },
];
---

<BaseLayout title="Networking & Security — Smart Control" description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />

  <RouteHero eyebrow="Networking &amp; Security" artifact="security" index="03">
    <h1 slot="title">We monitor the network. <span class="accent">We alert in under 60 seconds.</span></h1>
    <p slot="lead">
      We cover network protection, data leakage prevention, identity security and managed security operations, with enterprise infrastructure experience and four ISO certifications.
    </p>
    <Fragment slot="actions">
      <MailtoLink variant="button" subject={t('subject.assessment')}>{t('cta.assessment')}</MailtoLink>
      <TextLink href="#capabilities">View capabilities</TextLink>
    </Fragment>
  </RouteHero>

  <section class="security-context" aria-label="Networking & Security">
    <div class="container security-context__grid">
      <article data-reveal>
        <span aria-hidden="true">01</span>
        <h2>The attack surface is expanding</h2>
        <p>Distributed infrastructure requires visibility and consistent policies.</p>
      </article>
      <article data-reveal>
        <span aria-hidden="true">02</span>
        <h2>Response must be coordinated</h2>
        <p>Teams need clear information to prioritize and handle incidents.</p>
      </article>
    </div>
  </section>

  <section id="capabilities" class="security-perimeter scroll-mt-24" aria-labelledby="security-perimeter-title">
    <div class="container">
      <div class="security-perimeter__heading" data-reveal>
        <SectionHeading
          eyebrow="Capabilities"
          heading="Six Networking & Security domains"
          headingId="security-perimeter-title"
        />
      </div>

      <div class="security-perimeter__frame" data-control-chapter data-scene-kind="security">
        <span class="security-perimeter__datum" aria-hidden="true"></span>
        <ol class="security-perimeter__layers" role="list">
          {caps.map(({ title, body, items, Icon }, index) => (
            <li data-chapter-step>
              <ControlLane
                index={String(index + 1).padStart(2, '0')}
                title={title}
                body={body}
                items={items}
              >
                <Icon slot="icon" class="h-[21px] w-[21px]" stroke-width={1.5} />
              </ControlLane>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="security-assurance" aria-labelledby="security-assurance-title">
    <div class="container security-assurance__grid">
      <div class="security-assurance__certifications">
        <SectionHeading
          eyebrow="Certifications"
          heading="Four certified management systems"
          headingId="security-assurance-title"
        />
        <div class="security-assurance__badges">
          {['ISO 9001', 'ISO 27001', 'ISO 14001', 'ISO 45001'].map((item) => <MonoPill>{item}</MonoPill>)}
        </div>
      </div>

      <article class="security-assurance__endpoint">
        <span class="security-assurance__node" aria-hidden="true"></span>
        <h3>SEKNET — proprietary product for monitoring and protection</h3>
        <p>SEKNET can complement Smart Control security services. Capabilities, integration, and configuration are presented through a commercial discussion.</p>
        <TextLink href={p('/solutii/seknet')}>Discover SEKNET</TextLink>
      </article>
    </div>
  </section>

  <CtaBand heading="Assess your security architecture" cta={t('cta.assessment')} subject={t('subject.assessment')}>
    The initial assessment highlights technical priorities and next steps.
  </CtaBand>
</BaseLayout>

<style>
  .security-context { padding-block: clamp(38px, 5vw, 64px); background: var(--color-surface); }
  .security-context__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--color-border-blue);
  }
  .security-context article {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 10px 18px;
    padding: 30px clamp(20px, 4vw, 48px) 32px 0;
  }
  .security-context article + article { padding-left: clamp(20px, 4vw, 48px); border-left: 1px solid var(--color-border-blue); }
  .security-context article > span { grid-row: 1 / 3; color: var(--color-royal); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; }
  .security-context h2 { color: var(--color-navy); font-size: clamp(1.05rem, 0.96rem + 0.45vw, 1.3rem); font-weight: 700; }
  .security-context p { color: var(--color-cool); font-size: 14px; line-height: 1.65; }

  .security-perimeter {
    position: relative;
    overflow: clip;
    padding-block: clamp(72px, 9vw, 112px);
    background: var(--color-page);
  }
  .security-perimeter::before {
    position: absolute;
    inset: 10% max(18px, calc((100vw - 1240px) / 2)) 8%;
    border: 1px solid color-mix(in srgb, var(--color-royal) 10%, transparent);
    border-radius: 34px;
    content: '';
    pointer-events: none;
  }
  .security-perimeter__heading { position: relative; z-index: 1; }
  .security-perimeter__frame {
    position: relative;
    z-index: 1;
    margin-top: clamp(44px, 6vw, 74px);
    padding-block: 24px;
  }
  .security-perimeter__datum {
    position: absolute;
    inset: 0 50% 0 auto;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--color-bright) 12%, var(--color-royal) 88%, transparent);
  }
  .security-perimeter__layers { margin: 0; padding: 0; list-style: none; }
  .security-perimeter__layers > li {
    position: relative;
    margin-inline: var(--perimeter-inset, 0);
    border-inline: 1px solid color-mix(in srgb, var(--color-royal) 10%, transparent);
  }
  .security-perimeter__layers > li:nth-child(1) { --perimeter-inset: 0; }
  .security-perimeter__layers > li:nth-child(2) { --perimeter-inset: 18px; }
  .security-perimeter__layers > li:nth-child(3) { --perimeter-inset: 36px; }
  .security-perimeter__layers > li:nth-child(4) { --perimeter-inset: 54px; }
  .security-perimeter__layers > li:nth-child(5) { --perimeter-inset: 72px; }
  .security-perimeter__layers > li:nth-child(6) { --perimeter-inset: 90px; }

  @media (prefers-reduced-motion: no-preference) {
    .security-perimeter__frame[data-scene-step] .security-perimeter__layers > li {
      transition: opacity 320ms ease, transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .security-perimeter__frame[data-scene-step] .security-perimeter__layers > li:not([data-active]) { opacity: 0.55; }
    .security-perimeter__frame[data-scene-step] .security-perimeter__layers > li[data-current] { transform: scale(1.012); }
  }

  .security-assurance { padding-block: clamp(64px, 8vw, 104px); background: var(--color-surface); }
  .security-assurance__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    align-items: end;
    gap: clamp(44px, 7vw, 88px);
  }
  .security-assurance__badges { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  .security-assurance__endpoint {
    position: relative;
    padding: clamp(28px, 4vw, 44px);
    border-block: 1px solid var(--color-border-blue);
    background: linear-gradient(90deg, var(--color-blue-wash), transparent);
  }
  .security-assurance__endpoint::before { position: absolute; inset: 0 auto 0 0; width: 2px; background: var(--color-bright); content: ''; }
  .security-assurance__endpoint h3 { color: var(--color-navy); font-size: clamp(1.15rem, 1rem + 0.65vw, 1.45rem); font-weight: 700; line-height: 1.35; }
  .security-assurance__endpoint p { margin-block: 14px 20px; color: var(--color-cool); font-size: 14.5px; line-height: 1.72; }
  .security-assurance__node { position: absolute; top: -5px; left: -4px; width: 9px; height: 9px; border: 2px solid var(--color-surface); border-radius: 50%; background: var(--color-bright); box-shadow: 0 0 0 1px var(--color-bright); }

  @media (max-width: 767px) {
    .security-context__grid,
    .security-assurance__grid { grid-template-columns: 1fr; }
    .security-context article + article { padding-left: 0; border-top: 1px solid var(--color-border-blue); border-left: 0; }
    .security-perimeter__layers > li { margin-inline: 0; }
  }
</style>
