---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import GridTexture from '../../../components/GridTexture.astro'; import Eyebrow from '../../../components/Eyebrow.astro'; import SectionHeading from '../../../components/SectionHeading.astro'; import ChevronList from '../../../components/ChevronList.astro'; import CtaBand from '../../../components/CtaBand.astro'; import MailtoLink from '../../../components/MailtoLink.astro'; import TextLink from '../../../components/TextLink.astro'; import { getLangFromUrl,useTranslations } from '../../../i18n/ui'; import { Container,GitBranch,Cloud,Gauge } from '@lucide/astro'; const lang=getLangFromUrl(Astro.url); const t=useTranslations(lang);
const description='Hardware is getting more expensive. We propose an application re-architecture, containerization and selective cloud migration approach for performance and predictable costs.'; const steps=[{title:'Re-architecture proposal',pill:'Fast Track',body:'For established clients, we use our knowledge of the existing infrastructure to identify critical points and propose modernization based on real data.'},{title:'Initial assessment & quick wins',pill:'2 days · free',body:'Infrastructure inventory, performance analysis and gap assessment.'},{title:'Refactoring plan',pill:'Technical plan',body:'A technical roadmap with application prioritization, staging tests and a rollback plan.'},{title:'Agile implementation & knowledge transfer',pill:'DevSecOps',body:'Containerization and migration, delivery pipelines, hybrid integration, technical workshops and documentation.'},{title:'Continuous monitoring and optimization',pill:'Proposed indicators',body:'Proactive monitoring and optimization to achieve the proposed indicators.'}]; const caps=[{title:'Containerization & orchestration',items:['Application prioritization','Controlled migration','Planned rollback'],Icon:Container},{title:'DevSecOps & CI/CD',items:['Delivery pipelines','Automated staging tests','Infrastructure-as-Code'],Icon:GitBranch},{title:'Hybrid integration',items:['On-premise and cloud integration','Selective migration','Predictable costs'],Icon:Cloud},{title:'Monitoring & support',items:['Proactive support','Continuous monitoring','Tracking proposed indicators'],Icon:Gauge}]; const ld={'@context':'https://schema.org','@type':'Service',name:'Cloud & Modernization',serviceType:'Cloud modernization & application re-architecture',url:'https://smartcontrol.ro/en/servicii/cloud/',description:'Application re-architecture and optimization, containerization, DevSecOps and selective cloud migration through a five-stage approach.',provider:{'@type':'Organization',name:'Smart Control SRL',url:'https://smartcontrol.ro'}};
---
<BaseLayout title="Cloud & Modernization — Application re-architecture and optimization | Smart Control" description={description}><script is:inline type="application/ld+json" set:html={JSON.stringify(ld)}/><header class="relative overflow-hidden bg-page"><GridTexture fade/><div class="container relative pb-[64px] pt-[120px] md:pt-[120px]"><Eyebrow>Cloud &amp; Modernization</Eyebrow><h1 class="mt-6 max-w-[900px] text-[clamp(2.4rem,1.6rem+3vw,3.75rem)] font-extrabold leading-[1.1] text-midnight">Hardware is getting more expensive.<br/><span class="text-bright">We propose the following approach.</span></h1><p class="mt-6 max-w-[680px] text-[18px] leading-[1.7] text-cool">Critical component prices are rising under pressure from AI infrastructure demand. Application re-architecture and optimization help you obtain more performance from existing infrastructure before buying new hardware.</p><div class="mt-9 flex gap-4"><MailtoLink variant="button" subject={t('subject.assessment')}>Schedule the free assessment</MailtoLink><TextLink href="#workflow">See the 5 stages</TextLink></div></div></header><section id="workflow" class="bg-page py-[56px] sm:py-[80px]"><div class="container"><SectionHeading eyebrow="Approach" heading="We propose 5 stages"/><div class="relative mt-12" data-stepper><div class="absolute bottom-7 left-[25px] top-7 w-[2px] bg-border-blue"><div data-stepper-fill class="h-0 w-full bg-bright"/></div><ol class="relative">{steps.map((s,i)=><li data-step class="grid grid-cols-[52px_1fr] gap-5 py-6"><span data-step-dot class="flex h-[52px] w-[52px] items-center justify-center rounded-[12px] border border-border-blue bg-surface font-mono text-royal">{String(i+1).padStart(2,'0')}</span><div data-step-body><div class="flex flex-wrap items-center gap-3"><h3 class="text-[20px] font-bold text-navy">{s.title}</h3><span class="rounded-full border border-border-blue px-3 py-1 font-mono text-[11px] text-royal">{s.pill}</span></div><p class="mt-2 text-[14.5px] leading-[1.7] text-cool">{s.body}</p></div></li>)}</ol></div></div></section><section class="bg-surface py-[48px] sm:py-[72px]"><div class="container"><SectionHeading heading="What we deliver"/><div class="mt-10 grid gap-5 md:grid-cols-2">{caps.map(c=><article class="rounded-xl bg-surface p-8 shadow-sm"><div class="flex items-center gap-3"><c.Icon class="h-5 w-5 text-bright" stroke-width={1.5}/><h3 class="text-[18px] font-bold text-navy">{c.title}</h3></div><ChevronList items={c.items} class="mt-4"/></article>)}</div></div></section><CtaBand heading="What does your current infrastructure cost and how much could you save" cta={t('cta.assessment')} subject={t('subject.assessment')}>The free 2-day assessment maps your current infrastructure and estimates the potential savings from re-architecture.</CtaBand></BaseLayout>
