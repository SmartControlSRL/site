---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import GridTexture from '../../../components/GridTexture.astro'; import Eyebrow from '../../../components/Eyebrow.astro'; import SectionHeading from '../../../components/SectionHeading.astro'; import ChevronList from '../../../components/ChevronList.astro'; import CtaBand from '../../../components/CtaBand.astro'; import MailtoLink from '../../../components/MailtoLink.astro'; import TextLink from '../../../components/TextLink.astro'; import { getLangFromUrl,useTranslations } from '../../../i18n/ui'; import { Container,GitBranch,Cloud,Gauge } from '@lucide/astro'; const lang=getLangFromUrl(Astro.url); const t=useTranslations(lang);
const description='Hardware is getting more expensive. We propose an application re-architecture, containerisation and selective cloud migration approach for performance and predictable costs.'; const steps=[{title:'Initial assessment & quick wins',pill:'Initial assessment',body:'Infrastructure inventory, performance analysis, and gap assessment.'},{title:'Target re-architecture design',pill:'Architecture',body:'Define the target architecture and prioritise changes using data gathered during the assessment.'},{title:'Containerisation & delivery preparation',pill:'DevSecOps',body:'Refactoring, containerisation, delivery pipelines, staging tests, and a rollback plan.'},{title:'Controlled migration & knowledge transfer',pill:'Implementation',body:'Selective migration, hybrid integration, validated change windows, workshops, and documentation.'},{title:'Validation & continuous optimisation',pill:'Agreed indicators',body:'Measure outcomes and continuously optimise against the indicators agreed for the project.'}]; const caps=[{title:'Containerisation & orchestration',items:['Application prioritisation','Controlled migration','Planned rollback'],Icon:Container},{title:'DevSecOps & CI/CD',items:['Delivery pipelines','Automated staging tests','Infrastructure-as-Code'],Icon:GitBranch},{title:'Hybrid integration',items:['On-premise and cloud integration','Selective migration','Predictable costs'],Icon:Cloud},{title:'Monitoring & support',items:['Proactive support','Continuous monitoring','Tracking agreed indicators'],Icon:Gauge}]; const ld={'@context':'https://schema.org','@type':'Service',name:'Cloud & Modernisation',serviceType:'Cloud modernisation & application re-architecture',url:'https://smartcontrol.ro/en/servicii/cloud/',description:'Application re-architecture and optimisation, containerisation, DevSecOps, and selective cloud migration through a five-stage approach.',provider:{'@type':'Organization',name:'Smart Control SRL',url:'https://smartcontrol.ro'}};
---
<BaseLayout title="Cloud & Modernisation — Re-architecture | Smart Control" description={description}><script is:inline type="application/ld+json" set:html={JSON.stringify(ld)}/><header class="relative overflow-hidden bg-page"><GridTexture fade/><div class="container relative pb-[64px] pt-[120px]"><Eyebrow>Cloud &amp; Modernisation</Eyebrow><h1 class="mt-6 max-w-[900px] text-[clamp(2.4rem,1.6rem+3vw,3.75rem)] font-extrabold leading-[1.1] text-midnight">Hardware is getting more expensive.<br/><span class="text-bright">We propose the following approach.</span></h1><p class="mt-6 max-w-[680px] text-[18px] leading-[1.7] text-cool">Critical component prices are rising under pressure from AI infrastructure demand. Application re-architecture and optimisation help obtain more performance from existing infrastructure before buying new hardware.</p><div data-service-hero-actions class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap sm:items-center"><MailtoLink variant="button" subject={t('subject.assessment')}>{t('cta.assessment')}</MailtoLink><TextLink href="#workflow">See the 5 stages</TextLink></div></div></header><section id="workflow" data-route-visual class="bg-page py-[56px] sm:py-[80px]"><div class="container"><SectionHeading eyebrow="Approach" heading="We propose 5 stages">For clients whose technical context is already understood, a re-architecture proposal can follow a Fast Track path. This is optional, not a universal stage, and does not replace validation of the input data.</SectionHeading><div class="relative mt-12" data-stepper><div class="absolute bottom-7 left-[25px] top-7 w-[2px] bg-border-blue"><div data-stepper-fill class="h-0 w-full bg-bright"/></div><ol class="relative">{steps.map((s,i)=><li data-step class="grid grid-cols-[52px_1fr] gap-5 py-6"><span data-step-dot class="flex h-[52px] w-[52px] items-center justify-center rounded-[12px] border border-border-blue bg-surface font-mono text-royal">{String(i+1).padStart(2,'0')}</span><div data-step-body><div class="flex flex-wrap items-center gap-3"><h3 class="text-[20px] font-bold text-navy">{s.title}</h3><span class="rounded-full border border-border-blue px-3 py-1 font-mono text-[11px] text-royal">{s.pill}</span></div><p class="mt-2 text-[14.5px] leading-[1.7] text-slate">{s.body}</p></div></li>)}</ol></div><p class="mt-6 max-w-[820px] text-[13.5px] leading-[1.7] text-slate">This methodology is a delivery framework, not a promise of schedule, savings, or outcome. Scope and indicators are agreed for each project.</p></div></section><section class="bg-surface py-[48px] sm:py-[72px]"><div class="container"><SectionHeading heading="What we deliver"/><div class="mt-10 grid gap-5 md:grid-cols-2">{caps.map(c=><article class="rounded-xl bg-surface p-8 shadow-sm"><div class="flex items-center gap-3"><c.Icon class="h-5 w-5 text-bright" stroke-width={1.5}/><h3 class="text-[18px] font-bold text-navy">{c.title}</h3></div><ChevronList items={c.items} class="mt-4"/></article>)}</div></div></section><CtaBand id="contact" heading="What does your current infrastructure cost and where could it be optimised" cta={t('cta.assessment')} subject={t('subject.assessment')}>The initial assessment is configured around your infrastructure, objectives, and agreed scope. Deliverables and terms are confirmed before work begins.</CtaBand></BaseLayout>
