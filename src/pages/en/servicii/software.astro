---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import Eyebrow from '../../../components/Eyebrow.astro'; import SectionHeading from '../../../components/SectionHeading.astro'; import ModuleCard from '../../../components/ModuleCard.astro'; import CtaBand from '../../../components/CtaBand.astro'; import MailtoLink from '../../../components/MailtoLink.astro'; import TextLink from '../../../components/TextLink.astro'; import { getLangFromUrl,useTranslations } from '../../../i18n/ui'; import { Code,GitBranch,Layers,Bot,Users,FileCode as FileCode2,Gauge,MessageSquare } from '@lucide/astro'; const lang=getLangFromUrl(Astro.url); const t=useTranslations(lang);
const description='End-to-end software development: custom applications, DevSecOps, modernization and AI automation, from architecture to deployment and support.'; const jsonLd={'@context':'https://schema.org','@type':'Service',name:'Software & Automation',description,provider:{'@type':'Organization',name:'Smart Control SRL',url:'https://smartcontrol.ro'},url:'https://smartcontrol.ro/en/servicii/software/',areaServed:['RO','EU'],serviceType:['Custom Software Development','DevOps','DevSecOps','Application Modernization','AI Automation','Architecture Consulting','Staff Augmentation']}; const caps=[{title:'Custom software & API development',body:'Applications and integrations adapted to existing processes and systems.',Icon:Code},{title:'DevOps / DevSecOps & CI/CD',body:'Automated delivery flows, testing and integrated security controls.',Icon:GitBranch},{title:'Application migration & modernization',body:'Refactoring, re-platforming and controlled evolution of existing applications.',Icon:Layers},{title:'AI / LLM automation',body:'Automation for document processing, reporting and operational assistance.',Icon:Bot},{title:'Consulting & Staff Augmentation',body:'Architecture, prioritization and specialists integrated into client teams, with an SLA backed by guaranteed metrics.',Icon:Users}];
---
<BaseLayout title="Software & Automation — Smart Control" description={description}><script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}/><header class="bg-page"><div class="container pb-[64px] pt-[120px] md:pt-[120px]"><Eyebrow>Software &amp; Automation</Eyebrow><h1 class="mt-6 text-[clamp(2.5rem,1.7rem+3vw,3.75rem)] font-extrabold leading-[1.1] text-midnight">End-to-end <span class="text-bright">software development</span></h1><p class="mt-6 max-w-[680px] text-[18px] leading-[1.7] text-cool">From initial architecture to production deployment: custom development, DevSecOps, modernization and AI automation, with responsibility across the entire delivery lifecycle.</p><div class="mt-9 flex gap-4"><MailtoLink variant="button" subject={t('subject.assessment')}>{t('cta.assessment')}</MailtoLink><TextLink href="#capabilities">View capabilities</TextLink></div></div></header><section class="bg-surface py-[48px] sm:py-[72px]"><div class="container"><SectionHeading heading="End-to-end software delivery">We take responsibility from architecture definition through deployment, support and application evolution, with one point of contact and clear deliverables at every stage.</SectionHeading><div class="mt-9 grid gap-5 md:grid-cols-3">{[{title:'Access to source code',body:'Source code and documentation are available at delivery.',Icon:FileCode2},{title:'SLA with guaranteed metrics',body:'Timelines, availability and relevant indicators are explicitly defined.',Icon:Gauge},{title:'Consultative approach',body:'Architecture and priorities start from real requirements.',Icon:MessageSquare}].map(({title,body,Icon})=><ModuleCard title={title} body={body}><Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div></div></section><section id="capabilities" class="bg-page py-[56px] sm:py-[80px]"><div class="container"><SectionHeading eyebrow="Capabilities" heading="Five delivery domains"/><div class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{caps.map((c,i)=><ModuleCard title={c.title} index={String(i+1).padStart(2,'0')} body={c.body}><c.Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div></div></section><CtaBand heading="Let’s discuss your project architecture and constraints" cta={t('cta.assessment')} subject={t('subject.assessment')}>We clarify architecture, integrations and constraints, with source-code access and documented handover.</CtaBand></BaseLayout>
