---
// /en/servicii — Services hub (Template B-lite, light landing)
// EN twin of /servicii/index.astro
// Owned by: services-hub page agent. Do NOT edit shared components.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import ModuleCard from '../../../components/ModuleCard.astro';
import MonoPill from '../../../components/MonoPill.astro';
import CtaBand from '../../../components/CtaBand.astro';
import TextLink from '../../../components/TextLink.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import { Server, ShieldCheck, Code, Settings2 } from '@lucide/astro';
import { useTranslations, getLangFromUrl, localizedPath, FOUNDED } from '../../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);

// 4 pillar cards — EN canonical names per CLAUDE.md / ui.ts
const pillars = [
  {
    index: '01',
    title: 'Infrastructure & Cloud',
    href: p('/servicii/cloud'),
    icon: Server,
    body: 'We design and consolidate data centers, hybrid infrastructures and cloud solutions, with end-to-end Kubernetes orchestration.',
    items: [
      'Data Center Design & Implementation',
      'Consolidation & Virtualization',
      'Private Cloud & Hybrid Cloud',
      'Business Continuity & Disaster Recovery',
    ],
  },
  {
    index: '02',
    title: 'Networking & Security',
    href: p('/servicii/securitate'),
    icon: ShieldCheck,
    body: 'We protect enterprise infrastructure, from network and perimeter to identity and managed security operations.',
    items: [
      'Perimeter & End-point Security',
      'Enterprise SSO / PKI',
      'Security monitoring and reporting',
      'Managed Security Operations',
    ],
  },
  {
    index: '03',
    title: 'Software & Automation',
    href: p('/servicii/software'),
    icon: Code,
    body: 'We build, modernize and automate enterprise applications through refactoring, containerization, DevSecOps and AI-based solutions adapted to existing processes.',
    items: [
      'Custom software development & APIs',
      'DevOps / DevSecOps & CI/CD',
      'Application migration & modernization',
      'AI / LLM automation',
    ],
  },
  {
    index: '04',
    title: 'Managed Services',
    href: p('/servicii/managed'),
    icon: Settings2,
    body: 'We take over continuous operation of your infrastructure and applications. Our in-house team works with clear SLAs and transparent reporting.',
    items: [
      'Managed Infrastructure Operations',
      'Service Desk Outsourcing',
      'Cyber Security Managed Services',
      'Cloud Based System Support',
    ],
  },
];

// JSON-LD: Service list via ItemList (EN)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Smart Control Services',
  'description': 'Integrated IT services portfolio — infrastructure, security, software and managed services.',
  'url': 'https://smartcontrol.ro/en/servicii/',
  'numberOfItems': 4,
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'item': {
        '@type': 'Service',
        'name': 'Infrastructure & Cloud',
        'description': 'Data Center Design & Implementation, Consolidation & Virtualization, Private Cloud & Hybrid Cloud, Business Continuity & Disaster Recovery.',
        'url': 'https://smartcontrol.ro/en/servicii/cloud/',
        'provider': { '@type': 'Organization', 'name': 'Smart Control SRL' },
      },
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'item': {
        '@type': 'Service',
        'name': 'Networking & Security',
        'description': 'Perimeter & End-point Security, Enterprise SSO / PKI, security audit reporting and Managed Security Operations.',
        'url': 'https://smartcontrol.ro/en/servicii/securitate/',
        'provider': { '@type': 'Organization', 'name': 'Smart Control SRL' },
      },
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'item': {
        '@type': 'Service',
        'name': 'Software & Automation',
        'description': 'Custom software development & APIs, DevOps / DevSecOps & CI/CD, Application migration & modernization, AI / LLM automation.',
        'url': 'https://smartcontrol.ro/en/servicii/software/',
        'provider': { '@type': 'Organization', 'name': 'Smart Control SRL' },
      },
    },
    {
      '@type': 'ListItem',
      'position': 4,
      'item': {
        '@type': 'Service',
        'name': 'Managed Services',
        'description': 'Managed Infrastructure Operations, Service Desk Outsourcing, Cyber Security Managed Services, Cloud Based System Support.',
        'url': 'https://smartcontrol.ro/en/servicii/managed/',
        'provider': { '@type': 'Organization', 'name': 'Smart Control SRL' },
      },
    },
  ],
};
---

<BaseLayout
  title="Enterprise IT Services — Smart Control"
  description="Integrated IT services portfolio: Infrastructure & Cloud, Networking & Security, Software & Automation and Managed Services."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {/* ── HERO (light) ──────────────────────────────────────────────── */}
  <header
    class="relative overflow-hidden"
    style="background: var(--sc-gradient-hero-light)"
  >
    <div class="container" style="padding-top:160px; padding-bottom:100px">
      <div>
        <Eyebrow variant="hero">SERVICES</Eyebrow>

        <h1
          class="mt-6 font-extrabold leading-[1.1] tracking-[-1.8px] text-midnight"
          style="font-size: clamp(2.5rem, 2rem + 2.5vw, 4rem); max-width: 820px"
        >
          An integrated portfolio,<br />
          <span class="text-bright">from hardware architecture to application level.</span>
        </h1>

        <p
          class="mt-6 text-[18px] leading-[1.7] text-slate"
          style="max-width:600px"
          data-reveal
          data-reveal-delay="200"
        >
          Four service pillars, backed by <strong class="text-navy font-semibold">50 in-house specialists</strong> employed directly by Smart Control. A consultative approach, source code included with every project.
        </p>

      </div>
    </div>
  </header>

  {/* ── 4 PILLAR CARDS ────────────────────────────────────────────── */}
  <section id="pillars" class="scroll-mt-24 bg-surface py-[72px] sm:py-[110px]">
    <div class="container">
      <div data-reveal class="mb-14">
        <SectionHeading
          eyebrow="Portfolio"
          heading="Four enterprise service pillars"
          headingMaxWidth="680px"
        >
          Smart Control covers the full enterprise IT spectrum: infrastructure, security, software and day-to-day operations. Every pillar is delivered by our in-house team.
        </SectionHeading>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {
          pillars.map((pillar, i) => {
            const PillarIcon = pillar.icon;
            return (
              <div
                data-reveal
                data-reveal-delay={String(i * 80)}
              >
                <ModuleCard
                  title={pillar.title}
                  index={pillar.index}
                  body={pillar.body}
                  items={pillar.items}
                  cols={1}
                >
                  <PillarIcon
                    slot="icon"
                    class="h-[22px] w-[22px] text-navy"
                    stroke-width={1.5}
                  />
                  <div class="mt-5">
                    <TextLink href={pillar.href}>Explore</TextLink>
                  </div>
                </ModuleCard>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ── PROOF STRIP ───────────────────────────────────────────────── */}
  <section class="bg-page py-[56px] sm:py-[84px]">
    <div class="container">
      {/* ISO certification badges */}
      <div data-reveal class="mb-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-3">
          <MonoPill>ISO 9001</MonoPill>
          <MonoPill>ISO 27001</MonoPill>
          <MonoPill>ISO 14001</MonoPill>
          <MonoPill>ISO 45001</MonoPill>
        </div>
      </div>

      {/* Trust proof */}
      <div data-reveal class="mt-2 text-center">
        <p class="text-[15px] text-cool">
          Founded in {FOUNDED}, with 50 in-house specialists and over 500 cumulative years of experience across the team.
        </p>
      </div>
    </div>
  </section>

  {/* ── WHY SMART CONTROL (brief differentiation strip) ───────────── */}
  <section class="bg-surface py-[56px] sm:py-[84px]">
    <div class="container">
      <div data-reveal class="mb-12">
        <SectionHeading
          heading="What you get from a project with Smart Control"
          headingMaxWidth="640px"
        />
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            {
              title: 'Specialists employed directly',
              body: '50 in-house specialists, available on-site and remote, maintain the same level of quality on every project.',
            },
            {
              title: 'Consultative approach',
              body: 'Long-term relationships with 250+ clients, with delivery decisions based on results measured in the field.',
            },
            {
              title: 'Proprietary software products',
              body: 'Our proprietary software products are developed and supported by the Smart Control team, with delivery options defined for each project.',
            },
            {
              title: 'Active certifications',
              body: '4 management systems certified simultaneously: ISO 9001, ISO 27001, ISO 14001, ISO 45001.',
            },
            {
              title: 'One point of contact across all four pillars',
              body: 'However many pillars you combine in a project, you get a single point of contact and unified coordination across teams.',
            },
            {
              title: 'Security assessment and reporting',
              body: 'We assess security gaps and deliver reporting that supports audit and governance.',
            },
          ].map((item) => (
            <div
              class="rounded-xl border border-border bg-surface p-[28px] shadow-sm transition-all duration-[350ms] ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-[4px] hover:border-border-blue hover:shadow-lg"
              data-reveal
            >
              <h3 class="text-[16px] font-bold text-navy">{item.title}</h3>
              <p class="mt-3 text-[13.5px] leading-relaxed text-cool">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── DARK CTA BAND ─────────────────────────────────────────────── */}
  <CtaBand
    id="contact"
    heading="A 2-day assessment that shows you where to start"
    cta={t('cta.assessment')}
    subject={t('subject.assessment')}
  >
    We review your infrastructure, security, applications and current operations, then recommend the pillar with the highest impact for your first project.
  </CtaBand>
</BaseLayout>
