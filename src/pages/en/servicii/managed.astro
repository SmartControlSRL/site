---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import SectionHeading from '../../../components/SectionHeading.astro'; import Eyebrow from '../../../components/Eyebrow.astro'; import ModuleCard from '../../../components/ModuleCard.astro'; import MailtoLink from '../../../components/MailtoLink.astro'; import TextLink from '../../../components/TextLink.astro'; import CtaBand from '../../../components/CtaBand.astro'; import IconChip from '../../../components/IconChip.astro'; import { getLangFromUrl,useTranslations,localizedPath } from '../../../i18n/ui'; import { Headset,Server,Network,ShieldCheck,Wrench,Cloud,Bot } from '@lucide/astro'; const lang=getLangFromUrl(Astro.url); const t=useTranslations(lang); const p=(x:string)=>localizedPath(lang,x);
const description='Managed enterprise IT services covering service desk, infrastructure, network, security, cloud support and software automation, with contractual SLAs.'; const jsonLd={'@context':'https://schema.org','@type':'Service',name:'Managed Services — Smart Control',description,url:'https://smartcontrol.ro/en/servicii/managed/',provider:{'@type':'Organization',name:'Smart Control SRL',url:'https://smartcontrol.ro'},serviceType:'Managed IT Services'};
const caps=[{title:'Service Desk Outsourcing',body:'Full user-support operation with contractual response and resolution targets.',items:['L1 / L2 / L3 user support','Contractual SLA','Performance reporting'],Icon:Headset},{title:'Managed Infrastructure Operations',body:'Proactive operation and maintenance of critical infrastructure.',items:['Continuous monitoring','Patch management','Backup and recovery'],Icon:Server},{title:'Network Managed Services',body:'Network operation with visibility across traffic and incidents.',items:['Availability monitoring','Equipment management','Access policies'],Icon:Network},{title:'Cyber Security Managed Services',body:'Continuous security monitoring, threat detection and incident response.',items:['Security event monitoring','Incident response','Security and audit reports'],Icon:ShieldCheck},{title:'Outsourced Systems Support',body:'On-site and remote technical assistance within agreed SLAs.',items:['On-site intervention','Secure remote access for support interventions','Configuration documentation'],Icon:Wrench},{title:'Cloud Based System Support',body:'Operation and continuous optimization of cloud environments.',items:['Cloud operations','Resource optimization','Migration support'],Icon:Cloud},{title:'Software Automation',body:'Automation of repetitive processes, integrations and reporting.',items:['Workflow automation','System integrations','Document processing'],Icon:Bot}];
---
<BaseLayout title="Managed Services — Smart Control" description={description}><script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}/><header class="bg-page"><div class="container pb-[64px] pt-[120px] md:pt-[120px]"><Eyebrow>Managed Services</Eyebrow><h1 class="mt-6 text-[clamp(2.5rem,1.7rem+3vw,3.75rem)] font-extrabold leading-[1.1] text-midnight">Your infrastructure, <span class="text-bright">operated by our team.</span></h1><p class="mt-6 max-w-[680px] text-[18px] leading-[1.7] text-cool">We take over the operation, monitoring and security of your IT infrastructure, with a contractual SLA and experience delivering enterprise services.</p><div class="mt-9 flex gap-4"><MailtoLink variant="button" subject={t('subject.assessment')}>{t('cta.assessment')}</MailtoLink><TextLink href="#capabilities">View capabilities</TextLink></div></div></header><section id="capabilities" class="bg-surface py-[56px] sm:py-[80px]"><div class="container"><SectionHeading eyebrow="Capabilities" heading="What Smart Control services cover"/><div class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{caps.map((c,i)=><ModuleCard title={c.title} index={String(i+1).padStart(2,'0')} body={c.body} items={c.items}><c.Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div></div></section><section class="bg-page py-[48px] sm:py-[72px]"><div class="container"><SectionHeading heading="Proprietary products for managed operations contexts">SEKNET and S-VPN can complement Smart Control managed services. Product fit and configuration are defined after assessing the customer environment.</SectionHeading><div class="mt-10 grid gap-5 md:grid-cols-2">{[{name:'SEKNET',body:'A proprietary product for monitoring and protecting IT environments, available as an option for relevant projects.',href:'/solutii/seknet',Icon:ShieldCheck},{name:'S-VPN',body:'A proprietary product for secure remote access, available as an option for relevant projects.',href:'/solutii/s-vpn',Icon:Network}].map(x=><article class="rounded-xl bg-surface p-8 shadow-sm"><div class="flex items-center gap-3"><IconChip><x.Icon class="h-5 w-5 text-navy" stroke-width={1.5}/></IconChip><h3 class="text-[19px] font-bold text-navy">{x.name}</h3></div><p class="mt-4 text-[14px] leading-[1.65] text-cool">{x.body}</p><div class="mt-5"><TextLink href={p(x.href)}>Explore {x.name}</TextLink></div></article>)}</div></div></section><CtaBand cta={t('cta.assessment')} subject={t('subject.assessment')} showContact={false}/></BaseLayout>
