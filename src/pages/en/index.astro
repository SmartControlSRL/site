---
// Home (EN) — /en/ — cinematic Control Plane composition.
// All approved copy, metadata, routes and mail subjects remain unchanged.
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeExperience from '../../components/HomeExperience.astro';
import { getLangFromUrl, useTranslations, localizedPath, yearsInBusiness } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);
const years = yearsInBusiness(new Date().getUTCFullYear());

const title = 'Smart Control — Trusted Service Delivery Partner';
const description = 'Enterprise infrastructure, networking, security and software, with 100% in-house execution and four ISO certifications.';

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Smart Control SRL',
  url: 'https://smartcontrol.ro',
  logo: 'https://smartcontrol.ro/smartcontrol-mark.png',
  foundingDate: '2003',
  description: 'Romanian enterprise IT services and cybersecurity company — infrastructure, security and software delivered by an in-house team.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Intrarea Aviator Teodor Iliescu 37',
    postalCode: '011672',
    addressLocality: 'București',
    addressCountry: 'RO',
  },
};

const content = {
  hero: {
    eyebrow: 'Trusted Service Delivery Partner',
    title: 'Infrastructure. Security. Software.',
    accent: 'Execution 100% in-house.',
    leadBefore: `Smart Control has been building and operating complex IT infrastructure for over ${years} years, for local and international clients. We work exclusively with our `,
    leadStrong: 'in-house team of experts',
    leadAfter: ", in a consultative approach: every recommendation starts from measurements taken in the client's own infrastructure.",
    cta: 'Schedule a free assessment',
    servicesLink: 'See services',
    isoBadges: ['ISO 9001', 'ISO 27001', 'ISO 14001', 'ISO 45001'],
  },
  services: {
    heading: 'An integrated portfolio of enterprise services',
    lead: 'Four service pillars, backed by 50 in-house specialists with over 500 cumulative years of experience — on-site and remote, the same level of quality.',
    items: [
      {
        index: '01',
        title: 'Infrastructure & Cloud',
        body: 'We design and consolidate data centers, virtualize and operate private, hybrid and cloud environments.',
        items: ['Data Center Design & Implementation', 'Consolidation & Virtualization', 'Private & Hybrid Cloud', 'Business Continuity & DR', 'Storage & Information Management', 'Infrastructure Management'],
        href: p('/servicii/cloud'),
      },
      {
        index: '02',
        title: 'Networking & Security',
        body: 'Perimeter and endpoint security, identity and managed security operations.',
        items: ['Perimeter & End-point Security', 'Enterprise SSO / PKI', 'Data Leakage Prevention · WAF', 'Security and audit reporting', 'Managed Security Operations'],
        href: p('/servicii/securitate'),
      },
      {
        index: '03',
        title: 'Software & Automation',
        body: 'Custom development, application modernization and AI automation — DevSecOps delivery.',
        items: ['Custom software development & APIs', 'DevOps / DevSecOps & CI/CD', 'Application migration and modernization', 'AI / LLM automation'],
        href: p('/servicii/software'),
      },
      {
        index: '04',
        title: 'Managed Services',
        body: 'We operate your infrastructure, network and cybersecurity — service desk and support, on-site & remote.',
        items: ['Service Desk Outsourcing', 'Managed Infrastructure Operations', 'Network Managed Services', 'Cyber Security Managed Services', 'Outsourced Systems Support', 'Cloud Based System Support'],
        href: p('/servicii/managed'),
      },
    ],
  },
  accountability: {
    eyebrow: 'Stack Teardown',
    heading: 'One partner, single point of accountability',
    lead: 'We cover the entire technology stack — infrastructure, network, platforms and software — with a particular focus on security, under a single end-to-end SLA.',
    note: '24/7 SLA, end-to-end — zero hand-offs of responsibility between vendors.',
    layers: [
      {
        code: 'L4',
        name: 'Applications & Automation',
        desc: 'Custom software, APIs and AI / LLM automation.',
        chips: ['Custom dev & API', 'App modernization', 'AI / LLM automation', 'CI/CD & DevSecOps'],
        href: p('/servicii/software'),
        linkLabel: 'Software & Automation',
        aria: 'Layer L4 — Applications and Automation',
      },
      {
        code: 'L3',
        name: 'Platforms & Data',
        desc: 'Virtualization, private / hybrid cloud, containers and storage.',
        chips: ['VMware · K8s / OpenShift', 'Private / Hybrid Cloud', 'Storage & backup', 'Disaster Recovery'],
        href: p('/servicii/cloud'),
        linkLabel: 'Infrastructure & Cloud',
        aria: 'Layer L3 — Platforms and Data',
      },
      {
        code: 'L2',
        name: 'Network & Connectivity',
        desc: 'Core networking, SD-WAN and secure remote access.',
        chips: ['LAN / WAN core', 'SD-WAN', 'Secure remote access', 'Load balancing'],
        href: p('/servicii/managed'),
        linkLabel: 'Network Managed Services',
        aria: 'Layer L2 — Network and Connectivity',
      },
      {
        code: 'L1',
        name: 'Physical infrastructure',
        desc: 'Data center, compute, power and structured cabling.',
        chips: ['DC design & build', 'Compute & storage', 'Power & cooling', 'Structured cabling'],
        href: p('/servicii/cloud'),
        linkLabel: 'Infrastructure & Cloud',
        aria: 'Layer L1 — Physical infrastructure',
      },
    ],
  },
  products: {
    eyebrow: 'Proprietary products',
    heading: 'Proprietary products for security and protected access',
    lead: 'SEKNET and S-VPN support organizations that need control, visibility, and secure access. Technical details are available through a commercial discussion.',
    primaryLink: 'Explore SEKNET',
    secondaryLink: 'Explore S-VPN',
    statusTitle: 'SEKNET · OPERATIONAL VISIBILITY',
    metrics: [
      { label: 'Visibility', value: 'Active' },
      { label: 'Protection', value: 'Continuous' },
      { label: 'Control', value: 'Centralized' },
    ],
    signals: [
      { time: '08:14:02', msg: 'Infrastructure status updated' },
      { time: '08:14:05', msg: 'Operational event analyzed' },
      { time: '08:14:09', msg: 'Response coordinated from the central view' },
      { time: '08:14:12', msg: 'Organization context synchronized' },
    ],
    items: [
      {
        name: 'SEKNET',
        body: 'A proprietary product for monitoring and protecting IT environments. Capability and integration details are available on request.',
        href: p('/solutii/seknet'),
        linkLabel: 'Explore SEKNET',
        artifact: 'seknet' as const,
      },
      {
        name: 'S-VPN',
        body: 'A proprietary product for secure remote access. Capability and integration details are available on request.',
        href: p('/solutii/s-vpn'),
        linkLabel: 'Explore S-VPN',
        artifact: 'svpn' as const,
      },
    ],
  },
  cloud: {
    eyebrow: 'Cloud & Modernization',
    heading: 'Optimizing budgets by shifting from hardware dependency to intelligent architecture',
    contextBefore: 'Prices for critical components are rising under demand for AI infrastructure, and refresh budgets no longer stretch far enough. Re-architecture becomes the primary strategy, delivered through a ',
    contextStrong: '5-stage',
    contextAfter: ' workflow.',
    linkLabel: 'Explore Cloud & Modernization',
    href: p('/servicii/cloud'),
    steps: [
      { title: 'Assessment', sub: '2-day assessment' },
      { title: 'Re-architecture', sub: 'target design' },
      { title: 'Containerization', sub: 'K8s / OpenShift' },
      { title: 'Migration', sub: 'zero-downtime' },
      { title: 'ROI validation', sub: '90-day report' },
    ],
    rows: [
      { tag: 'CAPEX→OPEX', body: 'Shifting hardware spend toward cloud or hybrid models, with predictable costs.' },
      { tag: 'K8S-READY', body: 'Containerization and migration to Kubernetes / OpenShift / AKS / GKE, with zero downtime.' },
      { tag: 'ROI 90 DAYS', body: 'Validating the investment through a performance report measured after 90 days in production.' },
    ],
  },
  partners: {
    eyebrow: 'Technology partners',
    lead: "We work directly with technology vendors and use their products every day in our clients' projects.",
    items: ['Hitachi Vantara', 'Commvault', 'Fortinet', 'Cisco', 'Juniper', 'Lenovo', 'VMware', 'Fujitsu', 'Oracle', 'Microsoft', 'Palo Alto', 'Hanasis', 'IBM', 'HPE', 'DELL'],
  },
  cta: {
    eyebrow: 'Next steps',
    heading: 'Free initial assessment — 2 days',
    lead: 'No contractual obligations. Together we identify the priority area of interest and deliver a recommendations report at the end.',
    label: t('cta.assessment'),
  },
};
---

<BaseLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(org)} />
  <HomeExperience content={content} assessmentSubject={t('subject.assessment')} />
</BaseLayout>
