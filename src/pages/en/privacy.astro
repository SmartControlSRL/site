---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MailtoLink from '../../components/MailtoLink.astro';
---

<BaseLayout
  title="Privacy — legal review in progress | Smart Control"
  description="Smart Control privacy information is undergoing legal validation before publication."
  noindex
  unpublished
>
  <section
    data-privacy-status="pending-legal-review"
    class="container flex min-h-[55vh] max-w-[760px] items-center py-[72px] sm:py-[96px]"
  >
    <article class="rounded-xl border border-border bg-surface p-8 shadow-sm sm:p-12">
      <p class="font-mono text-[12px] uppercase tracking-[2px] text-royal">Legal review</p>
      <h1 class="mt-4 text-[clamp(2rem,1.5rem+2vw,3rem)] font-extrabold leading-tight text-midnight">
        Privacy information is being validated
      </h1>
      <p class="mt-6 text-[17px] leading-[1.7] text-slate">
        The full notice is not yet approved for publication. The processing inventory, providers,
        retention periods, legal bases, and privacy contact details are being confirmed.
      </p>
      <p class="mt-5 text-[17px] leading-[1.7] text-slate">
        For a personal-data request, contact Smart Control at{' '}
        <MailtoLink variant="link" subject="Privacy request" />.
      </p>
      <p class="mt-6 text-[14px] leading-[1.6] text-cool" role="status">
        This page is temporarily excluded from indexing and will be published after legal approval.
      </p>
      <a class="mt-6 inline-block text-[14px] font-semibold text-royal underline decoration-bright underline-offset-4" href="/confidentialitate/" lang="ro">
        Notificare de revizuire juridică în română
      </a>
    </article>
  </section>
</BaseLayout>
