---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Eyebrow from '../../components/Eyebrow.astro'; import SectionHeading from '../../components/SectionHeading.astro'; import ModuleCard from '../../components/ModuleCard.astro'; import ChevronList from '../../components/ChevronList.astro'; import CtaBand from '../../components/CtaBand.astro'; import MailtoLink from '../../components/MailtoLink.astro'; import GridTexture from '../../components/GridTexture.astro';
import { getLangFromUrl,useTranslations } from '../../i18n/ui'; import { KeyRound,SlidersHorizontal,Network } from '@lucide/astro';
const lang=getLangFromUrl(Astro.url); const t=useTranslations(lang);
const description='S-VPN este soluția Smart Control pentru acces remote securizat, administrare simplificată și adaptare la cerințele organizației.';
const productLd={'@context':'https://schema.org','@type':'Product',name:'S-VPN',url:'https://smartcontrol.ro/solutii/s-vpn/',brand:{'@type':'Brand',name:'Smart Control'},manufacturer:{'@type':'Organization',name:'Smart Control SRL'},category:'Soluție de acces remote securizat',description};
const cards=[{title:'Acces sigur',body:'Conectarea utilizatorilor la resursele necesare, conform politicilor organizației.',Icon:KeyRound},{title:'Administrare simplificată',body:'Control centralizat și vizibilitate operațională pentru echipa IT.',Icon:SlidersHorizontal},{title:'Integrare în mediul existent',body:'Configurare adaptată infrastructurii, proceselor și cerințelor de securitate existente.',Icon:Network}];
const includedItems=['Analiză inițială și configurare','Integrare în mediul existent','Asistență tehnică','Mentenanță și actualizări'];
const audiences=[['ORGANIZAȚII','Organizații care au nevoie de acces remote securizat și administrat coerent.'],['ECHIPE IT','Echipe care urmăresc să simplifice administrarea accesului utilizatorilor.'],['MEDII REGLEMENTATE','Organizații cu cerințe ridicate de control, audit și guvernanță.'],['MEDII DISTRIBUITE','Organizații cu utilizatori și locații distribuite.']];
---
<BaseLayout title="S-VPN — Acces remote sigur, integrat | Smart Control" description={description}>
 <script is:inline type="application/ld+json" set:html={JSON.stringify(productLd)}/>
 <header class="relative overflow-hidden bg-midnight"><GridTexture dark/><div class="container relative pb-[100px] pt-[150px] md:pt-[190px]"><Eyebrow variant="dark">Produs proprietar · Acces remote securizat</Eyebrow><h1 class="mt-6 text-[clamp(2.5rem,1.7rem+3vw,4rem)] font-extrabold leading-[1.08] tracking-[-1.8px] text-white">S-VPN. <span class="text-sky">Acces remote sigur.</span></h1><p class="mt-6 max-w-[650px] text-[18px] leading-[1.7] text-[rgba(226,233,245,.78)]">S-VPN oferă organizațiilor o modalitate sigură și ușor de administrat pentru conectarea utilizatorilor la resursele de lucru, adaptată infrastructurii și politicilor existente.</p><div class="mt-9"><MailtoLink variant="button" dark subject={t('subject.demo.svpn')}>{t('cta.demo.svpn')}</MailtoLink></div></div></header>
 <section class="bg-surface py-[72px] sm:py-[110px]"><div class="container"><SectionHeading eyebrow="S-VPN" heading="Acces remote adaptat organizației">O abordare unitară pentru conectarea sigură a utilizatorilor și administrarea accesului, configurată în funcție de mediul și cerințele fiecărei organizații.</SectionHeading><div class="mt-11 grid gap-5 md:grid-cols-3">{cards.map(({title,body,Icon})=><ModuleCard kicker="S-VPN" title={title} body={body}><Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div></div></section>
 <section class="bg-page py-[64px] sm:py-[92px]"><div class="container grid gap-12 lg:grid-cols-2"><div><SectionHeading eyebrow="Servicii asociate" heading="Asistență pe parcursul implementării și operării">Echipa Smart Control asigură serviciile necesare pentru configurarea, integrarea și utilizarea soluției în mediul organizației.</SectionHeading><ChevronList items={includedItems} class="mt-7"/></div><div class="grid gap-4 sm:grid-cols-2">{audiences.map(([title,body])=><article class="rounded-xl bg-surface p-6 shadow-sm"><h3 class="font-mono text-[11px] tracking-[1.5px] text-royal">{title}</h3><p class="mt-3 text-[14px] leading-[1.65] text-cool">{body}</p></article>)}</div></div></section>
 <CtaBand heading="Discută cu noi despre S-VPN" cta={t('cta.demo.svpn')} subject={t('subject.demo.svpn')}>Evaluăm contextul organizației tale și îți prezentăm modul în care S-VPN poate susține accesul remote securizat.</CtaBand>
</BaseLayout>
