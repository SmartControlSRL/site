---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RouteHero from '../../components/RouteHero.astro';
import ControlArtifact from '../../components/ControlArtifact.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TextLink from '../../components/TextLink.astro';
import CtaBand from '../../components/CtaBand.astro';
import { localizedPath, getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const p = (path: string) => localizedPath(lang, path);
const t = useTranslations(lang);

const products = [
  {
    name: 'SEKNET',
    description: 'Produs proprietar pentru monitorizarea și protejarea mediilor IT.',
    url: 'https://smartcontrol.ro/solutii/seknet/',
  },
  {
    name: 'S-VPN',
    description: 'Produs proprietar pentru acces remote securizat.',
    url: 'https://smartcontrol.ro/solutii/s-vpn/',
  },
];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: products.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: product.name,
      url: product.url,
      description: product.description,
      brand: { '@type': 'Brand', name: 'Smart Control' },
    },
  })),
};
---

<BaseLayout
  title="Soluții proprietare — SEKNET & S-VPN | Smart Control"
  description="Produse software proprii pentru protejarea mediilor IT și acces remote securizat. SEKNET și S-VPN, dezvoltate și susținute de Smart Control."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />

  <RouteHero eyebrow="Soluții proprietare" artifact="solutions" index="07" compact>
    <h1 slot="title">Software propriu, <span class="accent">susținut local.</span></h1>
    <p slot="lead">SEKNET și S-VPN sunt dezvoltate și susținute de echipa Smart Control. Detaliile tehnice, opțiunile de livrare și condițiile comerciale sunt disponibile la cerere.</p>
  </RouteHero>

  <section class="product-bays-section" aria-labelledby="products-heading">
    <div class="container">
      <SectionHeading
        headingId="products-heading"
        heading="Două produse proprii, susținute de aceeași echipă"
      />

      <div class="product-bays" data-control-scene data-scene-kind="solutions">
        <article class="product-bay product-bay--seknet">
          <div class="product-bay__context">
            <span>01</span>
            <span>Produs proprietar</span>
          </div>
          <div class="product-bay__artifact">
            <ControlArtifact variant="seknet" compact />
          </div>
          <div class="product-bay__copy">
            <h2>SEKNET</h2>
            <p>SEKNET sprijină monitorizarea și protejarea mediilor IT într-un mod unitar. Configurația și capabilitățile potrivite se stabilesc în funcție de contextul organizației.</p>
            <TextLink href={p('/solutii/seknet')}>Explorează SEKNET</TextLink>
          </div>
        </article>

        <article class="product-bay product-bay--svpn">
          <div class="product-bay__context">
            <span>02</span>
            <span>Produs proprietar</span>
          </div>
          <div class="product-bay__artifact">
            <ControlArtifact variant="svpn" compact />
          </div>
          <div class="product-bay__copy">
            <h2>S-VPN</h2>
            <p>S-VPN sprijină accesul remote securizat pentru organizații. Configurația și capabilitățile potrivite se stabilesc în funcție de contextul organizației.</p>
            <TextLink href={p('/solutii/s-vpn')}>Explorează S-VPN</TextLink>
          </div>
        </article>

        <span class="product-bays__junction" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <section class="integration-junction" aria-labelledby="integration-heading">
    <div class="container integration-junction__grid">
      <div class="integration-junction__heading">
        <SectionHeading
          eyebrow="De ce soluții proprii"
          headingId="integration-heading"
          heading="Integrare în contextul organizației"
        />
      </div>

      <article class="integration-junction__ledger">
        <div class="integration-junction__routes" aria-hidden="true">
          <span></span><span></span><i></i>
        </div>
        <div class="integration-junction__copy">
          <span class="integration-junction__index">01</span>
          <div>
            <h3>Integrare nativă</h3>
            <p>Produsele sunt integrate în mediul clientului pe baza cerințelor validate în etapa de analiză.</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <CtaBand
    heading="Discutăm despre produsul potrivit"
    cta={t('cta.assessment')}
    subject={t('subject.assessment')}
  >
    Menționează produsul care te interesează — SEKNET sau S-VPN — iar mesajul ajunge la echipa potrivită. Detaliile sunt discutate într-un cadru comercial.
  </CtaBand>
</BaseLayout>

<style>
  .product-bays-section {
    overflow: clip;
    padding-block: clamp(64px, 8vw, 104px);
    background: var(--color-surface);
  }

  .product-bays {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 42px;
    border-block: 1px solid var(--color-border-blue);
  }

  .product-bay {
    position: relative;
    display: grid;
    min-width: 0;
    grid-template-rows: auto minmax(220px, 1fr) auto;
    padding: 30px clamp(24px, 3.5vw, 46px) 38px;
    isolation: isolate;
  }

  .product-bay + .product-bay {
    border-left: 1px solid var(--color-border-blue);
  }

  .product-bay::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(145deg, color-mix(in srgb, var(--color-blue-wash) 58%, transparent), transparent 64%);
    content: '';
  }

  .product-bay--svpn::before {
    background: linear-gradient(215deg, color-mix(in srgb, var(--color-page) 78%, transparent), transparent 68%);
  }

  .product-bay__context {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    color: var(--color-royal);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .product-bay__artifact {
    display: grid;
    min-height: 220px;
    align-items: center;
    padding-block: 12px;
  }

  .product-bay--seknet .product-bay__artifact {
    transform: translateX(-3%);
  }

  .product-bay--svpn .product-bay__artifact {
    transform: translateX(3%);
  }

  .product-bay__copy {
    position: relative;
    padding-top: 25px;
    border-top: 1px solid var(--color-border-blue);
  }

  .product-bay__copy::before {
    position: absolute;
    top: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-bright);
    box-shadow: 0 0 0 3px var(--color-surface);
    content: '';
  }

  .product-bay__copy h2 {
    color: var(--color-navy);
    font-size: clamp(1.75rem, 1.5rem + 0.9vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .product-bay__copy p {
    max-width: 460px;
    margin-top: 14px;
    color: var(--color-cool);
    font-size: 14.5px;
    line-height: 1.72;
  }

  .product-bay__copy :global(a) {
    margin-top: 22px;
  }

  .product-bays__junction {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: 13px;
    height: 13px;
    border: 3px solid var(--color-surface);
    border-radius: 50%;
    background: var(--color-bright);
    box-shadow: 0 0 0 1px var(--color-bright);
    transform: translate(-50%, -50%);
  }

  .integration-junction {
    padding-block: clamp(62px, 7vw, 88px);
    background: var(--color-page);
  }

  .integration-junction__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(420px, 1.18fr);
    align-items: end;
    gap: clamp(46px, 7vw, 92px);
  }

  .integration-junction__ledger {
    min-width: 0;
    border-block: 1px solid var(--color-border-blue);
    background: color-mix(in srgb, var(--color-surface) 76%, transparent);
  }

  .integration-junction__routes {
    position: relative;
    display: grid;
    height: 72px;
    place-items: end center;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-blue);
  }

  .integration-junction__routes span {
    position: absolute;
    top: 0;
    width: 42%;
    height: 100%;
    border-bottom: 1px solid var(--color-bright);
  }

  .integration-junction__routes span:first-child {
    left: 8%;
    transform: skewY(13deg);
    transform-origin: left bottom;
  }

  .integration-junction__routes span:nth-child(2) {
    right: 8%;
    transform: skewY(-13deg);
    transform-origin: right bottom;
  }

  .integration-junction__routes i {
    position: relative;
    bottom: -5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-bright);
  }

  .integration-junction__copy {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 22px;
    padding: 28px 30px 32px;
  }

  .integration-junction__index {
    padding-top: 4px;
    color: var(--color-royal);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
  }

  .integration-junction__copy h3 {
    color: var(--color-navy);
    font-size: 19px;
    font-weight: 700;
  }

  .integration-junction__copy p {
    max-width: 560px;
    margin-top: 10px;
    color: var(--color-cool);
    font-size: 14.5px;
    line-height: 1.72;
  }

  @media (max-width: 767px) {
    .product-bays {
      grid-template-columns: 1fr;
    }

    .product-bay + .product-bay {
      border-top: 1px solid var(--color-border-blue);
      border-left: 0;
    }

    .product-bay {
      grid-template-rows: auto minmax(180px, auto) auto;
      padding-inline: 0;
    }

    .product-bay__artifact {
      min-height: 180px;
    }

    .product-bay--seknet .product-bay__artifact,
    .product-bay--svpn .product-bay__artifact {
      transform: none;
    }

    .product-bays__junction {
      top: 50%;
      left: 0;
    }

    .integration-junction__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .integration-junction__copy {
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 14px;
      padding-inline: 18px;
    }
  }
</style>
