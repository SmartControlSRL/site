---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Eyebrow from '../../components/Eyebrow.astro'; import SectionHeading from '../../components/SectionHeading.astro'; import TextLink from '../../components/TextLink.astro'; import CtaBand from '../../components/CtaBand.astro'; import { localizedPath,getLangFromUrl,useTranslations } from '../../i18n/ui';
const lang=getLangFromUrl(Astro.url); const p=(x:string)=>localizedPath(lang,x); const t=useTranslations(lang);
const products=[{name:'SEKNET',description:'Produs proprietar pentru monitorizarea și protejarea mediilor IT.',url:'https://smartcontrol.ro/solutii/seknet/'},{name:'S-VPN',description:'Produs proprietar pentru acces remote securizat.',url:'https://smartcontrol.ro/solutii/s-vpn/'}];
const ld={'@context':'https://schema.org','@type':'ItemList',itemListElement:products.map((x,i)=>({'@type':'ListItem',position:i+1,item:{'@type':'Product',name:x.name,url:x.url,description:x.description,brand:{'@type':'Brand',name:'Smart Control'}}}))};
---
<BaseLayout title="Soluții proprietare — SEKNET & S-VPN | Smart Control" description="Produse software proprii pentru protejarea mediilor IT și acces remote securizat. SEKNET și S-VPN, dezvoltate și susținute de Smart Control."><script is:inline type="application/ld+json" set:html={JSON.stringify(ld)}/><header class="bg-page"><div class="container pb-[90px] pt-[150px] md:pt-[190px]"><Eyebrow>Soluții proprietare</Eyebrow><h1 class="mt-6 max-w-[800px] text-[clamp(2.4rem,1.7rem+3vw,3.75rem)] font-extrabold leading-[1.1] text-midnight">Software propriu, <span class="text-bright">susținut local.</span></h1><p class="mt-6 max-w-[680px] text-[18px] leading-[1.7] text-cool">SEKNET și S-VPN sunt dezvoltate și susținute de echipa Smart Control. Detaliile tehnice, opțiunile de livrare și condițiile comerciale sunt disponibile la cerere.</p></div></header><section class="bg-surface py-[72px] sm:py-[110px]"><div class="container"><SectionHeading heading="Două produse proprii, susținute de aceeași echipă"/><div class="mt-11 grid gap-5 md:grid-cols-2"><article class="rounded-xl bg-surface p-8 shadow-md"><div class="font-mono text-[11px] uppercase tracking-[1.5px] text-royal">Produs proprietar</div><h2 class="mt-2 text-[24px] font-bold text-navy">SEKNET</h2><p class="mt-4 text-[15px] leading-[1.7] text-cool">SEKNET sprijină monitorizarea și protejarea mediilor IT într-un mod unitar. Configurația și capabilitățile potrivite se stabilesc în funcție de contextul organizației.</p><div class="mt-6"><TextLink href={p('/solutii/seknet')}>Explorează SEKNET</TextLink></div></article><article class="rounded-xl bg-surface p-8 shadow-md"><div class="font-mono text-[11px] uppercase tracking-[1.5px] text-royal">Produs proprietar</div><h2 class="mt-2 text-[24px] font-bold text-navy">S-VPN</h2><p class="mt-4 text-[15px] leading-[1.7] text-cool">S-VPN sprijină accesul remote securizat pentru organizații. Configurația și capabilitățile potrivite se stabilesc în funcție de contextul organizației.</p><div class="mt-6"><TextLink href={p('/solutii/s-vpn')}>Explorează S-VPN</TextLink></div></article></div></div></section><section class="bg-page py-[64px] sm:py-[92px]"><div class="container"><SectionHeading eyebrow="De ce soluții proprii" heading="Integrare în contextul organizației"/><article class="mt-9 max-w-[680px] rounded-xl bg-surface p-8 shadow-sm"><h3 class="text-[18px] font-bold text-navy">Integrare nativă</h3><p class="mt-3 text-[15px] leading-[1.7] text-cool">Produsele sunt integrate în mediul clientului pe baza cerințelor validate în etapa de analiză.</p></article></div></section><CtaBand heading="Discutăm despre produsul potrivit" cta={t('cta.assessment')} subject={t('subject.assessment')}>Menționează produsul care te interesează — SEKNET sau S-VPN — iar mesajul ajunge la echipa potrivită. Detaliile sunt discutate într-un cadru comercial.</CtaBand></BaseLayout>
