---
// SEKNET — pagină de produs. Conținut public general, fără specificații tehnice.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ModuleCard from '../../components/ModuleCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import MailtoLink from '../../components/MailtoLink.astro';
import TextLink from '../../components/TextLink.astro';
import IconChip from '../../components/IconChip.astro';
import GridTexture from '../../components/GridTexture.astro';
import { getLangFromUrl, useTranslations, localizedPath } from '../../i18n/ui';
import { Activity, ShieldCheck, SlidersHorizontal, Network, Cloud } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);
const description = 'SEKNET este o soluție Smart Control pentru vizibilitate operațională și protecția infrastructurii IT, adaptată cerințelor fiecărei organizații.';
const productLd = {
  '@context': 'https://schema.org', '@type': 'Product', name: 'SEKNET',
  brand: { '@type': 'Brand', name: 'Smart Control' },
  category: 'IT infrastructure monitoring and protection',
  description: 'Soluție Smart Control pentru vizibilitate operațională și protecția infrastructurii IT.',
  url: 'https://smartcontrol.ro/solutii/seknet/',
  manufacturer: { '@type': 'Organization', name: 'Smart Control SRL' },
};
const capabilities = [
  { title: 'Monitorizare operațională', body: 'Oferă echipelor o imagine coerentă asupra stării infrastructurii și susține identificarea rapidă a situațiilor care necesită atenție.', Icon: Activity },
  { title: 'Protecție integrată', body: 'Sprijină observarea riscurilor și coordonarea acțiunilor de răspuns dintr-un punct central.', Icon: ShieldCheck },
  { title: 'Control centralizat', body: 'Reunește informațiile relevante într-o experiență clară pentru echipele tehnice și operaționale.', Icon: SlidersHorizontal },
];
---
<BaseLayout title="SEKNET — Monitorizare, securitate și control | Smart Control" description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productLd)} />
  <header class="relative overflow-hidden bg-midnight">
    <GridTexture dark />
    <div class="container relative pb-[100px] pt-[150px] md:pt-[190px]">
      <Eyebrow variant="dark">Produs Smart Control</Eyebrow>
      <h1 class="mt-6 max-w-[850px] text-[clamp(2.5rem,1.7rem+3vw,4rem)] font-extrabold leading-[1.08] tracking-[-1.8px] text-white">SEKNET. <span class="text-sky">Monitorizare. Securitate. Control.</span></h1>
      <p class="mt-6 max-w-[650px] text-[18px] leading-[1.7] text-[rgba(226,233,245,.78)]">O perspectivă unificată asupra infrastructurii IT, care sprijină echipele în monitorizarea operațiunilor, identificarea riscurilor și coordonarea răspunsului.</p>
      <div class="mt-9"><MailtoLink variant="button" dark subject={t('subject.demo.seknet')}>{t('cta.demo.seknet')}</MailtoLink></div>
    </div>
  </header>
  <section id="capabilitati" class="bg-surface py-[72px] sm:py-[110px]">
    <div class="container">
      <SectionHeading heading="Vizibilitate și protecție într-o experiență unificată">SEKNET centralizează informațiile relevante pentru operarea și protejarea infrastructurii IT, într-o experiență adaptată contextului organizației.</SectionHeading>
      <div class="mt-11 grid gap-5 md:grid-cols-3">{capabilities.map(({title,body,Icon}) => <ModuleCard kicker="SEKNET" title={title} body={body}><Icon slot="icon" class="h-[22px] w-[22px] text-navy" stroke-width={1.5}/></ModuleCard>)}</div>
    </div>
  </section>
  <section class="bg-page py-[64px] sm:py-[92px]">
    <div class="container">
      <SectionHeading eyebrow="Alte soluții Smart Control" heading="Continuă explorarea" />
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <article class="rounded-xl bg-surface p-8 shadow-sm"><div class="flex items-center gap-3"><IconChip><Network class="h-5 w-5 text-navy" stroke-width={1.5}/></IconChip><h3 class="text-[19px] font-bold text-navy">S-VPN</h3></div><p class="mt-4 text-[14px] leading-[1.65] text-cool">Soluție Smart Control pentru acces remote securizat, adaptată cerințelor organizației.</p><div class="mt-5"><TextLink href={p('/solutii/s-vpn')}>Explorează S-VPN</TextLink></div></article>
        <article class="rounded-xl bg-surface p-8 shadow-sm"><div class="flex items-center gap-3"><IconChip><Cloud class="h-5 w-5 text-navy" stroke-width={1.5}/></IconChip><h3 class="text-[19px] font-bold text-navy">Cloud &amp; Modernizare</h3></div><p class="mt-4 text-[14px] leading-[1.65] text-cool">Re-arhitecturare, containerizare și migrare selectivă pentru infrastructura și aplicațiile organizației.</p><div class="mt-5"><TextLink href={p('/servicii/cloud')}>Explorează Cloud &amp; Modernizare</TextLink></div></article>
      </div>
    </div>
  </section>
  <CtaBand heading="Discutăm despre cerințele organizației tale" cta={t('cta.demo.seknet')} subject={t('subject.demo.seknet')}>Îți prezentăm SEKNET și stabilim împreună dacă soluția răspunde contextului tău operațional.</CtaBand>
</BaseLayout>
