---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RouteHero from '../../components/RouteHero.astro';
import ControlArtifact from '../../components/ControlArtifact.astro';
import ControlLane from '../../components/ControlLane.astro';
import ProofLedger from '../../components/ProofLedger.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import MailtoLink from '../../components/MailtoLink.astro';
import TextLink from '../../components/TextLink.astro';
import IconChip from '../../components/IconChip.astro';
import { getLangFromUrl, useTranslations, localizedPath } from '../../i18n/ui';
import { Activity, ShieldCheck, SlidersHorizontal, Network, Cloud } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizedPath(lang, path);

const description = 'SEKNET este soluția Smart Control pentru monitorizarea și protejarea infrastructurii IT, cu vizibilitate operațională și control centralizat.';
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'SEKNET',
  brand: { '@type': 'Brand', name: 'Smart Control' },
  category: 'IT infrastructure monitoring and protection',
  description,
  url: 'https://smartcontrol.ro/solutii/seknet/',
  manufacturer: { '@type': 'Organization', name: 'Smart Control SRL' },
};

const capabilities = [
  {
    title: 'Monitorizare operațională',
    body: 'O imagine coerentă asupra stării infrastructurii, astfel încât echipele să identifice mai repede situațiile care necesită atenție.',
    Icon: Activity,
  },
  {
    title: 'Protecție integrată',
    body: 'Evenimentele relevante sunt reunite pentru analiză și pentru coordonarea răspunsului dintr-un punct central.',
    Icon: ShieldCheck,
  },
  {
    title: 'Control centralizat',
    body: 'Informațiile tehnice sunt organizate într-o experiență unitară, adaptată rolurilor operaționale și de securitate.',
    Icon: SlidersHorizontal,
  },
];

const uses = [
  {
    title: 'Vizibilitate asupra mediilor distribuite',
    body: 'Pentru organizații care operează infrastructură eterogenă și au nevoie de o perspectivă comună asupra evenimentelor.',
  },
  {
    title: 'Prioritizarea alertelor',
    body: 'Pentru echipe care trebuie să reducă timpul dintre apariția unui eveniment, analiză și acțiunea potrivită.',
  },
  {
    title: 'Suport pentru operare și audit',
    body: 'Pentru contexte în care istoricul, trasabilitatea și raportarea trebuie păstrate într-un mod coerent.',
  },
];
---

<BaseLayout title="SEKNET — Monitorizare, securitate și control | Smart Control" description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productLd)} />

  <RouteHero eyebrow="Produs proprietar Smart Control" artifact="seknet" index="08" dark>
    <h1 slot="title">SEKNET. <span class="accent">Monitorizare. Securitate. Control.</span></h1>
    <p slot="lead">O perspectivă unificată asupra infrastructurii IT, care sprijină echipele în monitorizarea operațiunilor, identificarea riscurilor și coordonarea răspunsului.</p>
    <Fragment slot="actions">
      <MailtoLink variant="button" dark subject={t('subject.demo.seknet')}>{t('cta.demo.seknet')}</MailtoLink>
      <TextLink href="#capabilitati" dark>Vezi capabilitățile</TextLink>
    </Fragment>
  </RouteHero>

  <section id="capabilitati" class="capability-section" aria-labelledby="capabilities-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Platforma SEKNET"
        headingId="capabilities-heading"
        heading="Vizibilitate și protecție într-o experiență unificată"
      >
        SEKNET centralizează informațiile relevante pentru operarea și protejarea infrastructurii IT, într-o experiență configurată în funcție de mediul și cerințele organizației.
      </SectionHeading>

      <div class="capability-map" data-control-scene data-scene-kind="seknet">
        <div class="capability-map__artifact">
          <div class="capability-map__coordinate" aria-hidden="true"><span>08 / 01</span><span>SC</span></div>
          <ControlArtifact variant="seknet" compact />
        </div>

        <div class="capability-map__lanes">
          {capabilities.map(({ title, body, Icon }, index) => (
            <ControlLane index={`0${index + 1}`} title={title} body={body}>
              <Icon slot="icon" class="h-[21px] w-[21px]" stroke-width={1.5} aria-hidden="true" />
              <span class="capability-map__kicker">SEKNET</span>
            </ControlLane>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="context-section" aria-labelledby="contexts-heading">
    <div class="container context-section__grid">
      <div class="context-section__heading">
        <SectionHeading
          eyebrow="Contexte de utilizare"
          headingId="contexts-heading"
          heading="Unde aduce valoare SEKNET"
        />
      </div>
      <div class="context-section__ledger">
        <ProofLedger entries={uses} />
      </div>
    </div>
  </section>

  <section class="ecosystem-section" aria-labelledby="ecosystem-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Ecosistem Smart Control"
        headingId="ecosystem-heading"
        heading="Continuă explorarea"
      />

      <div class="ecosystem-bridges">
        <article class="ecosystem-bridge">
          <div class="ecosystem-bridge__heading">
            <IconChip><Network class="h-5 w-5 text-navy" stroke-width={1.5} aria-hidden="true" /></IconChip>
            <h3>S-VPN</h3>
          </div>
          <p>Soluție Smart Control pentru acces remote securizat, adaptată cerințelor organizației.</p>
          <TextLink href={p('/solutii/s-vpn')}>Explorează S-VPN</TextLink>
        </article>

        <article class="ecosystem-bridge">
          <div class="ecosystem-bridge__heading">
            <IconChip><Cloud class="h-5 w-5 text-navy" stroke-width={1.5} aria-hidden="true" /></IconChip>
            <h3>Cloud &amp; Modernizare</h3>
          </div>
          <p>Re-arhitecturare, containerizare și migrare selectivă pentru infrastructura și aplicațiile organizației.</p>
          <TextLink href={p('/servicii/cloud')}>Explorează Cloud &amp; Modernizare</TextLink>
        </article>

        <span class="ecosystem-bridges__node" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Vezi SEKNET în contextul infrastructurii tale"
    cta={t('cta.demo.seknet')}
    subject={t('subject.demo.seknet')}
  >
    Îți prezentăm platforma și discutăm cerințele, integrarea și configurația potrivită pentru mediul tău.
  </CtaBand>
</BaseLayout>

<style>
  .capability-section {
    overflow: clip;
    padding-block: clamp(68px, 8vw, 104px);
    background: var(--color-surface);
  }

  .capability-map {
    display: grid;
    grid-template-columns: minmax(300px, 0.82fr) minmax(0, 1.18fr);
    margin-top: 46px;
    border-block: 1px solid var(--color-border-blue);
  }

  .capability-map__artifact {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 510px;
    align-items: center;
    padding: 40px 28px;
    overflow: hidden;
    border-right: 1px solid var(--color-border-blue);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-blue-wash) 78%, transparent), transparent 74%),
      var(--color-page);
  }

  .capability-map__artifact::after {
    position: absolute;
    right: -1px;
    bottom: 16%;
    width: 34%;
    height: 1px;
    background: var(--color-bright);
    content: '';
  }

  .capability-map__coordinate {
    position: absolute;
    inset: 18px 20px auto;
    display: flex;
    justify-content: space-between;
    color: var(--color-cool);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
  }

  .capability-map__lanes {
    min-width: 0;
    padding-left: clamp(28px, 4vw, 54px);
  }

  .capability-map__kicker {
    display: block;
    margin-top: 14px;
    color: var(--color-royal);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .context-section {
    padding-block: clamp(64px, 7.5vw, 92px);
    background: var(--color-page);
  }

  .context-section__grid {
    display: grid;
    grid-template-columns: minmax(250px, 0.72fr) minmax(0, 1.28fr);
    align-items: start;
    gap: clamp(48px, 8vw, 106px);
  }

  .context-section__heading {
    position: relative;
    padding-left: 24px;
  }

  .context-section__heading::before {
    position: absolute;
    inset: 4px auto 0 0;
    width: 1px;
    height: 100%;
    background: linear-gradient(var(--color-bright), transparent);
    content: '';
  }

  .context-section__ledger {
    min-width: 0;
    background: color-mix(in srgb, var(--color-surface) 62%, transparent);
  }

  .ecosystem-section {
    overflow: clip;
    padding-block: clamp(64px, 7.5vw, 92px);
    background: var(--color-surface);
  }

  .ecosystem-bridges {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 42px;
    border-block: 1px solid var(--color-border-blue);
  }

  .ecosystem-bridge {
    position: relative;
    min-width: 0;
    padding: 30px clamp(24px, 3.5vw, 42px) 34px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--color-blue-wash) 40%, transparent), transparent 60%);
  }

  .ecosystem-bridge + .ecosystem-bridge {
    border-left: 1px solid var(--color-border-blue);
  }

  .ecosystem-bridge__heading {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .ecosystem-bridge h3 {
    color: var(--color-navy);
    font-size: 19px;
    font-weight: 700;
  }

  .ecosystem-bridge p {
    max-width: 440px;
    margin-top: 18px;
    color: var(--color-cool);
    font-size: 14px;
    line-height: 1.68;
  }

  .ecosystem-bridge :global(a) {
    margin-top: 21px;
  }

  .ecosystem-bridges__node {
    position: absolute;
    top: -6px;
    left: 50%;
    width: 11px;
    height: 11px;
    border: 3px solid var(--color-surface);
    border-radius: 50%;
    background: var(--color-bright);
    box-shadow: 0 0 0 1px var(--color-bright);
    transform: translateX(-50%);
  }

  @media (min-width: 1100px) {
    .capability-map__artifact > :global(.control-artifact) {
      position: sticky;
      top: calc(var(--nav-offset) + 32px);
    }
  }

  @media (max-width: 767px) {
    .capability-map {
      grid-template-columns: 1fr;
    }

    .capability-map__artifact {
      min-height: 280px;
      padding: 24px 12px;
      border-right: 0;
      border-bottom: 1px solid var(--color-border-blue);
    }

    .capability-map__lanes {
      padding-left: 0;
    }

    .context-section__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .ecosystem-bridges {
      grid-template-columns: 1fr;
    }

    .ecosystem-bridge {
      padding-inline: 0;
    }

    .ecosystem-bridge + .ecosystem-bridge {
      border-top: 1px solid var(--color-border-blue);
      border-left: 0;
    }

    .ecosystem-bridges__node {
      top: 50%;
      left: 0;
    }
  }
</style>
